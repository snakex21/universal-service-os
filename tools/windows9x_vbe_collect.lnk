format windows
option modname=USOSVBI
option description 'USOS read-only VBE collector (GPL-3.0-or-later)'
option start=__usos_start
option nodefaultlibs
option stack=8192
option heapsize=1024
order clname CODE clname BEGDATA clname DATA clname BSS
option quiet
libpath '%WATCOM%/lib286/win'
library windows
