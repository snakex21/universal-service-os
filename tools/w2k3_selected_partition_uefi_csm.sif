[Data]
msdosinitiated="1"
floppyless="1"
UseSignatures="yes"
InstallDir="\WINDOWS"
EulaComplete="1"
winntupgrade="no"
win9xupgrade="no"
OriSrc="C:\"
OriTyp="5"
[Unattended]
DriverSigningPolicy=Ignore
NonDriverSigningPolicy=Ignore
UnattendMode=ProvideDefault
OemSkipEula=Yes
OemPreinstall=No
Repartition=No
FileSystem=LeaveAlone
TargetPath=\WINDOWS
WaitForReboot=No
[SetupParams]
UserExecute="C:\USOS\W2K3\usos-setup.cmd"
