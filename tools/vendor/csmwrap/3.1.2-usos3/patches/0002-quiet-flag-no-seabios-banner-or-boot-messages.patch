diff -ruN a/src/csmwrap.c b/src/csmwrap.c
--- a/src/csmwrap.c
+++ b/src/csmwrap.c
@@ -767,6 +767,9 @@
         printf("\n");
     }
 
+    /* USOS: ask SeaBIOS for a quiet boot unless verbose = true */
