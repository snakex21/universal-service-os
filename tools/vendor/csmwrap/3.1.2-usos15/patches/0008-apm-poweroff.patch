diff -ruN a/seabios/src/fw/usos_s5.h b/seabios/src/fw/usos_s5.h
--- a/seabios/src/fw/usos_s5.h
+++ b/seabios/src/fw/usos_s5.h
@@ -0,0 +1,98 @@
+// USOS (CSMWrap 3.1.2-usos7, patch 0008): find the \_S5 sleep type values
+// in an AML table (DSDT/SSDT) without an interpreter.
+//
+// Own code written from the ACPI specification (6.x: 5.4 AML encoding,
+// 7.4.2 \_Sx system states, 4.8.3.2 PM1 control registers). Only a plain
+// "Name (_S5, Package () {a, b, ...})" is recognised: NameOp 0x08,
+// optional root prefix '\', NameSeg "_S5_", PackageOp 0x12, PkgLength,
+// NumElements, then integer constants (ZeroOp 0x00, OneOp 0x01, OnesOp
+// 0xFF, BytePrefix 0x0A, WordPrefix 0x0B, DWordPrefix 0x0C). A _S5 that is
+// a method or uses names is not evaluated (returns 0).
+//
+// Header only and free of SeaBIOS dependencies apart from u8/u32, so the
+// host unit test (tools/tests/csmwrap/test_csmwrap_apmoff.py) compiles the
+// same text. This file may be distributed under the terms of the GNU
+// LGPLv3 license.
+#ifndef __USOS_S5_H
+#define __USOS_S5_H
+
+// One AML integer constant at aml[*pos]; 1 = parsed (value in *val).
+static inline int
+usos_s5_const(const u8 *aml, u32 len, u32 *pos, u32 *val)
+{
+    u32 p = *pos, n, i;
+    if (p >= len)
+        return 0;
+    switch (aml[p]) {
+    case 0x00: *val = 0; *pos = p + 1; return 1;
+    case 0x01: *val = 1; *pos = p + 1; return 1;
+    case 0xFF: *val = 0xFFFFFFFF; *pos = p + 1; return 1;
+    case 0x0A: n = 1; break;
+    case 0x0B: n = 2; break;
+    case 0x0C: n = 4; break;
+    default: return 0;
+    }
+    if (p + n >= len)
+        return 0;
+    *val = 0;
+    for (i = 0; i < n; i++)
+        *val |= (u32)aml[p + 1 + i] << (8 * i);
+    *pos = p + 1 + n;
+    return 1;
+}
+
+// Search aml[0..len) for Name(_S5, Package(){...}). On success stores the
+// 3-bit SLP_TYPa / SLP_TYPb values and returns 1. A one-element package is
+// the old packed form (SLP_TYPa in bits 0-7, SLP_TYPb in bits 8-15).
+static inline int
+usos_s5_parse(const u8 *aml, u32 len, u8 *typa, u8 *typb)
+{
+    u32 i;
+    for (i = 0; i + 6 < len; i++) {
+        if (aml[i] != 0x08)
+            continue;
+        u32 p = i + 1;
+        if (aml[p] == 0x5C)
+            p++;
+        if (p + 6 >= len || aml[p] != '_' || aml[p + 1] != 'S'
+            || aml[p + 2] != '5' || aml[p + 3] != '_' || aml[p + 4] != 0x12)
+            continue;
+        p += 5;
+        u32 lead = aml[p];
+        u32 pkglen_bytes = 1 + (lead >> 6);
+        if (lead >> 6 && (lead & 0x30))
+            continue;               // bits 4-5 must be 0 in the multi-byte form
+        p += pkglen_bytes;
+        if (p >= len)
+            continue;
+        u32 count = aml[p++];
+        u32 a, b;
+        if (!count || !usos_s5_const(aml, len, &p, &a))
+            continue;
+        if (count == 1) {
+            b = a >> 8;
+        } else if (!usos_s5_const(aml, len, &p, &b)) {
+            continue;
+        }
+        *typa = a & 7;
+        *typb = b & 7;
+        return 1;
+    }
+    return 0;
+}
+
+// PM1x_CNT value for entering a sleep state: SLP_TYP (bits 10-12) set,
+// SLP_EN (bit 13) clear or set, every other bit (SCI_EN etc.) kept.
+#define USOS_PM1_SLP_TYP_MASK 0x1C00
+#define USOS_PM1_SLP_EN       0x2000
+static inline u32
+usos_s5_cnt(u32 cnt, u8 typ, int enable)
+{
+    cnt = (cnt & ~(u32)(USOS_PM1_SLP_TYP_MASK | USOS_PM1_SLP_EN))
+        | ((u32)(typ & 7) << 10);
+    if (enable)
+        cnt |= USOS_PM1_SLP_EN;
+    return cnt & 0xFFFF;
+}
+
+#endif // usos_s5.h
