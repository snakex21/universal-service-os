+/*
+ * USOS 0008: ask the helper core to run bios_proxy_reset(type) (UEFI
+ * ResetSystem) through the mailbox, and give up after about 2 seconds.
+ * Unlike call32() this needs no segment that only exists in real mode in
+ * 32-bit code: it works from real/V86 mode (MODE16, %es = F000h), from the
+ * 32-bit protected-mode APM interface (32seg: %gs = the APM data segment,
+ * based at the F-segment, see entry_apm32) and from 32-bit flat code. Not
+ * for 16-bit protected mode (no usable data segment there).
+ * Returns -1 when the reset is not available or the helper is busy, -2 on
+ * timeout, else the helper's result (-1 = no ResetSystem pointer).
+ */
+#if MODE16
+#define USOS_PX_SET(field, val) SET_FARVAR(SEG_BIOS, bios_proxy.field, (val))
+#elif MODESEGMENT
+#define USOS_PX_SET(field, val) SET_VAR(GS, *(typeof(&bios_proxy.field))    \
+        ((void*)&bios_proxy.field + get_global_offset()), (val))
+#else
+#define USOS_PX_SET(field, val) do { bios_proxy.field = (val); } while (0)
+#endif
+#define USOS_PX_GET(field) GET_GLOBAL(bios_proxy.field)
+
+int
+usos_proxy_reset_timed(int type)
+{
+    extern void _cfunc32flat_bios_proxy_reset(void);
+    if (USOS_PX_GET(signature) != BIOS_PROXY_SIGNATURE
+        || (!USOS_PX_GET(reset_fn_lo) && !USOS_PX_GET(reset_fn_hi))
+        || !USOS_PX_GET(reset_cr3) || USOS_PX_GET(request_pending))
+        return -1;
+    USOS_PX_SET(func_ptr, (u32)_cfunc32flat_bios_proxy_reset);
+    USOS_PX_SET(arg_eax, (u32)type);
+    USOS_PX_SET(arg_edx, 0);
+    USOS_PX_SET(arg_ecx, 0);
+    asm volatile("" ::: "memory");
+    USOS_PX_SET(request_pending, 1);
+
+    /* ~2 s on the ACPI PM timer (3.579545 MHz, 24 bits used), else on
+     * port 80h reads (about 1 us each). */
+    u16 tmr = GET_GLOBAL(usos_pm_tmr);
+    u32 last = tmr ? inl(tmr) : 0, waited = 0;
+    while (USOS_PX_GET(request_pending)) {
+        asm volatile("pause" ::: "memory");
+        if (tmr) {
+            u32 now = inl(tmr);
+            waited += (now - last) & 0xffffff;
+            last = now;
+            if (waited > 7159090)
+                return -2;
+        } else {
+            inb(0x80);
+            if (++waited > 2000000)
+                return -2;
+        }
+    }
+    return USOS_PX_GET(result);
