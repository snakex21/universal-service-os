+// USOS 0008: an I/O port from the FADT, or from its 64-bit X_ GAS (ACPI
+// 2.0+) when the 32-bit field is 0.
+static u32
+usos_fadt_port(struct fadt_descriptor_rev1 *fadt, u32 legacy, u32 gas_off)
+{
+    if (legacy || fadt->length < gas_off + 12)
+        return legacy;
+    u8 *gas = (u8*)fadt + gas_off;
+    u64 addr = *(u64*)(gas + 4);
+    if (gas[0] != 1 || !addr || addr > 0xffff)
+        return 0;
+    return addr;
+}
+
+// USOS 0008: \_S5 SLP_TYPa/b from the DSDT, else from an SSDT in the RSDT.
+#define USOS_SSDT_SIGNATURE 0x54445353 // SSDT
+static int
+usos_s5_in_table(struct acpi_table_header *t, u32 sig, u8 *a, u8 *b)
+{
+    if (!t || t->signature != sig || t->length <= 36 || t->length >= 0x1000000)
+        return 0;
+    return usos_s5_parse((u8*)t + 36, t->length - 36, a, b);
+}
+
+static void
+usos_find_s5(struct fadt_descriptor_rev1 *fadt)
+{
+    u32 dsdt = le32_to_cpu(fadt->dsdt);
+    if (!dsdt && fadt->length >= 148) {
+        u64 x = *(u64*)((u8*)fadt + 140);
+        if (x < 0x100000000ULL)
+            dsdt = x;
+    }
+    u8 a = 0, b = 0;
+    int found = usos_s5_in_table((void*)dsdt, DSDT_SIGNATURE, &a, &b);
+    struct rsdt_descriptor_rev1 *rsdt = (void*)RsdpAddr->rsdt_physical_address;
+    if (!found && rsdt && rsdt->signature == RSDT_SIGNATURE) {
+        void *end = (void*)rsdt + rsdt->length;
+        int i;
+        for (i=0; !found && (void*)&rsdt->table_offset_entry[i] < end; i++)
+            found = usos_s5_in_table((void*)rsdt->table_offset_entry[i]
+                                     , USOS_SSDT_SIGNATURE, &a, &b);
+    }
+    usos_slp_typa = a;
+    usos_slp_typb = b;
+    usos_s5_found = found;
+}
+
