+/*
+ * USOS 0008 (CSMWrap 3.1.2-usos7): APM power-off that works on more boards.
+ * Own code written from the APM 1.2 specification (5307h, BX=0001h,
+ * CX=0003h) and the ACPI specification (4.8.3.2 PM1 control, 7.4.2 \_S5).
+ *
+ * Order:
+ *  1. UEFI ResetSystem(EfiResetShutdown) on the helper core through the
+ *     bios_proxy mailbox (usos_proxy_reset_timed, 2 s timeout): from real /
+ *     V86 mode (INT 15h) and from the 32-bit protected-mode APM interface
+ *     (Windows 9x VPOWERD). Not from the 16-bit protected-mode interface
+ *     (no data segment for the mailbox there).
+ *  2. Direct ACPI S5: SLP_TYPa/b from the DSDT/SSDT Name(_S5) (X470: 5,
+ *     QEMU: 0) into PM1a_CNT/PM1b_CNT, then SLP_EN. Port I/O only, so it
+ *     runs in every mode.
+ *  3. Still running after 2 s with SCI_EN = 0 and an SMI_CMD port: ACPI
+ *     mode on (FADT ACPI_ENABLE to SMI_CMD), S5 written again.
+ *  4. Still running: the APM call fails (AH=60h, "can't enter requested
+ *     state") instead of halting, so the caller can show its own text.
+ * Not done: the _PTS(5) method (no AML interpreter); boards that need it
+ * for S5 are covered only by step 1 (firmware ResetSystem).
+ *
+ * Diagnostics: "USOS APMOFF:" lines through dprintf (they reach the serial
+ * port only with csmwrap.ini serial = true, patch 0008 serialio.c) and,
+ * for INT 15h callers only (segment loads), 4 bytes at BDA 4FCh-4FFh:
+ *   4FC 'P'   4FD step<<4 | path   4FE SLP_TYPa | SLP_TYPb<<4
+ *   4FF bit0 _S5 found, bit1 PM1a, bit2 PM1b, bit3 helper timeout,
+ *       bit4 helper reset unavailable, bit5 ACPI enable tried
+ * path 1 = INT 15h, 2 = 16-bit PM, 3 = 32-bit PM; step 1 = helper asked,
+ * 2 = S5 written, 3 = S5 written after ACPI enable, 4 = gave up.
+ */
+#define USOS_APMOFF_INT15 1
+#define USOS_APMOFF_PM16  2
+#define USOS_APMOFF_PM32  3
 
-    /* Fallback: direct ACPI S5 shutdown (may not work properly on all HW) */
-    dprintf(1, "UEFI shutdown unavailable, falling back to direct ACPI S5\n");
-    u16 pm1a_cnt = GET_GLOBAL(acpi_pm1a_cnt);
-    if (pm1a_cnt)
-        outw(0x2000, pm1a_cnt);
+static void
+usos_apmoff_mark(u8 path, u8 step, u8 flags)
+{
+    if (path != USOS_APMOFF_INT15)
+        return;
+    u8 typ = GET_GLOBAL(usos_slp_typa) | (GET_GLOBAL(usos_slp_typb) << 4);
+    flags |= (GET_GLOBAL(usos_s5_found) ? 1 : 0)
+        | (GET_GLOBAL(acpi_pm1a_cnt) ? 2 : 0)
+        | (GET_GLOBAL(usos_pm1b_cnt) ? 4 : 0);
+    SET_FARVAR(SEG_BDA, *(u8*)0xFC, 'P');
+    SET_FARVAR(SEG_BDA, *(u8*)0xFD, (step << 4) | path);
+    SET_FARVAR(SEG_BDA, *(u8*)0xFE, typ);
+    SET_FARVAR(SEG_BDA, *(u8*)0xFF, flags);
+}
+
+// About ms milliseconds on the ACPI PM timer, else on port 80h reads.
+static void
+usos_apmoff_wait(u32 ms)
+{
+    u16 tmr = GET_GLOBAL(usos_pm_tmr);
+    u32 last = tmr ? inl(tmr) : 0, waited = 0, limit = ms * 3580;
+    if (!tmr)
+        limit = ms * 1000;
+    while (waited < limit) {
+        if (tmr) {
+            u32 now = inl(tmr);
+            waited += (now - last) & 0xffffff;
+            last = now;
+        } else {
+            inb(0x80);
+            waited++;
+        }
+    }
+}
 
+static void
+usos_s5_write(void)
+{
+    u32 a = GET_GLOBAL(acpi_pm1a_cnt), b = GET_GLOBAL(usos_pm1b_cnt);
+    u8 ta = GET_GLOBAL(usos_slp_typa), tb = GET_GLOBAL(usos_slp_typb);
+    if (a)
+        outw(usos_s5_cnt(inw(a), ta, 0), a);
+    if (b)
+        outw(usos_s5_cnt(inw(b), tb, 0), b);
+    if (a)
+        outw(usos_s5_cnt(inw(a), ta, 1), a);
+    if (b)
+        outw(usos_s5_cnt(inw(b), tb, 1), b);
+}
+
+// Steps 2-4; returns only when the machine is still on.
+static void
+usos_apmoff_s5(u8 path, u8 flags)
+{
+    u32 a = GET_GLOBAL(acpi_pm1a_cnt);
+    dprintf(1, "USOS APMOFF: path=s5 from=%d typ=%d/%d s5=%d cnt=%x/%x\n"
+            , path, GET_GLOBAL(usos_slp_typa), GET_GLOBAL(usos_slp_typb)
+            , GET_GLOBAL(usos_s5_found), a, GET_GLOBAL(usos_pm1b_cnt));
+    usos_apmoff_mark(path, 2, flags);
     irq_disable();
-    for (;;)
-        hlt();
+    usos_s5_write();
+    usos_apmoff_wait(2000);
+
+    u16 smi = GET_GLOBAL(usos_smi_cmd);
+    u8 en = GET_GLOBAL(usos_acpi_enable);
+    if (a && smi && en && !(inw(a) & 1)) {
+        dprintf(1, "USOS APMOFF: still on, ACPI enable (%x to %x), S5 again\n"
+                , en, smi);
+        flags |= 0x20;
+        usos_apmoff_mark(path, 3, flags);
+        outb(en, smi);
+        u32 i;
+        for (i = 0; i < 20 && !(inw(a) & 1); i++)
+            usos_apmoff_wait(50);
+        usos_s5_write();
+        usos_apmoff_wait(2000);
+    }
+    dprintf(1, "USOS APMOFF: still on, power-off failed\n");
+    usos_apmoff_mark(path, 4, flags);
+}
+
+static u8
+usos_apmoff_helper(u8 path)
+{
+    dprintf(1, "USOS APMOFF: path=uefi from=%d (ResetSystem on the helper core)\n"
+            , path);
+    usos_apmoff_mark(path, 1, 0);
+    int r = usos_proxy_reset_timed(3);
+    dprintf(1, "USOS APMOFF: helper returned %d\n", r);
+    return r == -2 ? 0x08 : 0x10;
+}
+
+// INT 15h (real or V86 mode) and 32-bit flat callers. Returns only when
+// the machine is still on.
+void
+apm_shutdown(void)
+{
+    u8 flags = usos_apmoff_helper(USOS_APMOFF_INT15);
+    usos_apmoff_s5(USOS_APMOFF_INT15, flags);
 }
 
