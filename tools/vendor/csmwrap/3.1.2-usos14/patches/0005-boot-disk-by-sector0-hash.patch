+/*
+ * USOS patch 0005: the raw disk CSMWrap was loaded from. Its device path is
+ * a prefix of the loaded image's device path (PciRoot/.../Sata(port)/HD(..)).
+ */
+static bool device_path_is_prefix(EFI_DEVICE_PATH_PROTOCOL *prefix,
+                                  EFI_DEVICE_PATH_PROTOCOL *path)
+{
+    if (!prefix || !path) {
+        return false;
+    }
+    while (!IsDevicePathEnd(prefix)) {
+        UINTN len = DevicePathNodeLength(prefix);
+        if (IsDevicePathEnd(path) || DevicePathNodeLength(path) != len ||
+            memcmp(prefix, path, len) != 0) {
+            return false;
+        }
+        prefix = NextDevicePathNode(prefix);
+        path = NextDevicePathNode(path);
+    }
+    return true;
+}
+
+static uint32_t fnv1a(const uint8_t *p, size_t len)
+{
+    uint32_t h = 0x811c9dc5;
+    for (size_t i = 0; i < len; i++) {
+        h ^= p[i];
+        h *= 0x01000193;
+    }
+    return h;
+}
+
+/* FNV-1a of the first 512 bytes of the disk (SeaBIOS reads the same sector) */
+static bool boot_disk_hash(EFI_BLOCK_IO_PROTOCOL *block_io, uint32_t *hash)
+{
+    UINT32 bs = block_io->Media->BlockSize;
+    void *buf = NULL;
+
+    if (bs < 512 || bs > 4096 || !block_io->Media->MediaPresent) {
+        return false;
+    }
+    if (gBS->AllocatePool(EfiLoaderData, bs, &buf) != EFI_SUCCESS) {
+        return false;
+    }
+    EFI_STATUS status = block_io->ReadBlocks(block_io, block_io->Media->MediaId,
+                                             0, bs, buf);
+    if (!EFI_ERROR(status)) {
+        *hash = fnv1a(buf, 512);
+    }
+    gBS->FreePool(buf);
+    return !EFI_ERROR(status);
+}
