+// CSMWrap (USOS patch 0005) tags the BBS entry of the disk it was loaded
+// from with IBV1 = "USOS" and IBV2 = FNV-1a of that disk's first 512 bytes,
+// so boot.c can put exactly that disk first (0x80) when several disks share
+// its controller.
+int csm_bootdisk_hash(u32 *hash)
+{
+    if (!csm_boot_table)
+        return 0;
+    BBS_TABLE *bbs = (void *)csm_boot_table->BbsTable;
+    int i;
+
+    for (i = 0; i < csm_boot_table->NumberBbsEntries; i++) {
+        if (bbs[i].IBV1 == CSM_USOS_BOOTDISK_TAG) {
+            *hash = bbs[i].IBV2;
+            return 1;
+        }
+    }
+    return 0;
+}
