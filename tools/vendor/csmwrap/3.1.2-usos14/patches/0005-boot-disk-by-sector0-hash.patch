USOS 3.1.2-usos4 patch 5/5 (2026-10-11): the disk CSMWrap was loaded from is 0x80

CSMWrap's BBS table has one entry per raw disk but only the PCI address
of its controller, and SeaBIOS (patch 0004) ranks disks by controller, so
every disk on the controller CSMWrap was loaded from gets priority 0 and
SeaBIOS breaks the tie by port order: a bootable disk on a lower port of
the same SATA controller became 0x80 and was booted instead of the disk
holding CSMWrap's ESP. CSMWrap now finds the raw disk whose device path
is a prefix of the loaded image's device path and tags its BBS entry
(IBV1 = "USOS", IBV2 = FNV-1a of its first 512 bytes). Before mapping the
drives, SeaBIOS reads sector 0 of every hard disk in its boot list and
moves the one disk with that hash in front of the first hard disk; the
other disks keep their order after it (0x81, 0x82, ...). No tag, no match
or more than one match (cloned disks): the order is unchanged.

Applies to CSMWrap 3.1.2 (808ac8e) with its seabios submodule (578d260b)
after patches 0001-0004, patch -p1 from the top of the tree. Part of
CSMWrap 3.1.2-usos4, a MODIFIED version made by the USOS project
(LGPL-2.1 / SeaBIOS LGPLv3).

--- a/seabios/src/boot.c
+++ b/seabios/src/boot.c
@@ -822,6 +822,74 @@ add_bev(int type, u32 vector)
     bev->vector = vector;
 }
 
+// USOS patch 0005: CSMWrap names the disk it was loaded from by a hash of
+// its first sector. Disks on one controller share that controller's BBS
+// priority and SeaBIOS breaks the tie by port, so a bootable disk on a lower
+// port of the same controller would become 0x80. Move the one hard disk whose
+// sector 0 matches in front of the first hard disk; the others keep their
+// order (0x81, 0x82, ...). No match or more than one match: nothing changes.
+int process_op_32(struct disk_op_s *op); // block.c
+
+static u32
+usos_fnv1a(const u8 *p, int len)
+{
+    u32 h = 0x811c9dc5;
+    int i;
+    for (i = 0; i < len; i++) {
+        h ^= p[i];
+        h *= 0x01000193;
+    }
+    return h;
+}
+
+static void
+usos_boot_disk_first(void)
+{
+    u32 want;
+    if (!CONFIG_CSM || !csm_bootdisk_hash(&want))
+        return;
+    u8 *buf = memalign_tmplow(512, 4096);
+    if (!buf) {
+        warn_noalloc();
+        return;
+    }
+    struct bootentry_s *pos, *first = NULL, *match = NULL;
+    int matches = 0;
+    hlist_for_each_entry(pos, &BootList, node) {
+        if (pos->type != IPL_TYPE_HARDDISK)
+            continue;
+        if (!first)
+            first = pos;
+        struct drive_s *drive = pos->drive;
+        if (!drive || drive->blksize < 512 || drive->blksize > 4096)
+            continue;
+        struct disk_op_s dop;
+        memset(&dop, 0, sizeof(dop));
+        dop.drive_fl = drive;
+        dop.command = CMD_READ;
+        dop.lba = 0;
+        dop.count = 1;
+        dop.buf_fl = buf;
+        int ret = process_op_32(&dop);
+        u32 got = ret ? 0 : usos_fnv1a(buf, 512);
+        dprintf(1, "USOS boot disk: %s ret=%d hash=%08x want=%08x\n"
+                , pos->description, ret, got, want);
+        if (!ret && got == want) {
+            matches++;
+            match = pos;
+        }
+    }
+    free(buf);
+    if (matches != 1 || match == first) {
+        dprintf(1, "USOS boot disk: %d match(es), order unchanged\n", matches);
+        return;
+    }
+    dprintf(1, "USOS boot disk: %s moved to 0x80\n", match->description);
+    hlist_del(&match->node);
+    hlist_add_before(&match->node, &first->node);
+    match->priority = first->priority;
+}
