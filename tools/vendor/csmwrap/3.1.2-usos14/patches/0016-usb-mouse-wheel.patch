+
+// Minimal HID report descriptor walk (HID 1.11 6.2.2): finds buttons 1-3,
+// X, Y (relative) and the wheel (Generic Desktop 0x38, relative) of the
+// report that has X. One Push level is kept; nested Push, Pop without Push,
+// long items and any input report longer than one packet end the walk (the
+// mouse then stays in the boot protocol). Returns 0 with a usable layout.
+static int
+hid_parse_mouse(u8 *d, int len, struct mouse_node *m, int maxbits)
+{
+    u32 page = 0, usage[8], umin = 0, umax = 0, offs[8], saved[5];
+    int nu = 0, range = 0, rsize = 0, rcount = 0, lneg = 0, id = 0;
+    int has_ids = 0, nids = 0, pushed = 0, i;
+    u8 ids[8], fid[6] = { 0 };
+    u8 *end = d + len;
+    while (d < end) {
+        u8 p = *d++;
+        int sz = (p & 3) == 3 ? 4 : p & 3;
+        if (p == 0xfe || d + sz > end)
+            return -1;                          // long item, truncated
+        u32 v = 0;
+        for (i = sz; i--; )
+            v = (v << 8) | d[i];
+        d += sz;
+        if ((p & 0x0c) == 0x08 && sz < 4)
+            v |= page << 16;                    // local usage: add the page
+        switch (p & 0xfc) {
+        case 0x04: page = v; break;
+        case 0x14: lneg = sz && (d[-1] & 0x80); break;
+        case 0x74: rsize = v; break;
+        case 0x84:
+            if (!v || v > 255)
+                return -1;
+            id = v; has_ids = 1; break;
+        case 0x94: rcount = v; break;
+        case 0xa4:                              // push (one level)
+            if (pushed)
+                return -1;
+            saved[0] = page; saved[1] = lneg; saved[2] = rsize;
+            saved[3] = rcount; saved[4] = id;
+            pushed = 1;
+            break;
+        case 0xb4:                              // pop
+            if (!pushed)
+                return -1;
+            page = saved[0]; lneg = saved[1]; rsize = saved[2];
+            rcount = saved[3]; id = saved[4];
+            pushed = 0;
+            break;
+        case 0x08: if (nu < ARRAY_SIZE(usage)) usage[nu++] = v; break;
+        case 0x18: umin = v; range = 1; break;
+        case 0x28: umax = v; range = 1; break;
+        case 0x80: {                            // Input
+            int slot;
+            for (slot = 0; slot < nids && ids[slot] != id; slot++)
+                ;
+            if (slot == nids) {
+                if (nids >= ARRAY_SIZE(ids))
+                    return -1;
+                ids[nids] = id;
+                offs[nids++] = 0;
+            }
+            if (rsize > 32 || rcount > 255)
+                return -1;
+            for (i = 0; i < rcount && (v & 3) == 2; i++) {   // data, variable
+                u32 u = range ? (umin + i <= umax ? umin + i : umax)
+                    : nu ? usage[i < nu ? i : nu - 1] : 0;
+                int w = u == 0x10030 ? 0 : u == 0x10031 ? 1 : u == 0x10038 ? 2
+                    : u - 0x90001 < 3 ? 3 + u - 0x90001 : -1;
+                u32 off = offs[slot] + i * rsize;
+                if (w < 0 || (w < 3 && !(v & 4)) || m->loc[w].size
+                    || !rsize || rsize > 16 || off + rsize > 248)
+                    continue;
+                m->loc[w].off = off;
+                m->loc[w].size = rsize;
+                m->loc[w].sgn = lneg;
+                fid[w] = id;
+            }
+            offs[slot] += rcount * rsize;
+            nu = range = umin = umax = 0;
+            break;
+        }
+        case 0x90: case 0xa0: case 0xb0: case 0xc0:  // other main items
+            nu = range = umin = umax = 0;
+            break;
+        }
+    }
+    for (i = 1; i < 6; i++)
+        if (fid[i] != fid[0])
+            m->loc[i].size = 0;
+    // Every input report (all IDs) must fit in one interrupt packet, so
+    // each packet starts a report and its first byte is the report ID.
+    for (i = 0; i < nids; i++)
+        if ((has_ids ? 8 : 0) + offs[i] > maxbits)
+            return -1;
+    if (!m->loc[0].size || !m->loc[1].size || !m->loc[2].size
+        || !m->loc[3].size || (has_ids && !fid[0]))
+        return -1;
+    m->report_id = has_ids ? fid[0] : 0;
+    return 0;
+}
+
+// Read the interface's HID report descriptor and parse it.
+static int
+usb_mouse_layout(struct usbdevice_s *usbdev, struct mouse_node *m, int maxpacket)
+{
+    struct usb_interface_descriptor *iface = usbdev->iface;
+    u8 *p = (void*)iface + iface->bLength, *end = (void*)iface + usbdev->imax;
+    int rlen = 0;
+    while (p + 2 <= end && p[0] >= 2 && p + p[0] <= end
+           && p[1] != USB_DT_INTERFACE) {
+        if (p[1] == 0x21 && p[0] >= 9 && p[6] == 0x22) {
+            rlen = p[7] | (p[8] << 8);
+            break;
+        }
+        p += p[0];
+    }
+    if (rlen <= 0 || rlen > MAX_REPORT_DESC)
+        return -1;
+    u8 *desc = malloc_tmphigh(rlen);
+    if (!desc)
+        return -1;
+    memset(desc, 0, rlen);                      // a short answer reads as 0
+    struct usb_ctrlrequest req;
+    req.bRequestType = USB_DIR_IN | USB_TYPE_STANDARD | USB_RECIP_INTERFACE;
+    req.bRequest = USB_REQ_GET_DESCRIPTOR;
+    req.wValue = 0x22 << 8;
+    req.wIndex = iface->bInterfaceNumber;
+    req.wLength = rlen;
+    int ret = usb_send_default_control(usbdev->defpipe, &req, desc);
+    if (!ret)
+        ret = hid_parse_mouse(desc, rlen, m, maxpacket * 8);
+    free(desc);
+    return ret;
+}
 
