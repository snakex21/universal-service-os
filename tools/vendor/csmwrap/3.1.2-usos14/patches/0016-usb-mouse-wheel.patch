+// A field of a report (bit offset from the start of the data).
+static s32
+hid_bits(u8 *data, int off, int size, int sgn)
+{
+    u32 v = 0;
+    int i;
+    for (i = 0; i < size; i++, off++)
+        if (data[off >> 3] & (1 << (off & 7)))
+            v |= (u32)1 << i;
+    if (sgn && size && size < 32 && (v & ((u32)1 << (size - 1))))
+        v |= ~(u32)0 << size;
+    return v;
+}
+
+static int
+clamp127(s32 v)
+{
+    return v > 127 ? 127 : (v < -127 ? -127 : v);
+}
