USOS 3.1.2-usos11-int13x patch 0014 (2026-10-18): csmwrap.ini int13_boot_disk_only

Windows Me on the ASRock X470 boots from the Micron NVMe (CSMWrap SeaBIOS
INT 13h, then usosnvme.mpd). Alone it runs; with a FAT32 USB stick plugged
in before boot (SeaBIOS: NVMe 0x80, stick 0x81) real-mode IO.SYS starts
from C: on the NVMe, then Windows stops with "cannot find KRNL386.EXE"
after IOS switched C: to protected mode. Experimental mitigation: with
int13_boot_disk_only = true in csmwrap.ini, CSMWrap tags its boot disk with
IBV1 = "USOX" instead of "USOS" (patch 0005, same IBV2 hash) and SeaBIOS,
after moving that one disk to 0x80, removes every other hard disk from its
boot list before the drives are mapped. INT 13h then has exactly one hard
disk, as in the configuration that works. No match or several matches:
nothing is removed (patch 0005 behaviour). Floppy, CD and USB keyboard/mouse
are unchanged. Without the ini key the binary behaves as 3.1.2-usos11.

Own code. Applies after 0001-0010 and 0012 (3.1.2-usos11), patch -p1 from
the top of the tree. Part of a MODIFIED CSMWrap made by the USOS project
(LGPL-2.1 / SeaBIOS LGPLv3).

diff -ruN a/seabios/src/boot.c b/seabios/src/boot.c
--- a/seabios/src/boot.c
+++ b/seabios/src/boot.c
@@ -846,7 +846,8 @@
 usos_boot_disk_first(void)
 {
     u32 want;
-    if (!CONFIG_CSM || !csm_bootdisk_hash(&want))
+    int only = 0;
+    if (!CONFIG_CSM || !csm_bootdisk_hash(&want, &only))
         return;
     u8 *buf = memalign_tmplow(512, 4096);
     if (!buf) {
@@ -880,14 +881,30 @@
         }
     }
     free(buf);
-    if (matches != 1 || match == first) {
+    if (matches != 1) {
         dprintf(1, "USOS boot disk: %d match(es), order unchanged\n", matches);
         return;
     }
-    dprintf(1, "USOS boot disk: %s moved to 0x80\n", match->description);
-    hlist_del(&match->node);
-    hlist_add_before(&match->node, &first->node);
-    match->priority = first->priority;
+    if (match != first) {
+        dprintf(1, "USOS boot disk: %s moved to 0x80\n", match->description);
+        hlist_del(&match->node);
+        hlist_add_before(&match->node, &first->node);
+        match->priority = first->priority;
+    }
+    if (!only)
+        return;
+    // USOS patch 0014 (csmwrap.ini int13_boot_disk_only = true, Windows 9x
+    // on NVMe): the other hard disks (a USB stick, a second SSD) are not
+    // mapped, so INT 13h has exactly one hard disk, 0x80, as when the 9x
+    // disk is alone in the PC (docs/nvme-9x-2026-10-14.md, drive letters).
+    struct hlist_node *n;
+    hlist_for_each_entry_safe(pos, n, &BootList, node) {
+        if (pos->type != IPL_TYPE_HARDDISK || pos == match)
+            continue;
+        dprintf(1, "USOS boot disk only: %s not mapped\n", pos->description);
+        hlist_del(&pos->node);
+        free(pos);
+    }
 }
 
