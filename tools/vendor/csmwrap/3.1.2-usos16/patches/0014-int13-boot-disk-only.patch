diff -ruN a/seabios/src/fw/csm.c b/seabios/src/fw/csm.c
--- a/seabios/src/fw/csm.c
+++ b/seabios/src/fw/csm.c
@@ -456,7 +456,9 @@
 // from with IBV1 = "USOS" and IBV2 = FNV-1a of that disk's first 512 bytes,
 // so boot.c can put exactly that disk first (0x80) when several disks share
 // its controller.
-int csm_bootdisk_hash(u32 *hash)
+// USOS patch 0014: IBV1 = "USOX" is the same tag with csmwrap.ini
+// int13_boot_disk_only = true: no other hard disk gets a BIOS drive number.
+int csm_bootdisk_hash(u32 *hash, int *only)
 {
     if (!csm_boot_table)
         return 0;
@@ -464,8 +466,10 @@
     int i;
 
     for (i = 0; i < csm_boot_table->NumberBbsEntries; i++) {
-        if (bbs[i].IBV1 == CSM_USOS_BOOTDISK_TAG) {
+        if (bbs[i].IBV1 == CSM_USOS_BOOTDISK_TAG
+            || bbs[i].IBV1 == CSM_USOS_BOOTDISK_ONLY_TAG) {
             *hash = bbs[i].IBV2;
+            *only = bbs[i].IBV1 == CSM_USOS_BOOTDISK_ONLY_TAG;
             return 1;
         }
     }
