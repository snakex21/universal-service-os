+#define UDS_REQ_MAGIC     0x52534455   // "UDSR"
+#define UDS_MAX_DEVS      8
+#define UDS_MAX_LUN       15
+#define UDS_MAX_DATA      65536
+#define UDS_MAX_CDB       16
+
+struct uds_channel {
+    u32 magic;
+    u32 req_phys;
+    volatile u32 doorbell;
+    volatile u32 done;
+};
+
+#define UDS_OP_ENUM    1
+#define UDS_OP_SCSI    2
+#define UDS_OP_RESET   3
+#define UDS_OP_EJECT   4
+#define UDS_OP_STATUS  5
+
+#define UDS_DIR_NONE   0
+#define UDS_DIR_IN     1
+#define UDS_DIR_OUT    2
+
+#define UDS_S_OK       0
+#define UDS_S_CHECK    1
+#define UDS_S_NODEV    2
+#define UDS_S_GONE     3
+#define UDS_S_TIMEOUT  4
+#define UDS_S_PHASE    5
+#define UDS_S_BADREQ   6
+#define UDS_S_OWNED    7
+#define UDS_S_HWFAIL   8
+
+struct uds_req {
+    u32 magic;
+    u16 version;
+    u16 size;
+    u32 seq;
+    u8  op, dev, lun, dir;
+    u32 data_phys;
+    u32 data_len;
+    u8  cdb_len, rsvd0[3];
+    u8  cdb[UDS_MAX_CDB];
+    u32 status;
+    u32 generation;
+    u32 residue;
+    u8  csw_status, sense_len, rsvd1[2];
+    u8  sense[20];
+};
+
+#define UDS_DEV_EMPTY    0
+#define UDS_DEV_PRESENT  1
+#define UDS_DEV_GONE     2
+#define UDS_DEV_EJECTED  3
+#define UDS_DEV_FAILED   4
+
+struct uds_dev_info {
+    u8  state, bios_drive, luns, port;
+    u16 vid, pid;
+    u32 generation;
+    u32 block_size;
+    u32 last_lba_lo, last_lba_hi;
+    char vendor[8];
+    char product[16];
+};
+
+#define UDS_WHY_OK        0
+#define UDS_WHY_MAGIC     1
+#define UDS_WHY_VERSION   2
+#define UDS_WHY_SIZE      3
+#define UDS_WHY_OP        4
+#define UDS_WHY_DEV       5
+#define UDS_WHY_LUN       6
+#define UDS_WHY_CDB       7
+#define UDS_WHY_DIR       8
+#define UDS_WHY_LEN       9
+#define UDS_WHY_ADDR      10
+
+// diagnostics record "USOS" "UDSK" (VARLOW, written only)
+#define UDS_DIAG_VERSION  1
+#define UDS_DIAG_DISKS    8
+#define UDS_DIAG_EVENTS   16
+
+struct uds_diag_dev {
+    u8  state, bios_drive, luns, port;
+    u16 vid, pid;
+    u8  slotid, speed, last_csw, last_key;
+    u8  last_asc, last_ascq, last_op, last_status;
+    u32 generation;
+    u32 block_size;
+    u32 last_lba_lo, last_lba_hi;
+    u32 requests, checks, timeouts, resets, gone, refused;
+    u32 kib_in, kib_out;
+};
+
+struct uds_diag_disk {
+    u8  bios, dtype, uds, rsvd;
+    u32 sectors_lo, sectors_hi;
+};
+
+#define UDS_EV_PRESENT   1
+#define UDS_EV_GONE      2
+#define UDS_EV_RESET     3
+#define UDS_EV_EJECT     4
+#define UDS_EV_BADREQ    5
+#define UDS_EV_HWFAIL    6
