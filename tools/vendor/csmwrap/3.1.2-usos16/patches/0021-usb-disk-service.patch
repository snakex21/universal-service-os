diff -ruN a/seabios/src/hw/usb-uds.c b/seabios/src/hw/usb-uds.c
--- a/seabios/src/hw/usb-uds.c
+++ b/seabios/src/hw/usb-uds.c
@@ -0,0 +1,596 @@
+// USOS USB disk service (UDS): USB mass storage for an OS driver through
+// channel 1 of the CSMWrap helper core.
+//
+// Copyright (C) 2026 Maksymilian and the USOS Authors
+//
+// This file may be distributed under the terms of the GNU LGPLv3 license.
+//
+// USOS patch 0021 (CSMWrap 3.1.2-usos16). Own code from the USB Mass
+// Storage Class Bulk-Only Transport 1.0, xHCI 1.2 and SCSI SPC/SBC
+// specifications. SeaBIOS stays the only owner of the xHCI controller; the
+// Windows 9x miniport USOSUSB.MPD sends SCSI commands for USB sticks that
+// have no BIOS drive number (csmwrap.ini int13_boot_disk_only, patch 0014)
+// through a request block in its own memory:
+//
+//   F-segment: "CSMPPrxy" mailbox (64-byte aligned) + struct uds_channel at
+//   +48, in the same cache line, so the helper's MONITOR/MWAIT wakes on the
+//   channel 1 doorbell too. romlayout.S: the helper loop serves channel 0
+//   (call32 from V86) first, then calls usos_uds_service() when doorbell !=
+//   done. One request at a time; the OS polls done.
+//
+// Stage 1 of docs/usb9x-hotswap-design-2026-10-19.md (USOS repository): the
+// sticks found at POST; an unplugged stick ends its request at once
+// (GONE), its slot is disabled and it stays gone until the next boot.
+
+#include "biosvar.h" // GET_GLOBAL
+#include "block.h" // getDrive
+#include "byteorder.h" // be32_to_cpu
+#include "config.h" // CONFIG_USB_XHCI
+#include "output.h" // dprintf
+#include "stacks.h" // yield
+#include "string.h" // memcpy
+#include "usb.h" // usb_send_default_control
+#include "usb-msc.h" // struct usbdrive_s
+#include "usb-uds.h" // struct uds_req
+#include "usb-xhci.h" // xhci_usos_bulk
+#include "util.h" // timer_calc
+
+struct uds_int {
+    struct usb_pipe *in, *out, *ctl;
+    u32 capword;
+    u8 iface, probed;
+    char vendor[8], product[16];
+};
+
+struct uds_int UdsInt[UDS_MAX_DEVS] VARFSEG;
+u8 UdsCount VARFSEG;
+struct uds_diag UdsDiag VARLOW __aligned(16);
+extern u32 TimerKHz;
+extern u32 UsbMscNextTag;
+
+#define UDS_XFER_MS (USB_TIME_COMMAND + 100)
+
+// The request check of src/platform/bios/win9x/usosuds_slot.c (USOS
+// repository, the same authors), here under the LGPLv3 like this file.
+static u32
+uds_req_check(const struct uds_req *r, u32 *why)
+{
+    u32 w = UDS_WHY_OK;
+    if (r->magic != UDS_REQ_MAGIC) w = UDS_WHY_MAGIC;
+    else if (r->version != UDS_VERSION) w = UDS_WHY_VERSION;
+    else if (r->size != sizeof(struct uds_req)) w = UDS_WHY_SIZE;
+    else if (r->op < UDS_OP_ENUM || r->op > UDS_OP_STATUS) w = UDS_WHY_OP;
+    else if (r->op != UDS_OP_ENUM && r->op != UDS_OP_STATUS && r->dev >= UDS_MAX_DEVS) w = UDS_WHY_DEV;
+    else if (r->op == UDS_OP_SCSI && r->lun > UDS_MAX_LUN) w = UDS_WHY_LUN;
+    else if (r->op == UDS_OP_SCSI && (r->cdb_len < 6 || r->cdb_len > UDS_MAX_CDB)) w = UDS_WHY_CDB;
+    else if (r->dir > UDS_DIR_OUT) w = UDS_WHY_DIR;
+    else if ((r->op == UDS_OP_ENUM || r->op == UDS_OP_STATUS) && r->dir != UDS_DIR_IN) w = UDS_WHY_DIR;
+    else if ((r->op == UDS_OP_RESET || r->op == UDS_OP_EJECT) && r->dir != UDS_DIR_NONE) w = UDS_WHY_DIR;
+    else if ((r->dir == UDS_DIR_NONE) != (r->data_len == 0)) w = UDS_WHY_LEN;
+    else if (r->data_len > UDS_MAX_DATA) w = UDS_WHY_LEN;
+    else if (r->op == UDS_OP_ENUM && r->data_len < UDS_MAX_DEVS * sizeof(struct uds_dev_info)) w = UDS_WHY_LEN;
+    else if (r->data_len && (r->data_phys == 0 || r->data_phys > 0xFFFFFFFFUL - (r->data_len - 1)))
+        w = UDS_WHY_ADDR;
+    else if (r->data_len && r->data_phys < 0x100000UL && r->data_phys + r->data_len > 0xA0000UL)
+        w = UDS_WHY_ADDR;   /* never DMA into VGA / option ROM / BIOS (A0000h-FFFFFh) */
+    if (why) *why = w;
+    return w == UDS_WHY_OK ? UDS_S_OK : UDS_S_BADREQ;
+}
+
+
+/****************************************************************
+ * Diagnostics record
+ ****************************************************************/
+
+void
+usos_uds_init(void)
+{
+    if (UdsDiag.version)
+        return;
+    // two immediates: the signature is not in the ROM image as data
+    UdsDiag.sig[0] = 0x534f5355;   // "USOS"
+    UdsDiag.sig[1] = 0x4b534455;   // "UDSK"
+    UdsDiag.version = UDS_DIAG_VERSION;
+}
+
+static void
+uds_event(int idx, u8 event, u8 result)
+{
+    u8 slot = UdsDiag.next_event % UDS_DIAG_EVENTS;
+    struct uds_diag_event *e = &UdsDiag.ev[slot];
+    u32 khz = GET_GLOBAL(TimerKHz);
+    e->ms = khz ? timer_calc(0) / khz : 0;
+    e->dev = idx;
+    e->port = (idx >= 0 && idx < UDS_MAX_DEVS) ? UdsDiag.dev[idx].port : 0;
+    e->event = event;
+    e->result = result;
+    UdsDiag.next_event = (slot + 1) % UDS_DIAG_EVENTS;
+    UdsDiag.events++;
+}
+
+// BIOS drive number of a UDS entry: 80h+ hard disk, E0h+ CD-ROM, 0 none
+static u8
+uds_bios_drive(int idx)
+{
+    int t, i;
+    for (t = EXTTYPE_HD; t <= EXTTYPE_CD; t++)
+        for (i = 0; i < BUILD_MAX_EXTDRIVE; i++) {
+            struct drive_s *drive = getDrive(t, i);
+            if (!drive || (drive->type != DTYPE_USB_32 && drive->type != DTYPE_USB))
+                continue;
+            struct usbdrive_s *ud = container_of(drive, struct usbdrive_s, drive);
+            if (ud->uds == idx + 1)
+                return (t == EXTTYPE_HD ? 0x80 : 0xe0) + i;
+        }
+    return 0;
+}
+
+// The BIOS hard disks and CD-ROMs as they were mapped (first service call)
+static void
+uds_fill_disks(void)
+{
+    int t, i, n = 0;
+    for (t = EXTTYPE_HD; t <= EXTTYPE_CD; t++)
+        for (i = 0; i < BUILD_MAX_EXTDRIVE && n < UDS_DIAG_DISKS; i++) {
+            struct drive_s *drive = getDrive(t, i);
+            if (!drive)
+                continue;
+            struct uds_diag_disk *d = &UdsDiag.disk[n++];
+            d->bios = (t == EXTTYPE_HD ? 0x80 : 0xe0) + i;
+            d->dtype = drive->type;
+            if (drive->type == DTYPE_USB_32 || drive->type == DTYPE_USB)
+                d->uds = container_of(drive, struct usbdrive_s, drive)->uds;
+            d->sectors_lo = drive->sectors;
+            d->sectors_hi = drive->sectors >> 32;
+        }
+    UdsDiag.disks = n;
+}
+
+
+/****************************************************************
+ * Bulk-Only Transport
+ ****************************************************************/
+
+struct uds_cbw {
+    u32 sig, tag, len;
+    u8 flags, lun, cblen;
+    u8 cb[16];
+} PACKED;
+
+struct uds_csw {
+    u32 sig, tag, residue;
+    u8 status;
+} PACKED;
+
+static int
+uds_ctl(struct uds_int *u, u8 type, u8 request, u16 value, u16 index)
+{
+    struct usb_ctrlrequest req = {
+        .bRequestType = type, .bRequest = request,
+        .wValue = value, .wIndex = index, .wLength = 0,
+    };
+    return usb_send_default_control(u->ctl, &req, NULL);
+}
+
+static void
+uds_clear_halt(struct uds_int *u, struct usb_pipe *pipe, int in)
+{
+    xhci_usos_reset_ep(pipe);
+    uds_ctl(u, USB_RECIP_ENDPOINT, USB_REQ_CLEAR_FEATURE, 0
+            , pipe->ep | (in ? USB_DIR_IN : 0));
+}
+
+static void
+uds_gone(int idx)
+{
+    struct uds_diag_dev *d = &UdsDiag.dev[idx];
+    if (d->state == UDS_DEV_GONE)
+        return;
+    d->state = UDS_DEV_GONE;
+    xhci_usos_disable(UdsInt[idx].in);
+    uds_event(idx, UDS_EV_GONE, d->last_op);
+}
+
+// BOT reset recovery (MSC BOT 1.0 5.3.4): Bulk-Only Mass Storage Reset,
+// then CLEAR_FEATURE(ENDPOINT_HALT) on bulk-in and bulk-out, each with the
+// xHCI endpoint reset and dequeue pointer set.
+static int
+uds_reset(int idx)
+{
+    struct uds_int *u = &UdsInt[idx];
+    struct uds_diag_dev *d = &UdsDiag.dev[idx];
+    int rc = xhci_usos_check(u->in, u->capword);
+    if (rc == USOS_X_GONE) {
+        uds_gone(idx);
+        return -1;
+    }
+    if (rc)
+        return -1;
+    d->resets++;
+    rc = uds_ctl(u, USB_TYPE_CLASS | USB_RECIP_INTERFACE, 0xff, 0, u->iface);
+    uds_clear_halt(u, u->in, 1);
+    uds_clear_halt(u, u->out, 0);
+    uds_event(idx, UDS_EV_RESET, rc ? 1 : 0);
+    return rc;
+}
+
+static u32
+uds_fail(int idx, int rc, u8 phase)
+{
+    switch (rc) {
+    case USOS_X_GONE:
+        uds_gone(idx);
+        return UDS_S_GONE;
+    case USOS_X_HW:
+        uds_event(idx, UDS_EV_HWFAIL, 1);
+        return UDS_S_HWFAIL;
+    case USOS_X_TIMEOUT:
+        uds_event(idx, UDS_EV_TIMEOUT, phase);
+        UdsDiag.dev[idx].timeouts++;
+        uds_reset(idx);
+        return UdsDiag.dev[idx].state == UDS_DEV_GONE ? UDS_S_GONE : UDS_S_TIMEOUT;
+    default:
+        uds_event(idx, UDS_EV_PHASE, phase);
+        uds_reset(idx);
+        return UdsDiag.dev[idx].state == UDS_DEV_GONE ? UDS_S_GONE : UDS_S_PHASE;
+    }
+}
+
+// One SCSI command (CBW, data, CSW). UDS_S_OK / _CHECK (CSW status 1, no
+// sense fetched here) / _GONE / _TIMEOUT / _PHASE / _HWFAIL.
+static u32
+uds_bot(int idx, u8 lun, const u8 *cdb, u8 cdblen, u8 dir, u32 phys, u32 len
+        , u32 *residue, u8 *cswstatus)
+{
+    struct uds_int *u = &UdsInt[idx];
+    struct uds_cbw cbw;
+    struct uds_csw csw;
+    memset(&cbw, 0, sizeof(cbw));
+    memset(&csw, 0, sizeof(csw));
+    u32 tag = UsbMscNextTag + 1;
+    UsbMscNextTag = tag;
+    cbw.sig = 0x43425355;   // "USBC"
+    cbw.tag = tag;
+    cbw.len = len;
+    cbw.flags = dir == UDS_DIR_IN ? USB_DIR_IN : 0;
+    cbw.lun = lun;
+    cbw.cblen = cdblen;
+    memcpy(cbw.cb, cdb, cdblen);
+    int rc = xhci_usos_bulk(u->out, (u32)&cbw, sizeof(cbw), UDS_XFER_MS, u->capword);
+    if (rc)
+        return uds_fail(idx, rc, 1);
+    if (len) {
+        int in = dir == UDS_DIR_IN;
+        struct usb_pipe *pipe = in ? u->in : u->out;
+        rc = xhci_usos_bulk(pipe, phys, len, UDS_XFER_MS, u->capword);
+        if (rc == USOS_X_STALL) {
+            // the device ended the data phase: clear it, the CSW follows
+            uds_event(idx, UDS_EV_STALL, 2);
+            uds_clear_halt(u, pipe, in);
+        } else if (rc) {
+            return uds_fail(idx, rc, 2);
+        }
+    }
+    rc = xhci_usos_bulk(u->in, (u32)&csw, sizeof(csw), UDS_XFER_MS, u->capword);
+    if (rc == USOS_X_STALL) {
+        uds_event(idx, UDS_EV_STALL, 3);
+        uds_clear_halt(u, u->in, 1);
+        rc = xhci_usos_bulk(u->in, (u32)&csw, sizeof(csw), UDS_XFER_MS, u->capword);
+    }
+    if (rc)
+        return uds_fail(idx, rc, 3);
+    if (csw.sig != 0x53425355 || csw.tag != tag) {   // "USBS"
+        uds_event(idx, UDS_EV_PHASE, 4);
+        uds_reset(idx);
+        return UDS_S_PHASE;
+    }
+    if (csw.status >= 2) {
+        uds_event(idx, UDS_EV_PHASE, 5);
+        uds_reset(idx);
+        return UDS_S_PHASE;
+    }
+    *residue = csw.residue > len ? len : csw.residue;
+    *cswstatus = csw.status;
+    return csw.status ? UDS_S_CHECK : UDS_S_OK;
+}
+
+// a short command with a small IN buffer on this stack (POST and helper)
+static u32
+uds_cmd_in(int idx, const u8 *cdb, u8 cdblen, void *buf, u32 len)
+{
+    u32 residue = 0;
+    u8 cs = 0;
+    memset(buf, 0, len);
+    return uds_bot(idx, 0, cdb, cdblen, len ? UDS_DIR_IN : UDS_DIR_NONE
+                   , (u32)buf, len, &residue, &cs);
+}
+
+
+/****************************************************************
+ * Device table (POST)
+ ****************************************************************/
+
+int
+usos_uds_reserve(struct usb_pipe *inpipe)
+{
+    if (!CONFIG_USB_XHCI || !CONFIG_USB_MSC || inpipe->type != USB_TYPE_XHCI)
+        return -1;
+    usos_uds_init();
+    if (UdsCount >= UDS_MAX_DEVS) {
+        uds_event(-1, UDS_EV_REGFAIL, 1);
+        return -1;
+    }
+    return UdsCount++;
+}
+
+void
+usos_uds_commit(int idx, struct usbdevice_s *usbdev, struct usb_pipe *inpipe
+                , struct usb_pipe *outpipe, int maxlun)
+{
+    struct uds_int *u = &UdsInt[idx];
+    struct uds_diag_dev *d = &UdsDiag.dev[idx];
+    u->in = inpipe;
+    u->out = outpipe;
+    // The control pipe stays with the stick (BOT reset recovery); the
+    // caller would otherwise free it after setup. On xHCI that only put it
+    // on a free list: the device slot and its EP0 stay as they were.
+    u->ctl = usbdev->defpipe;
+    usbdev->defpipe = NULL;
+    u->iface = usbdev->iface->bInterfaceNumber;
+    u->capword = xhci_usos_capword(inpipe);
+    u32 where = xhci_usos_where(inpipe);
+    d->slotid = where >> 8;
+    d->port = where;
+    d->speed = usbdev->speed;
+    d->luns = maxlun + 1;
+
+    d->generation = 1;
+    d->state = UDS_DEV_PRESENT;
+    UdsDiag.devs = UdsCount;
+    uds_event(idx, UDS_EV_PRESENT, d->luns);
+    dprintf(1, "USOS UDS: dev %d port %d slot %d luns %d\n"
+            , idx, d->port, d->slotid, d->luns);
+}
+
+
+/****************************************************************
+ * Channel 1 requests (helper core)
+ ****************************************************************/
+
+// VID:PID, INQUIRY strings and READ CAPACITY(10) of LUN 0, on the helper
+// core at the first request for a device without a BIOS number (POST
+// sends nothing beyond what SeaBIOS always sent).
+static void
+uds_probe(int idx)
+{
+    struct uds_int *u = &UdsInt[idx];
+    struct uds_diag_dev *d = &UdsDiag.dev[idx];
+    if (u->probed || d->state != UDS_DEV_PRESENT)
+        return;
+    u->probed = 1;
+    struct usb_device_descriptor dd;
+    struct usb_ctrlrequest req = {
+        .bRequestType = USB_DIR_IN, .bRequest = USB_REQ_GET_DESCRIPTOR,
+        .wValue = USB_DT_DEVICE << 8, .wIndex = 0, .wLength = sizeof(dd),
+    };
+    memset(&dd, 0, sizeof(dd));
+    if (!usb_send_default_control(u->ctl, &req, &dd)) {
+        d->vid = dd.idVendor;
+        d->pid = dd.idProduct;
+    }
+
+    static const u8 inquiry[6] = { 0x12, 0, 0, 0, 36, 0 };
+    static const u8 capacity[10] = { 0x25 };
+    u8 buf[36];
+    int i, ok = 0;
+    for (i = 0; i < 2 && !ok; i++)   // a pending UNIT ATTENTION fails the first
+        ok = uds_cmd_in(idx, inquiry, sizeof(inquiry), buf, 36) == UDS_S_OK;
+    if (ok) {
+        memcpy(u->vendor, buf + 8, 8);
+        memcpy(u->product, buf + 16, 16);
+    } else {
+        uds_event(idx, UDS_EV_REGFAIL, 2);
+    }
+    for (i = 0, ok = 0; i < 2 && !ok; i++)
+        ok = uds_cmd_in(idx, capacity, sizeof(capacity), buf, 8) == UDS_S_OK;
+    if (ok) {
+        d->last_lba_lo = be32_to_cpu(*(u32*)buf);
+        d->block_size = be32_to_cpu(*(u32*)(buf + 4));
+    }
+    dprintf(1, "USOS UDS: dev %d %04x:%04x cap %u x %u\n"
+            , idx, d->vid, d->pid, d->last_lba_lo, d->block_size);
+}
+
+// common checks of a request for one device; UDS_S_OK = go on
+static u32
+uds_dev_check(struct uds_req *r, int scsi)
+{
+    int idx = r->dev;
+    if (idx >= UdsCount || UdsDiag.dev[idx].state == UDS_DEV_EMPTY)
+        return UDS_S_NODEV;
+    struct uds_diag_dev *d = &UdsDiag.dev[idx];
+    d->bios_drive = uds_bios_drive(idx);
+    if (d->bios_drive) {
+        d->refused++;
+        return UDS_S_OWNED;
+    }
+    uds_probe(idx);
+    if (d->state != UDS_DEV_PRESENT || (scsi && r->generation != d->generation)) {
+        d->gone++;
+        return UDS_S_GONE;
+    }
+    if (r->lun >= d->luns) {
+        UdsDiag.badreq++;
+        UdsDiag.last_why = UDS_WHY_LUN;
+        d->refused++;
+        return UDS_S_BADREQ;
+    }
+    int rc = xhci_usos_check(UdsInt[idx].in, UdsInt[idx].capword);
+    if (rc == USOS_X_GONE) {
+        uds_gone(idx);
+        d->gone++;
+        return UDS_S_GONE;
+    }
+    if (rc) {
+        uds_event(idx, UDS_EV_HWFAIL, 2);
+        d->refused++;
+        return UDS_S_HWFAIL;
+    }
+    return UDS_S_OK;
+}
+
+static void
+uds_op_scsi(struct uds_req *r)
+{
+    int idx = r->dev;
+    struct uds_diag_dev *d = &UdsDiag.dev[idx];
+    d->requests++;
+    d->last_op = r->cdb[0];
+    u32 residue = 0;
+    u8 cs = 0;
+    u32 st = uds_bot(idx, r->lun, r->cdb, r->cdb_len, r->dir, r->data_phys
+                     , r->data_len, &residue, &cs);
+    r->residue = residue;
+    r->csw_status = cs;
+    r->sense_len = 0;
+    if (st == UDS_S_CHECK) {
+        // automatic REQUEST SENSE (fixed format, 18 bytes)
+        static const u8 rs[6] = { 0x03, 0, 0, 0, 18, 0 };
+        u8 sense[18];
+        u32 res2 = 0;
+        u8 cs2 = 0;
+        d->checks++;
+        memset(sense, 0, sizeof(sense));
+        u32 st2 = uds_bot(idx, r->lun, rs, sizeof(rs), UDS_DIR_IN, (u32)sense
+                          , sizeof(sense), &res2, &cs2);
+        if (st2 == UDS_S_OK) {
+            r->sense_len = sizeof(sense) - res2;
+            memcpy(r->sense, sense, sizeof(sense));
+            d->last_key = sense[2] & 0x0f;
+            d->last_asc = sense[12];
+            d->last_ascq = sense[13];
+        } else if (st2 == UDS_S_GONE) {
+            st = UDS_S_GONE;
+        }
+    } else if (st == UDS_S_OK) {
+        u32 kib = (r->data_len - residue) >> 10;
+        if (r->dir == UDS_DIR_IN)
+            d->kib_in += kib;
+        else
+            d->kib_out += kib;
+    }
+    if (st == UDS_S_GONE)
+        d->gone++;
+    d->last_csw = cs;
+    r->status = st;
+}
+
+static void
+uds_op_enum(struct uds_req *r)
+{
+    struct uds_dev_info *out = (void*)r->data_phys;
+    int i;
+    for (i = 0; i < UDS_MAX_DEVS; i++) {
+        struct uds_dev_info info;
+        memset(&info, 0, sizeof(info));
+        struct uds_diag_dev *d = &UdsDiag.dev[i];
+        if (i < UdsCount && d->state != UDS_DEV_EMPTY) {
+            d->bios_drive = uds_bios_drive(i);
+            if (!d->bios_drive)
+                uds_probe(i);
+            info.state = d->state;
+            info.bios_drive = d->bios_drive;
+            info.luns = d->luns;
+            info.port = d->port;
+            info.vid = d->vid;
+            info.pid = d->pid;
+            info.generation = d->generation;
+            info.block_size = d->block_size;
+            info.last_lba_lo = d->last_lba_lo;
+            info.last_lba_hi = d->last_lba_hi;
+            memcpy(info.vendor, UdsInt[i].vendor, sizeof(info.vendor));
+            memcpy(info.product, UdsInt[i].product, sizeof(info.product));
+        }
+        memcpy(&out[i], &info, sizeof(info));
+    }
+    r->residue = r->data_len - UDS_MAX_DEVS * sizeof(struct uds_dev_info);
+    r->status = UDS_S_OK;
+}
+
+static void
+uds_op_eject(struct uds_req *r)
+{
+    static const u8 sync[10] = { 0x35 };
+    static const u8 stop[6] = { 0x1b, 0, 0, 0, 0x02, 0 };   // LoEj, stop
+    int idx = r->dev;
+    u8 buf[1];
+    uds_cmd_in(idx, sync, sizeof(sync), buf, 0);   // no cache: ILLEGAL REQUEST
+    u32 st = uds_cmd_in(idx, stop, sizeof(stop), buf, 0);
+    if (UdsDiag.dev[idx].state == UDS_DEV_GONE) {
+        r->status = UDS_S_GONE;
+        return;
+    }
+    UdsDiag.dev[idx].state = UDS_DEV_EJECTED;
+    uds_event(idx, UDS_EV_EJECT, st);
+    r->status = UDS_S_OK;
+}
+
+// Called by the helper loop (romlayout.S) when the channel 1 doorbell
+// differs from done; ch = mailbox + 48.
+void VISIBLE32FLAT
+usos_uds_service(struct uds_channel *ch)
+{
+    u32 seq = ch->doorbell;
+    u32 rp = ch->req_phys;
+    usos_uds_init();
+    UdsDiag.services++;
+    UdsDiag.channel = (u32)ch;
+    if (!UdsDiag.disks)
+        uds_fill_disks();
+    if (!rp || (rp & 3) || rp > 0xffffffff - sizeof(struct uds_req)
+        || (rp + sizeof(struct uds_req) > 0xa0000 && rp < 0x100000)) {
+        UdsDiag.badreq++;
+        UdsDiag.last_why = UDS_WHY_ADDR;
+        goto done;
+    }
+    struct uds_req r;
+    memcpy(&r, (void*)rp, sizeof(r));   // nothing is read twice from the OS
+    u32 why;
+    u32 st = uds_req_check(&r, &why);
+    r.sense_len = 0;
+    r.residue = 0;
+    r.csw_status = 0;
+    if (st != UDS_S_OK) {
+        UdsDiag.badreq++;
+        UdsDiag.last_why = why;
+        uds_event(r.dev < UDS_MAX_DEVS ? r.dev : -1, UDS_EV_BADREQ, why);
+        r.status = UDS_S_BADREQ;
+    } else if (r.op == UDS_OP_ENUM) {
+        uds_op_enum(&r);
+    } else if (r.op == UDS_OP_STATUS) {
+        u32 n = r.data_len < sizeof(UdsDiag) ? r.data_len : sizeof(UdsDiag);
+        memcpy((void*)r.data_phys, &UdsDiag, n);
+        r.residue = r.data_len - n;
+        r.status = UDS_S_OK;
+    } else {
+        r.status = uds_dev_check(&r, r.op == UDS_OP_SCSI);
+        if (r.status == UDS_S_OK) {
+            if (r.op == UDS_OP_SCSI)
+                uds_op_scsi(&r);
+            else if (r.op == UDS_OP_RESET)
+                r.status = uds_reset(r.dev) ? UDS_S_PHASE : UDS_S_OK;
+            else
+                uds_op_eject(&r);
+            if (UdsDiag.dev[r.dev].state == UDS_DEV_GONE)
+                r.status = UDS_S_GONE;
+        }
+        UdsDiag.dev[r.dev].last_status = r.status;
+    }
+    if (r.dev < UdsCount)
+        r.generation = UdsDiag.dev[r.dev].generation;
+    memcpy((void*)rp + offsetof(struct uds_req, status), &r.status
+           , sizeof(r) - offsetof(struct uds_req, status));
+done:
+    barrier();
+    ch->done = seq;
+}
