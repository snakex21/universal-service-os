 }
+
+
+/****************************************************************
+ * USOS patch 0021: transport helpers for the USB disk service
+ * (src/hw/usb-uds.c, channel 1 of the helper core). Own code.
+ ****************************************************************/
+
+static struct usb_xhci_s *
+xhci_usos_cntl(struct xhci_pipe *pipe)
+{
+    return container_of(pipe->pipe.cntl, struct usb_xhci_s, usb);
+}
+
+// (slot id << 8) | root hub port (1-based) of a pipe's device, from the
+// output slot context the controller keeps; 0 when unknown.
+u32
+xhci_usos_where(struct usb_pipe *p)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(pipe);
+    if (!pipe->slotid || pipe->slotid > xhci->slots)
+        return 0;
+    struct xhci_slotctx *slot = (void*)xhci->devs[pipe->slotid].ptr_low;
+    if (!slot)
+        return 0;
+    u32 port = (slot->ctx[1] >> 16) & 0xff;
+    if (!port || port > xhci->ports)
+        return pipe->slotid << 8;
+    return (pipe->slotid << 8) | port;
+}
+
+// Controller and port state before / during a UDS transfer:
+// 0 usable, USOS_X_GONE the device's root port lost CCS, USOS_X_HW the
+// registers read all ones (BAR moved / decode off) or the controller
+// halted / reported a host system error. capword: dword 0 of the
+// capability registers as read at POST (0 = do not compare).
+int
+xhci_usos_check(struct usb_pipe *p, u32 capword)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(pipe);
+    u32 v = readl(xhci->caps);
+    if (v == 0xffffffff || (capword && v != capword))
+        return USOS_X_HW;
+    u32 sts = readl(&xhci->op->usbsts);
+    if (sts == 0xffffffff || (sts & ((1<<0) | (1<<2))))   // HCH, HSE
+        return USOS_X_HW;
+    u32 port = xhci_usos_where(p) & 0xff;
+    if (port && !(readl(&xhci->pr[port - 1].portsc) & XHCI_PORTSC_CCS))
+        return USOS_X_GONE;
+    return 0;
+}
+
+u32
+xhci_usos_capword(struct usb_pipe *p)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    return readl(xhci_usos_cntl(pipe)->caps);
+}
+
+// A command TRB with a raw parameter (Set TR Dequeue needs a pointer that
+// xhci_cmd_submit would read as an input context).
+static int
+xhci_usos_cmd(struct usb_xhci_s *xhci, u32 param, u32 flags)
+{
+    mutex_lock(&xhci->cmds->lock);
+    xhci_trb_queue(xhci->cmds, (void*)param, 0, flags);
+    xhci_doorbell(xhci, 0, 0);
+    int rc = xhci_event_wait(xhci, xhci->cmds, 1000);
+    mutex_unlock(&xhci->cmds->lock);
+    return rc;
+}
+
+// Bring a bulk endpoint back to an empty, stopped-and-restartable ring
+// after a stall, an error or a timeout (xHCI 1.2 4.6.8 Reset Endpoint,
+// 4.6.9 Stop Endpoint, 4.6.10 Set TR Dequeue Pointer): Reset Endpoint
+// (halted -> stopped; a context state error when it was not halted),
+// Stop Endpoint (running -> stopped), then the dequeue pointer to the
+// ring's enqueue position; TRBs still queued are dropped.
+int
+xhci_usos_reset_ep(struct usb_pipe *p)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(pipe);
+    struct xhci_ring *ring = &pipe->reqs;
+    u32 ep = (pipe->slotid << 24) | (pipe->epid << 16);
+    xhci_usos_cmd(xhci, 0, (CR_RESET_ENDPOINT << 10) | ep);
+    xhci_usos_cmd(xhci, 0, (CR_STOP_ENDPOINT << 10) | ep);
+    if (ring->nidx >= ARRAY_SIZE(ring->ring) - 1) {
+        // the next TRB would go behind a link TRB: wrap first
+        xhci_trb_fill(ring, ring->ring, 0, (TR_LINK << 10) | TRB_LK_TC);
+        ring->nidx = 0;
+        ring->cs ^= 1;
+    }
+    u32 deq = (u32)&ring->ring[ring->nidx] | (ring->cs ? 1 : 0);
+    int cc = xhci_usos_cmd(xhci, deq, (CR_SET_TR_DEQUEUE << 10) | ep);
+    ring->eidx = ring->nidx;
+    return cc == CC_SUCCESS ? 0 : -1;
+}
+
+// Disable Slot for a device that was unplugged: the controller drops its
+// endpoints and every queued TD, so no DMA goes to an OS buffer later.
+void
+xhci_usos_disable(struct usb_pipe *p)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    if (pipe->slotid)
+        xhci_cmd_disable_slot(xhci_usos_cntl(pipe), pipe->slotid);
+}
+
+// One bulk TD to or from a physical buffer (no paging on the helper core:
+// linear = physical). A buffer that crosses a 64 KiB boundary becomes two
+// chained TRBs (a TRB buffer must not cross one), both with ISP, so a
+// short packet in the first one ends the TD with an event. While waiting,
+// the root port and the controller are checked on every pass, so an
+// unplug ends the request at once (USOS_X_GONE) instead of after the
+// transfer timeout. Returns USOS_X_OK / _STALL / _ERR / _TIMEOUT / _GONE /
+// _HW; on _TIMEOUT / _GONE / _HW the TD may still be queued (the caller
+// resets the endpoint or disables the slot).
+int
+xhci_usos_bulk(struct usb_pipe *p, u32 addr, u32 len, u32 timeout, u32 capword)
+{
+    if (!CONFIG_USB_XHCI)
+        return USOS_X_ERR;
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(pipe);
+    struct xhci_ring *ring = &pipe->reqs;
+    if (!len || xhci_ring_busy(ring))
+        return USOS_X_ERR;
+    int rc = xhci_usos_check(p, capword);
+    if (rc)
+        return rc;
+    u32 first = len, rest = 0;
+    if ((addr ^ (addr + len - 1)) & ~0xffff) {
+        first = 0x10000 - (addr & 0xffff);
+        rest = len - first;
+    }
+    u32 n = rest ? 2 : 1;
+    if (ring->nidx + n > ARRAY_SIZE(ring->ring) - 1) {
+        // keep the TD in one lap: no link TRB inside a chain
+        xhci_trb_fill(ring, ring->ring, 0, (TR_LINK << 10) | TRB_LK_TC);
+        ring->nidx = 0;
+        ring->cs ^= 1;
+    }
+    u32 flags = (TR_NORMAL << 10) | TRB_TR_ISP;
+    if (rest) {
+        xhci_trb_fill(ring, (void*)addr, first, flags | TRB_TR_CH);
+        ring->nidx++;
+        barrier();
+        xhci_trb_fill(ring, (void*)(addr + first), rest, flags | TRB_TR_IOC);
+    } else {
+        xhci_trb_fill(ring, (void*)addr, len, flags | TRB_TR_IOC);
+    }
+    ring->nidx++;
+    xhci_doorbell(xhci, pipe->slotid, pipe->epid);
+
+    u32 end = timer_calc(timeout);
+    for (;;) {
+        xhci_process_events(xhci);
+        if (!xhci_ring_busy(ring))
+            break;
+        if (n == 2 && ring->eidx == ring->nidx - 1) {
+            // event on the first TRB (short packet or error): TD ended
+            ring->eidx = ring->nidx;
+            break;
+        }
+        rc = xhci_usos_check(p, capword);
+        if (rc)
+            return rc;
+        if (timer_check(end))
+            return USOS_X_TIMEOUT;
+        yield();
+    }
+    u32 cc = (ring->evt.status >> 24) & 0xff;
+    if (cc == CC_SUCCESS || cc == CC_SHORT_PACKET)
+        return USOS_X_OK;
+    if (cc == CC_STALL_ERROR)
+        return USOS_X_STALL;
+    dprintf(1, "%s: cc %d\n", __func__, cc);
+    return USOS_X_ERR;
+}
