 #define USOS_APMOFF_INT15 1
 #define USOS_APMOFF_PM16  2
 #define USOS_APMOFF_PM32  3
 
+/*
+ * USOS 0009: power-off breadcrumbs in battery-backed CMOS, so a hung or
+ * forced-off X470 still tells the next USOS boot what happened. Bytes: the
+ * RTC alarm registers 01h/03h/05h (MC146818; outside the AT checksum range
+ * 10h-2Dh; the alarm interrupt stays off, Status B AIE = 0, neither
+ * SeaBIOS nor USOS sets an alarm).
+ *
+ * Every value written is a VALID alarm time in the RTC's own format
+ * (Status B DM: BCD or binary; hours 1-8 are valid in 12- and 24-hour
+ * mode): edk2's PcRtc driver (PcRtcInit) and firmware derived from it
+ * reset an invalid alarm to 00:00:00 on every boot, which would wipe the
+ * record before the USOS menu reads it.
+ *   01h seconds  40 + last step (USOS_STEP_*, 0-15)
+ *   03h minutes  path of the last 5307h off call * 15 + call count (0-14)
+ *   05h hours    1 + bitmap: bit0 32-bit PM connect (5303h), bit1 real-
+ *                mode or 16-bit PM connect (5301h/5302h), bit2 any other
+ *                runtime call (5305h/5306h idle/busy, 5308h/530Ah/530Bh/
+ *                530Dh/530Fh)
+ * "Armed" = 40/0/1, written when CSMWrap starts SeaBIOS
+ * (usos_apm_crumb_arm from handle_csm_0002); the USOS UEFI menu reads a
+ * record (seconds 40-55 and hours 1-8), appends it to
+ * EFI\USOS\Logs\apm-off.txt and writes 0/0/0
+ * (src/platform/uefi/apm_breadcrumbs.zig). Every step also goes to port
+ * 80h as A0h | step (POST code display).
+ *
+ * Own port I/O with interrupts off around each index/data pair (an OS
+ * interrupt handler touching the RTC in between would otherwise take our
+ * index); hw/rtc.c is not linked into the 32-bit segmented code that the
+ * 32-bit PM entry runs. Works from real/V86 mode, 16-bit PM and 32-bit PM.
+ */
+#define USOS_CRUMB_STEP  0x01
+#define USOS_CRUMB_CALLS 0x03
+#define USOS_CRUMB_FNS   0x05
+#define USOS_STEP_ARMED     0x0
+#define USOS_STEP_ENTER     0x1  // 5307h BX=1 CX=3 entered
+#define USOS_STEP_ACPIEN    0x2  // ACPI_ENABLE written to SMI_CMD
+#define USOS_STEP_SCIEN     0x3  // SCI_EN 1 (now or already)
+#define USOS_STEP_SCITMO    0x4  // SCI_EN still 0 after 1 s
+#define USOS_STEP_STSCLR    0x5  // PM1/GPE0 status cleared, enables 0
+#define USOS_STEP_S5        0x6  // SLP_TYP|SLP_EN written, waiting 2 s
+#define USOS_STEP_HELPER    0x7  // helper ResetSystem posted
+#define USOS_STEP_HLPTMO    0x8  // helper timed out
+#define USOS_STEP_HLPRET    0x9  // helper returned / unavailable
+#define USOS_STEP_FAIL      0xF  // returning AH=60h
+
+static u8
+usos_cmos_rd(u8 index)
+{
+    u32 flags = save_flags();
+    irq_disable();
+    outb(index | NMI_DISABLE_BIT, PORT_CMOS_INDEX);
+    u8 v = inb(PORT_CMOS_DATA);
+    restore_flags(flags);
+    return v;
+}
+
+static void
+usos_cmos_wr(u8 index, u8 val)
+{
+    u32 flags = save_flags();
+    irq_disable();
+    outb(index | NMI_DISABLE_BIT, PORT_CMOS_INDEX);
+    outb(val, PORT_CMOS_DATA);
+    restore_flags(flags);
+}
+
+// Status B bit 2 (DM): 1 = binary, 0 = BCD.
+static int
+usos_cmos_binary(void)
+{
+    return usos_cmos_rd(0x0B) & 0x04;
+}
+
+static void
+usos_crumb_put(u8 index, u8 v)
+{
+    if (!usos_cmos_binary())
+        v = ((v / 10) << 4) | (v % 10);
+    usos_cmos_wr(index, v);
+}
+
+static u8
+usos_crumb_get(u8 index)
+{
+    u8 v = usos_cmos_rd(index);
+    if (!usos_cmos_binary())
+        v = (v >> 4) * 10 + (v & 0x0f);
+    return v;
+}
+
+static void
+usos_crumb_step(u8 step)
+{
+    usos_crumb_put(USOS_CRUMB_STEP, 40 + (step & 0x0f));
+    outb(0xA0 | step, 0x80);
+}
+
+void
+usos_apm_crumb_arm(void)
+{
+    usos_crumb_put(USOS_CRUMB_CALLS, 0);
+    usos_crumb_put(USOS_CRUMB_FNS, 1);
+    usos_crumb_put(USOS_CRUMB_STEP, 40 + USOS_STEP_ARMED);
+}
+
+static void
+usos_crumb_fn(u8 al)
+{
+    u8 bit;
+    switch (al) {
+    case 0x03: bit = 0x01; break;             // 32-bit PM connect
+    case 0x01: case 0x02: bit = 0x02; break;  // real-mode / 16-bit PM connect
+    case 0x05: case 0x06: case 0x08: case 0x0a: case 0x0b: case 0x0d:
+    case 0x0f: bit = 0x04; break;             // runtime calls
+    default: return;
+    }
+    u8 h = usos_crumb_get(USOS_CRUMB_FNS);
+    u8 v = (h >= 1 && h <= 8) ? h - 1 : 0;
+    if (!(v & bit))
+        usos_crumb_put(USOS_CRUMB_FNS, 1 + (v | bit));
+}
+
+static void
+usos_crumb_call(u8 path)
+{
+    u8 m = usos_crumb_get(USOS_CRUMB_CALLS);
+    u8 n = m <= 59 ? m % 15 : 0;
+    if (n < 14)
+        n++;
+    usos_crumb_put(USOS_CRUMB_CALLS, (path & 3) * 15 + n);
+    usos_crumb_step(USOS_STEP_ENTER);
+}
+
