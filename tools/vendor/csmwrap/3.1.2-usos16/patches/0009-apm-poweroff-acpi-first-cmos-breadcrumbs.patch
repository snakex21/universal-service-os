+// USOS 0009 order: ACPI mode first (SCI_EN = 1 through SMI_CMD, the firmware
+// S5 path every ACPI OS exercises), quiesce, then S5. Returns only when the
+// machine is still on.
+static u8
+usos_apmoff_s5(u8 path)
+{
