+            , path, GET_GLOBAL(usos_slp_typa), GET_GLOBAL(usos_slp_typb)
+            , GET_GLOBAL(usos_s5_found), a, GET_GLOBAL(usos_pm1b_cnt));
+    usos_apmoff_mark(path, 2, flags);
+    usos_crumb_step(USOS_STEP_S5);
