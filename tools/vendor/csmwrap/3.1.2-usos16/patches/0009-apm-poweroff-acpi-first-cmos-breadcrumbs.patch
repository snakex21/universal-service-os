 }
 
+// Last resort, INT 15h and 32-bit PM only (needs a data segment for the
+// mailbox). Moved behind the S5 write: the helper core runs firmware
+// runtime code after a foreign OS owns the machine, the least trusted step.
 static u8
-usos_apmoff_helper(u8 path)
+usos_apmoff_helper(u8 path, u8 flags)
 {
-    dprintf(1, "USOS APMOFF: path=uefi from=%d (ResetSystem on the helper core)\n"
-            , path);
-    usos_apmoff_mark(path, 1, 0);
+    dprintf(1, "USOS APMOFF: still on, path=uefi from=%d (ResetSystem on the"
+            " helper core)\n", path);
+    usos_crumb_step(USOS_STEP_HELPER);
+    usos_apmoff_mark(path, 1, flags);
