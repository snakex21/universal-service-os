@@ -115,12 +119,145 @@ handle_155306(struct bregs *regs)
  *   4FF bit0 _S5 found, bit1 PM1a, bit2 PM1b, bit3 helper timeout,
  *       bit4 helper reset unavailable, bit5 ACPI enable tried
  * path 1 = INT 15h, 2 = 16-bit PM, 3 = 32-bit PM; step 1 = helper asked,
- * 2 = S5 written, 3 = S5 written after ACPI enable, 4 = gave up.
+ * 2 = S5 written (flags bit5: after an ACPI enable), 4 = gave up.
