diff --git a/seabios/src/usos_watch.c b/seabios/src/usos_watch.c
new file mode 100644
index 0000000..64fa0ae
--- /dev/null
+++ b/seabios/src/usos_watch.c
@@ -0,0 +1,46 @@
+/* USOS helper-side observer. Own code, LGPLv3-or-later (SeaBIOS).
+ * Persistent writes: own page 20..27/100..1ff and VGA row 24 only.
+ * The caller's normal stack is temporary; no mutable firmware globals. */
+#include "types.h"
+#include "../../src/usos_watcher.c"
+static u64 usw_helper_tsc(void) {
+    u32 a,d;asm volatile("lfence; rdtsc":"=a"(a),"=d"(d)::"memory");
+    return (u64)a|((u64)d<<32);
+}
+static usw_u32 usw_phys32(void *ctx,usw_u32 pa) {
+    (void)ctx;return *(volatile usw_u32 *)pa;
+}
+static usw_u8 usw_port8(void *ctx,usw_u16 p) {
+    usw_u8 v;(void)ctx;asm volatile("inb %w1,%0":"=a"(v):"d"(p));return v;
+}
+static usw_u16 usw_port16(void *ctx,usw_u16 p) {
+    usw_u16 v;(void)ctx;asm volatile("inw %w1,%0":"=a"(v):"d"(p));return v;
+}
+void VISIBLE32FLAT usos_watch_tick(u32 pa) {
+    volatile usw_u8 *m=(void *)pa;u64 now=usw_helper_tsc(),hz,next;
+    if(!usw_header_valid(m,USW_SIZE)) return;
+    hz=usw_load64(m,USW_FREQ);next=usw_load64(m,USW_NEXT);
+    if(!hz) return;
+    if(!next) {
+        usw_store64(m,USW_START,now);usw_store64(m,USW_NEXT,now+hz);
+        return;
+    }
+    if(now<next) return;
+    struct usw_sample s;char line[80];
+    struct usw_ops ops={0,usw_phys32,usw_port8,usw_port16};
+    usw_collect(m,&ops,now,&s);usw_format(&s,line);usw_save(m,&s,line);
+    volatile u16 *v=(void *)(0xB8000+24*160);
+    for(unsigned i=0;i<80;i++) v[i]=(u16)(0x0E00|(u8)line[i]);
+    usw_store64(m,USW_LAST,now);
+    usw_store64(m,USW_NEXT,now+hz); /* no catch-up burst after a proxy delay */
+    usw_store32(m,USW_LATE,0);
+}
+void VISIBLE32FLAT usos_watch_proxy_enter(u32 pa) {
+    volatile usw_u8 *m=(void *)pa;
+    usw_store64(m,USW_PROXY_START,usw_helper_tsc());
+}
+void VISIBLE32FLAT usos_watch_proxy_leave(u32 pa) {
+    volatile usw_u8 *m=(void *)pa;u64 now=usw_helper_tsc();
+    if(now>usw_load64(m,USW_NEXT)) usw_store32(m,USW_LATE,1);
+    usw_store32(m,USW_PROXY_COUNT,usw_load32(m,USW_PROXY_COUNT)+1);
+}
