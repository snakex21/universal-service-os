+/* Pure helper-side NMI state machine. Own code, LGPL-2.1-or-later. */
+#include "usos_watcher.h"
+#include "usos_nmi.h"
+
+int usn_step(volatile usw_u8 *m, usw_u64 now, const struct usw_sample *sample,
+             usw_u32 proxy_calls, int proxy_pending)
+{
+    usw_u32 phase, required = USW_V_TICK | USW_V_TIME | USW_V_PUBLISH;
+    usw_u64 hz, changed;
+    if (usw_load32(m, USN_CFG) != USN_MAGIC || usw_load32(m, USN_ENABLE) != 1 ||
+        m[4] != 2 || m[5] != 0 || !usw_header_valid(m, USW_SIZE)) return 0;
+    phase = usw_load32(m, USN_PHASE);
+    if ((phase == USN_REQUESTED || phase == USN_NOACK) &&
+        usw_load32(m, USN_ACK) == USN_TOKEN) {
+        usw_store32(m, USN_PHASE, USN_DONE);
+        return 0;
+    }
+    hz = usw_load64(m, USW_FREQ);
+    if (phase == USN_REQUESTED) {
+        if (now - usw_load64(m, USN_SENT_TSC) >= hz) {
+            usw_store32(m, USN_PHASE, USN_NOACK);
+            usw_store32(m, USN_REASON, 20);
+        }
+        return 0;
+    }
+    if (phase >= USN_DONE) return 0;
+    if (usw_load32(m, USN_REJECT)) {
+        usw_store32(m, USN_PHASE, USN_SKIPPED);
+        usw_store32(m, USN_REASON, 0x100u + usw_load32(m, USN_REJECT));
+        return 0;
+    }
+    if (usw_load32(m, USN_READY) != USN_READY_MAGIC) return 0;
+    if (usw_load32(m, USN_BSP) >= 255 || usw_load32(m, USN_HELPER) >= 255 ||
+        usw_load32(m, USN_BSP) == usw_load32(m, USN_HELPER) ||
+        hz < 1000000ull || hz > 20000000000ull) {
+        usw_store32(m, USN_PHASE, USN_SKIPPED);
+        usw_store32(m, USN_REASON, 2);
+        return 0;
+    }
+    /* NONINVARIANT marks approximate elapsed time, not invalid T/I samples.
+       It is retained in the watcher line, including under QEMU TCG. */
+    if ((sample->flags & required) != required || (sample->flags & (USW_F_TORN | USW_F_BUSY)) ||
+        sample->arm != 2 || proxy_pending) {
+        usw_store64(m, USN_ADVANCE, 0);
+        return 0;
+    }
+    changed = usw_load64(m, USN_ADVANCE);
+    if (!changed || sample->tick != usw_load32(m, USN_OLD_TICK) ||
+        sample->it_low != usw_load32(m, USN_OLD_IT) ||
+        proxy_calls != usw_load32(m, USN_OLD_PROXY)) {
+        usw_store32(m, USN_PHASE, USN_WATCH);
+        usw_store32(m, USN_OLD_TICK, sample->tick);
+        usw_store32(m, USN_OLD_IT, sample->it_low);
+        usw_store32(m, USN_OLD_PROXY, proxy_calls);
+        usw_store64(m, USN_ADVANCE, now);
+        return 0;
+    }
+    if (now - changed < hz * 10) return 0;
+    /* Commit the sole token before sending. Never retry, including NOACK. */
+    usw_store64(m, USN_SENT_TSC, now);
+    usw_store32(m, USN_PHASE, USN_REQUESTED);
+    usw_store32(m, USN_REQUEST, USN_TOKEN);
+    return 1;
+}
