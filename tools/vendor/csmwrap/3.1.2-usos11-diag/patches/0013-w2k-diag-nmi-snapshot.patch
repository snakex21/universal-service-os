 /* Own USOS watcher preparation, LGPL-2.1-or-later.
  * No RTC, SMI, APIC or chipset writes added by this file. */
 #include <efi.h>
+#include <config.h>
+#include "usos_nmi.h"
 #include <csmwrap.h>
 #include <io.h>
 #include <printf.h>
@@ -65,6 +67,18 @@ void usos_watcher_verify_e820(struct csmwrap_priv *p) {
     }
     printf("USOS WATCH: E820 page %x %s\n",usw_page,usw_reserved?"RESERVED PASS":"FAIL (watcher disabled)");
 }
+void usos_watcher_nmi_target(uint32_t bsp, uint32_t helper) {
+    if (!gConfig.acpi_legacy_fadt || !gConfig.w2k_nmi_snapshot || !usw_page ||
+        bsp >= 255 || helper >= 255 || bsp == helper) return;
+    volatile usw_u8 *m = (void *)(uintptr_t)usw_page;
+    *(volatile usw_u16 *)(m + 4) = 2;
+    usw_store32(m, USN_CFG, USN_MAGIC);
+    usw_store32(m, USN_ENABLE, 1);
+    usw_store32(m, USN_BSP, bsp);
+    usw_store32(m, USN_HELPER, helper);
+    printf("USOS NMI: one-shot BSP %u helper %u (RTE/RTC omitted)\n", bsp, helper);
+}
+
 uint32_t usos_watcher_helper_pa(void) {return usw_reserved?usw_page:0;}
