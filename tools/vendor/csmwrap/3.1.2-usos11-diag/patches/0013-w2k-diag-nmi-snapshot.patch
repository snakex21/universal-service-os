diff --git a/seabios/src/usos_nmi_helper.inc b/seabios/src/usos_nmi_helper.inc
new file mode 100644
index 0000000..1b7666a
--- /dev/null
+++ b/seabios/src/usos_nmi_helper.inc
@@ -0,0 +1,152 @@
+/* One-shot physical NMI IPI + frozen display. Own code, LGPL-3.0-or-later.
+ * Hardware writes: helper APIC_BASE enable/restore when originally disabled,
+ * and helper ICR high/low once to verified BSP. No other CPU is reconfigured.
+ * No broadcast, EOI, RTC, IOREGSEL or clock/routing repair.
+ */
+#include "../../src/usos_nmi.h"
+#include "../../src/usos_nmi_state.inc"
+
+static void usn_skip(volatile usw_u8 *m, usw_u32 reason)
+{
+    usw_store32(m, USN_PHASE, USN_SKIPPED);
+    usw_store32(m, USN_REASON, reason);
+    usw_store32(m, USN_REQUEST, 0);
+}
+
+static void usn_send(volatile usw_u8 *m)
+{
+    usw_u32 low, high, actual, i, restored_low, restored_high;
+    if (usw_load32(m, USN_ACK) == USN_TOKEN) { usw_store32(m, USN_PHASE, USN_DONE); return; }
+    if (usw_load32(m, USN_READY) != USN_READY_MAGIC || usw_load32(m, USN_REJECT)) { usn_skip(m, 8); return; }
+    asm volatile("rdmsr" : "=a"(low), "=d"(high) : "c"(0x1Bu));
+    if (high || (low & 0x400u) || (low & 0x100u) || !(low & 0xFFFFF000u)) { usn_skip(m, 3); return; }
+    usw_store32(m, USN_APIC_BEFORE, low);
+    int enable = !(low & 0x800u);
+    if (enable) {
+        /* Upstream intentionally disables the helper APIC. The diagnostic
+           must briefly enable it to send an IPI. Restrict that transition
+           to modern AMD (K8+, including the X470 target and QEMU max).
+           Do not attempt to re-enable an old three-wire APIC. */
+        usw_u32 a, b, c, d, family;
+        asm volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(0));
+        if (b != 0x68747541u || d != 0x69746E65u || c != 0x444D4163u) { usn_skip(m, 9); return; }
+        asm volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(1));
+        family = (a >> 8) & 15;
+        if (family == 15) family += (a >> 20) & 255;
+        if (family < 15) { usn_skip(m, 9); return; }
+        asm volatile("wrmsr" :: "a"(low | 0x800u), "d"(high), "c"(0x1Bu) : "memory");
+    }
+    volatile usw_u32 *apic = (void *)(low & 0xFFFFF000u);
+    usw_store32(m, USN_HELPER_SVR, apic[0xF0 / 4]);
+    actual = apic[0x20 / 4] >> 24;
+    if (actual != usw_load32(m, USN_HELPER) || actual == usw_load32(m, USN_BSP)) { usn_skip(m, 4); goto restore; }
+    if (apic[0x300 / 4] & 0x1000u) { usn_skip(m, 5); goto restore; }
+    apic[0x310 / 4] = usw_load32(m, USN_BSP) << 24;
+    apic[0x300 / 4] = 0x4400u; /* NMI, physical destination, no shorthand */
+    /* <= 1 ms, power-of-two division avoids a 32-bit libgcc dependency. */
+    usw_u64 deadline = usw_helper_tsc() + (usw_load64(m, USW_FREQ) >> 10);
+    for (i = 0; i < 100000u; i++) {
+        if (!(apic[0x300 / 4] & 0x1000u)) goto restore;
+        if (usw_helper_tsc() >= deadline) break;
+        asm volatile("pause");
+    }
+    /* Keep the token: a delayed NMI is still ours. No second ICR write. */
+    usw_store32(m, USN_REASON, 6);
+restore:
+    if (enable) asm volatile("wrmsr" :: "a"(low), "d"(high), "c"(0x1Bu) : "memory");
+    asm volatile("rdmsr" : "=a"(restored_low), "=d"(restored_high) : "c"(0x1Bu));
+    usw_store32(m, USN_APIC_AFTER, restored_low);
+    usw_store32(m, USN_APIC_RESTORED, restored_low == low && restored_high == high);
+    if (restored_low != low || restored_high != high) usw_store32(m, USN_REASON, 10);
+}
+
+static char *usn_hex(char *p, usw_u32 value)
+{
+    static const char digits[] = "0123456789ABCDEF";
+    for (unsigned n = 0; n < 8; n++) *p++ = digits[(value >> (28 - n * 4)) & 15];
+    return p;
+}
+
+static void usn_row(unsigned row, const char *name, const usw_u32 *values, unsigned count)
+{
+    char line[80]; unsigned n = 0;
+    while (*name && n < 80) line[n++] = *name++;
+    for (unsigned i = 0; i < count && n + 8 <= 80; i++) {
+        usn_hex(line + n, values[i]); n += 8;
+        if (n < 80) line[n++] = ' ';
+    }
+    volatile usw_u16 *vga = (void *)(0xB8000 + row * 160);
+    for (unsigned i = 0; i < 80; i++) vga[i] = 0x0B00u | (unsigned char)(i < n ? line[i] : ' ');
+}
+
+static void usn_context_display(volatile usw_u8 *m)
+{
+    usw_u32 values[6];
+    if (usw_load32(m, UE_PANEL_MAGIC) != UE_PANEL_VALUE) return;
+    for (unsigned row = 0; row < 11; row++) {
+        for (unsigned i = 0; i < 6; i++) values[i] = usw_load32(m, UE_PANEL + row * 24 + i * 4);
+        usn_row(row, row == 0 ? "ACPI B/RVA/CODE/ARB/V/N " : row == 1 ? "IRQ V/A/Start/End/F/PDO " : row >= 8 ? "ORIG " :
+            row % 3 == 2 ? "EXC " : row % 3 == 0 ? "REG " : "RET ", values, 6);
+    }
+}
+
+static void usn_display(volatile usw_u8 *m)
+{
+    usw_u32 phase = usw_load32(m, USN_PHASE), values[8];
+    if (phase != USN_DONE && phase != USN_NOACK && phase != USN_SKIPPED) return;
+    if (usw_load32(m, USN_UNSOL) == USN_EVENT_MAGIC) {
+        values[0] = usw_load32(m, USN_UNSOL_EIP); values[1] = usw_load32(m, USN_UNSOL_FLAGS);
+        values[2] = usw_load32(m, USN_UNSOL_TICK); values[3] = usw_load32(m, USN_UNSOL_TR);
+        values[4] = usw_load32(m, USN_UNSOL_VALID);
+        usn_row(16, "UNSOL EIP/F/T/TR/V ", values, 5);
+    }
+    values[0] = phase; values[1] = usw_load32(m, USN_REASON);
+    if (phase != USN_DONE) {
+        usn_row(17, "NMI state/reason ", values, 2);
+        if (usw_load32(m, USN_UNSOL) == USN_EVENT_MAGIC) {
+            values[0] = usw_load32(m, USN_KBASE); values[1] = usw_load32(m, USN_HBASE);
+            usn_row(18, "UNSOL kernel/HAL base ", values, 2);
+            usn_row(19, "Unsolicited NMI chained to stock W2K; no probe IPI ", values, 0);
+        }
+        return;
+    }
+    volatile usw_u8 *s = m + USN_SNAPSHOT;
+    usn_context_display(m);
+    if (usw_load32(s, NS_VALID) & 32u) {
+        for (unsigned i = 0; i < 5; i++) values[i] = usw_load32(s, NS_BUGCHECK + i * 4);
+        usn_row(16, "STOP code/P1/P2/P3/P4 ", values, 5);
+    }
+    values[0] = usw_load32(s, NS_EIP); values[1] = usw_load32(s, NS_FLAGS);
+    values[2] = usw_load32(s, NS_CS); values[3] = usw_load32(s, NS_VALID);
+    values[4] = usw_load32(m, USN_REASON); values[5] = usw_load32(m, USN_CAPTURE_REASON);
+    usn_row(17, "NMI EIP/F/CS/V/Herr/Berr ", values, 6);
+    values[0] = usw_load32(m, USN_KBASE); values[1] = usw_load32(m, USN_HBASE);
+    values[2] = usw_load32(s, NS_ESP); values[3] = usw_load32(s, NS_CR3);
+    values[4] = usw_load32(s, NS_APIC_BASE);
+    usn_row(18, "NMI K/H/ESP/CR3/APIC ", values, 5);
+    values[0] = usw_load32(s, NS_TPR); values[1] = usw_load32(s, NS_PPR);
+    values[2] = usw_load32(s, NS_ID); values[3] = usw_load32(s, NS_PCR_IRQL);
+    values[4] = usw_load32(s, NS_SVR);
+    usn_row(19, "NMI TPR/PPR/ID/IRQL/SVR ", values, 5);
+    values[0] = usw_load32(s, NS_TICK); values[1] = usw_load32(s, NS_IT);
+    values[2] = usw_load32(s, NS_HB); values[3] = usw_load32(s, NS_PARTIAL);
+    values[4] = usw_load32(m, USN_APIC_RESTORED);
+    usn_row(20, "NMI T/I/h/P/rest;noRTE/RTC ", values, 5);
+    for (unsigned group = 0; group < 3; group++) {
+        for (unsigned i = 0; i < 8; i++) values[i] = usw_load32(s, NS_ISR + group * 32 + i * 4);
+        usn_row(21 + group, group == 0 ? "ISR " : group == 1 ? "IRR " : "TMR ", values, 8);
+    }
+    usw_store32(m, USN_DRAWS, usw_load32(m, USN_DRAWS) + 1);
+}
+
+static void usn_tick(volatile usw_u8 *m, usw_u64 now, const struct usw_sample *sample, usw_u32 proxy)
+{
+    int pending = !proxy || *(volatile usw_u32 *)(proxy + 8) != 0;
+    if (usn_step(m, now, sample, usw_load32(m, USW_PROXY_COUNT), pending)) {
+        /* Recheck priority immediately before the sole send. A new request
+           cancels this attempt conservatively; it is not retried. */
+        if (*(volatile usw_u32 *)(proxy + 8)) usn_skip(m, 7);
+        else usn_send(m);
+    }
+    usn_display(m);
+}
