diff -ruN a/seabios/src/hw/usb.c b/seabios/src/hw/usb.c
--- a/seabios/src/hw/usb.c
+++ b/seabios/src/hw/usb.c
@@ -335,6 +335,37 @@
     return 0;
 }
 
+// USOS (usb-mouse-wheel): the first boot mouse interface after a device's
+// boot keyboard interface (wireless keyboard/mouse receivers, keyboards
+// with a pointing device), set up with a copy of usbdev. Only mice: a
+// second keyboard would share the one key state of usb-hid.c.
+static int
+usb_hid_next_mouse(struct usbdevice_s *usbdev, void *config_end, int num_iface)
+{
+    struct usb_interface_descriptor *iface = usbdev->iface;
+    for (;;) {
+        iface = (void*)iface + iface->bLength;
+        if (!num_iface
+            || (void*)iface + 2 > config_end
+            || iface->bLength < 2
+            || (void*)iface + iface->bLength > config_end)
+            return -1;
+        if (iface->bDescriptorType != USB_DT_INTERFACE)
+            continue;
+        num_iface--;
+        if (iface->bLength >= sizeof(*iface)
+            && iface->bInterfaceClass == USB_CLASS_HID
+            && iface->bInterfaceSubClass == USB_INTERFACE_SUBCLASS_BOOT
+            && iface->bInterfaceProtocol == USB_INTERFACE_PROTOCOL_MOUSE
+            && !iface->bAlternateSetting)
+            break;
+    }
+    struct usbdevice_s mdev = *usbdev;
+    mdev.iface = iface;
+    mdev.imax = config_end - (void*)iface;
+    return usb_hid_setup(&mdev);
+}
+
 // Called for every found device - see if a driver is available for
 // this device and do setup if so.
 static int
@@ -411,8 +442,12 @@
             ret = usb_msc_setup(usbdev);
         if (iface->bInterfaceProtocol == US_PR_UAS)
             ret = usb_uas_setup(usbdev);
-    } else
+    } else {
         ret = usb_hid_setup(usbdev);
+        if (iface->bInterfaceProtocol == USB_INTERFACE_PROTOCOL_KEYBOARD
+            && !usb_hid_next_mouse(usbdev, config_end, num_iface))
+            ret = 0;
+    }
     if (ret)
         goto fail;
 
