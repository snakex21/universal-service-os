     u8 report;          // 1 = report protocol (layout below), 0 = boot
     u8 report_id;       // 0 = the device uses no report IDs
+    u8 diag;            // slot in usb_mouse_diag.dev (0xff: none)
     struct hid_loc loc[6];
 };
 
@@ -44,6 +45,65 @@
 // and the device ID (0 standard PS/2 mouse, 3 IntelliMouse with wheel).
 u8 usb_mouse_rate1 VARLOW, usb_mouse_rate2 VARLOW, usb_mouse_id VARLOW;
 
+// USOS (usb-mouse-wheel diagnostics): what the mouse setup decided and the
+// last packet, for USOSDBG.EXE (it scans the first MiB in 16-byte steps for
+// the signature). Written at setup and per packet; never read back by the
+// BIOS. The signature is set at setup, so the image copy never has it.
+#define USB_MOUSE_DIAG_DEVS 4
+#define USB_MOUSE_DIAG_DESC 160
+struct usb_mouse_diag_dev {
+    u8 iface, maxpacket, report, report_id;
+    s8 result;          // 0 report protocol, < 0 why boot (USB_MD_*)
+    u8 pad;
+    u16 desclen;        // wDescriptorLength of the HID descriptor
+    struct hid_loc loc[6];
+};
+struct usb_mouse_diag {
+    u32 sig[2];         // "USOS" "MWHL" (two immediates: no string in the image)
+    u8 version;         // 1
+    u8 count;           // mice set up (all, also beyond DEVS)
+    u8 wheel;           // usb_mouse_wheel
+    u8 id;              // usb_mouse_id (3 after the knock)
+    u8 rate1, rate2;    // last two sample rates (after the knock: 100, 80)
+    u8 last_dev;        // slot of the last packet's mouse
+    s8 last_z;          // its wheel value (IntelliMouse sign)
+    u32 packets;        // packets handled, all mice
+    u32 zpackets;       // of them with a nonzero wheel value
+    u32 skipped;        // report protocol packets of another report ID
+    u8 last_raw[16];    // the last packet as read (maxpacket bytes valid)
+    struct usb_mouse_diag_dev dev[USB_MOUSE_DIAG_DEVS];
+    u16 desc_got;       // bytes of dev[0]'s report descriptor in desc
+    u8 desc[USB_MOUSE_DIAG_DESC];
+};
+struct usb_mouse_diag usb_mouse_diag VARLOW __aligned(16);
+
+// Why a mouse stays in the boot protocol (usb_mouse_diag_dev.result).
+#define USB_MD_LONGITEM   -1    // long item or truncated item
+#define USB_MD_BADID      -2    // Report ID 0 or > 255
+#define USB_MD_PUSH       -3    // nested Push
+#define USB_MD_POP        -4    // Pop without Push
+#define USB_MD_MANYIDS    -5    // more than 8 input report IDs
+#define USB_MD_BIGFIELD   -6    // Report Size > 32 or Report Count > 255
+#define USB_MD_LONGREPORT -7    // an input report longer than one packet
+#define USB_MD_NOX        -8
+#define USB_MD_NOY        -9
+#define USB_MD_NOWHEEL    -10
+#define USB_MD_NOBUTTON   -11
+#define USB_MD_XNOID      -12   // report IDs, but X in a report without one
+#define USB_MD_NOHIDDESC  -20   // no HID class descriptor naming a report
+#define USB_MD_DESCLEN    -21   // report descriptor longer than MAX_REPORT_DESC
+#define USB_MD_NOMEM      -22
+#define USB_MD_GETDESC    -23   // GET_DESCRIPTOR (report) failed
+#define USB_MD_SETPROTO   -30   // SET_PROTOCOL (report) failed
+
+static void
+usb_mouse_diag_rates(void)
+{
+    SET_LOW(usb_mouse_diag.id, GET_LOW(usb_mouse_id));
+    SET_LOW(usb_mouse_diag.rate1, GET_LOW(usb_mouse_rate1));
+    SET_LOW(usb_mouse_diag.rate2, GET_LOW(usb_mouse_rate2));
+}
