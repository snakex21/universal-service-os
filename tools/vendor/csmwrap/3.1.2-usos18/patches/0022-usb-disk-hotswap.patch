+
+// device table entry for a new stick: an unused one, or one whose stick
+// is gone / ejected (never one INT 13h owns); -1 when the table is full
+static int
+uds_free_entry(void)
+{
+    int i;
+    for (i = 0; i < UdsCount; i++) {
+        u8 st = UdsDiag.dev[i].state;
+        if (st != UDS_DEV_PRESENT && !UdsInt[i].chunk && !uds_bios_drive(i))
+            return i;
+    }
+    return UdsCount < UDS_MAX_DEVS ? UdsCount : -1;
+}
+
+static int
+uds_ctl_in(struct usb_pipe *ctl, u16 value, u16 len, void *buf)
+{
+    struct usb_ctrlrequest req = {
+        .bRequestType = USB_DIR_IN, .bRequest = USB_REQ_GET_DESCRIPTOR,
+        .wValue = value, .wIndex = 0, .wLength = len,
+    };
+    return usb_send_default_control(ctl, &req, buf);
+}
+
+// Bring up the stick on root port 'port' (0-based) of watched controller
+// c. Returns 0 and *pidx, or the reason (UDS_AF_*).
+static u8
+uds_attach(int c, int port, int *pidx)
+{
+    int k;
+    for (k = 0; k < UDS_POOL_DEVS && (UdsWatch.pool_used & (1 << k)); k++)
+        ;
+    if (k == UDS_POOL_DEVS)
+        return UDS_AF_POOL;
+    int idx = uds_free_entry();
+    if (idx < 0)
+        return UDS_AF_TABLE;
+    void *in = usos_uds_pool(), *m = in + 4096 * (1 + k);
+    u8 why, *buf = m + 3584;   // 512-byte descriptor buffer of the chunk
+    struct usb_pipe *ctl = xhci_usos_attach(c, port, m, in, &why);
+    if (!ctl)
+        return why;
+    struct usb_device_descriptor *dd = (void*)buf;
+    why = UDS_AF_DEVDESC;
+    if (uds_ctl_in(ctl, USB_DT_DEVICE << 8, 8, buf))
+        goto fail;
+    u16 mps = dd->bcdUSB >= 0x0300 ? 1 << (dd->bMaxPacketSize0 & 15)
+        : dd->bMaxPacketSize0;
+    why = UDS_AF_MPS;
+    if (mps < 8 || mps > 512 || xhci_usos_ctl_mps(ctl, in, mps))
+        goto fail;
+    why = UDS_AF_DEVDESC;
+    if (uds_ctl_in(ctl, USB_DT_DEVICE << 8, 18, buf))
+        goto fail;
+    u16 vid = dd->idVendor, pid = dd->idProduct;
+    struct usb_config_descriptor *cfg = (void*)buf;
+    why = UDS_AF_CONFIG;
+    if (uds_ctl_in(ctl, USB_DT_CONFIG << 8, 9, buf) || cfg->bLength < 9)
+        goto fail;
+    u16 total = cfg->wTotalLength > 512 ? 512 : cfg->wTotalLength;
+    if (total < 9 || uds_ctl_in(ctl, USB_DT_CONFIG << 8, total, buf))
+        goto fail;
+    u8 cfgval = cfg->bConfigurationValue, *p = buf + cfg->bLength, *end = buf + total;
+    struct usb_interface_descriptor *iface = NULL;
+    struct usb_endpoint_descriptor ei, eo;
+    ei.bLength = eo.bLength = 0;
+    for (; p + 2 <= end && p[0] >= 2 && p + p[0] <= end; p += p[0]) {
+        if (p[1] == USB_DT_INTERFACE && p[0] >= sizeof(*iface)) {
+            if (iface)
+                break;
+            struct usb_interface_descriptor *d = (void*)p;
+            if (d->bInterfaceClass == USB_CLASS_MASS_STORAGE
+                && d->bInterfaceProtocol == US_PR_BULK && !d->bAlternateSetting)
+                iface = d;
+        } else if (iface && p[1] == USB_DT_ENDPOINT && p[0] >= 7
+                   && (p[3] & USB_ENDPOINT_XFERTYPE_MASK) == USB_ENDPOINT_XFER_BULK) {
+            struct usb_endpoint_descriptor *e = (p[2] & USB_DIR_IN) ? &ei : &eo;
+            if (!e->bLength)
+                memcpy(e, p, sizeof(*e));
+        }
+    }
+    why = UDS_AF_NOTMSC;
+    if (!iface || !ei.bLength || !eo.bLength)
+        goto fail;
+    u8 ifnum = iface->bInterfaceNumber;
+    struct usb_ctrlrequest req = {
+        .bRequestType = USB_DIR_OUT | USB_TYPE_STANDARD | USB_RECIP_DEVICE,
+        .bRequest = USB_REQ_SET_CONFIGURATION, .wValue = cfgval,
+    };
+    why = UDS_AF_SETCFG;
+    if (usb_send_default_control(ctl, &req, NULL))
+        goto fail;
+    struct usb_pipe *bin, *bout;
+    why = UDS_AF_EPS;
+    if (xhci_usos_bulk_eps(ctl, m, in, &ei, &eo, &bin, &bout))
+        goto fail;
+    // GET MAX LUN (BOT 3.2); a stall means one LUN and halts EP0
+    struct usb_ctrlrequest ml = {
+        .bRequestType = USB_DIR_IN | USB_TYPE_CLASS | USB_RECIP_INTERFACE,
+        .bRequest = 0xfe, .wIndex = ifnum, .wLength = 1,
+    };
+    u8 maxlun = 0;
+    buf[0] = 0;
+    if (usb_send_default_control(ctl, &ml, buf))
+        xhci_usos_reset_ep(ctl);
+    else if (buf[0] <= UDS_MAX_LUN)
+        maxlun = buf[0];
+
+    struct uds_int *u = &UdsInt[idx];
+    struct uds_diag_dev *d = &UdsDiag.dev[idx];
+    memset(u, 0, sizeof(*u));
+    memset(d, 0, sizeof(*d));
+    memset(&UdsDiag.media[idx], 0, sizeof(UdsDiag.media[idx]));
+    u->in = bin;
+    u->out = bout;
+    u->ctl = ctl;
+    u->iface = ifnum;
+    u->capword = xhci_usos_capword(bin);
+    u->ctlidx = c;
+    u->chunk = k + 1;
+    UdsWatch.pool_used |= 1 << k;
+    d->port = port + 1;
+    d->slotid = xhci_usos_where(bin) >> 8;
+    d->speed = ctl->speed;
+    d->luns = maxlun + 1;
+    d->vid = vid;
+    d->pid = pid;
+    d->generation = ++UdsWatch.gen + 1;   // POST entries have generation 1
+    d->state = UDS_DEV_PRESENT;
+    UdsDiag.media[idx].ctl = c;
+    UdsDiag.media[idx].attach = 1;
+    if (idx >= UdsCount)
+        UdsCount = idx + 1;
+    UdsDiag.devs = UdsCount;
+    uds_event(idx, UDS_EV_ATTACH, d->luns);
+    *pidx = idx;
+    return 0;
+fail:
+    xhci_usos_teardown(ctl);
+    return why;
+}
+
+// the present stick (not owned by INT 13h) on root port 'port' (1-based)
+static int
+uds_on_port(int c, int port)
+{
+    int i;
+    for (i = 0; i < UdsCount; i++)
+        if (UdsInt[i].ctlidx == c && UdsDiag.dev[i].port == port
+            && UdsDiag.dev[i].state == UDS_DEV_PRESENT && !uds_bios_drive(i))
+            return i;
+    return -1;
+}
+
+static u8
+uds_pls(int c, int port)
+{
+    return (xhci_usos_portsc(c, port) >> 5) & 0xf;
+}
+
+// First channel 1 request: the OS client exists, all 32-bit SeaBIOS code
+// now runs on this core. Every root port is classified once.
+static void
+uds_arm(void)
+{
+    int c, p;
+    UdsWatch.armed = 1;
+    UdsDiag.armed = 1;
+    UdsArmed = 1;
+    for (c = 0; c < UsosXhciCount && c < USOS_X_CTLS; c++) {
+        u32 ccs, chg;
+        int n = xhci_usos_scan(c, &ccs, &chg);
+        u32 busy = xhci_usos_busy(c);
+        UdsDiag.ctl[c].busy_arm = busy;
+        UdsDiag.ctl[c].ccs_now = ccs;
+        for (p = 0; p < n; p++) {
+            u8 st = UDS_P_FREE;
+            int idx = uds_on_port(c, p + 1);
+            if (idx >= 0) {
+                st = UDS_P_OURS | idx;
+            } else if (busy & (1 << p)) {
+                st = UDS_P_BUSY;
+            } else if (ccs & (1 << p)) {
+                // connected without a device slot: POST did not set it up
+                // (the X470 stick after a warm restart); brought up below
+                st = UDS_P_PENDING;
+                UdsWatch.due[c][p] = UdsWatch.pass;
+                uds_ev(0xf0 | c, p + 1, UDS_EV_UNCLAIMED, uds_pls(c, p));
+            }
+            UdsWatch.st[c][p] = st;
+        }
+    }
+    uds_ev(0xff, 0, UDS_EV_ARM, UsosXhciCount);
+    UdsWatch.next = timer_calc(UDS_WATCH_MS);
+}
+
+static void
+uds_watch(void)
+{
+    u8 pass = ++UdsWatch.pass;
+    int c, p, busy = 0;
+    UdsDiag.watch_passes++;
+    for (c = 0; c < UsosXhciCount && c < USOS_X_CTLS; c++) {
+        u32 ccs, chg;
+        int n = xhci_usos_scan(c, &ccs, &chg);
+        UdsDiag.ctl[c].ccs_now = ccs;
+        for (p = 0; p < n; p++) {
+            u8 *st = &UdsWatch.st[c][p];
+            int on = (ccs >> p) & 1, changed = (chg >> p) & 1;
+            if (*st & UDS_P_OURS) {
+                int idx = *st & 0x7f;
+                if (on && !changed) {
+                    if (UdsDiag.dev[idx].state != UDS_DEV_PRESENT)
+                        *st = UDS_P_FAILED;   // ejected: until it is unplugged
+                    continue;
+                }
+                if (UdsDiag.dev[idx].state == UDS_DEV_PRESENT)
+                    uds_event(idx, UDS_EV_DETACH, on);
+                uds_release(idx, UDS_DEV_GONE);
+                UdsDiag.detaches++;
+                *st = UDS_P_FREE;
+            }
+            if (!on) {
+                *st = UDS_P_FREE;
+                continue;
+            }
+            if (*st == UDS_P_BUSY || *st == UDS_P_FAILED)
+                continue;
+            if (*st == UDS_P_FREE || changed) {
+                *st = UDS_P_PENDING;
+                UdsWatch.due[c][p] = pass;
+                uds_ev(0xf0 | c, p + 1, UDS_EV_CONNECT, uds_pls(c, p));
+                continue;
+            }
+            // pending and connected for at least one watch period
+            if (busy || UdsWatch.due[c][p] == pass)
+                continue;
+            busy = 1;   // one bring-up per pass: HID polls get the core back
+            int idx = -1;
+            u8 why = uds_attach(c, p, &idx);
+            if (why) {
+                *st = UDS_P_FAILED;
+                UdsDiag.attach_fails++;
+                UdsDiag.last_fail = why;
+                uds_ev(0xf0 | c, p + 1, UDS_EV_ATTFAIL, why);
+            } else {
+                *st = UDS_P_OURS | idx;
+                UdsDiag.attaches++;
+            }
+        }
+    }
+    UdsDiag.pool_used = UdsWatch.pool_used;
+    if (busy)
+        return;
+    // INQUIRY, READ CAPACITY and the media check of one new stick
+    for (c = 0; c < UdsCount; c++)
+        if (UdsDiag.dev[c].state == UDS_DEV_PRESENT && !UdsInt[c].probed
+            && !uds_bios_drive(c)) {
+            uds_probe(c);
+            break;
+        }
+}
+
+// Helper loop (romlayout.S), when neither channel has a request: the port
+// watch every UDS_WATCH_MS once armed. Returns 1 when armed (the loop then
+// spins with PAUSE instead of MWAIT, which only wakes on the mailbox).
+u32 VISIBLE32FLAT
+usos_uds_idle(void)
+{
+    if (!UdsArmed)
+        return 0;
+    if (timer_check(UdsWatch.next)) {
+        uds_watch();
+        UdsWatch.next = timer_calc(UDS_WATCH_MS);
+    }
+    return 1;
+}
