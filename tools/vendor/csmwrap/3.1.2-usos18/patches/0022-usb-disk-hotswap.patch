+// read it"): sector 0, the MBR partition types and the boot sector of the
+// volume (sector 0 itself for a stick without a partition table).
+static u8
+uds_fs_of(const u8 *b)
+{
+    if (b[510] != 0x55 || b[511] != 0xaa)
+        return 0;
+    if (!memcmp(b + 3, "NTFS    ", 8))
+        return UDS_FS_NTFS;
+    if (!memcmp(b + 3, "EXFAT   ", 8))
+        return UDS_FS_EXFAT;
+    if (!memcmp(b + 82, "FAT32", 5))
+        return UDS_FS_FAT32;
+    if (!memcmp(b + 54, "FAT12", 5))
+        return UDS_FS_FAT12;
+    if (!memcmp(b + 54, "FAT1", 4) || !memcmp(b + 54, "FAT ", 4))
+        return UDS_FS_FAT16;
+    return 0;
+}
