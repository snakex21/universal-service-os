+static int
+uds_read1(int idx, u32 lba, void *buf, u32 bs)
+{
+    u8 cdb[10] = { 0x28, 0, lba >> 24, lba >> 16, lba >> 8, lba, 0, 0, 1, 0 };
+    return uds_cmd_in(idx, cdb, sizeof(cdb), buf, bs) == UDS_S_OK ? 0 : -1;
+}
