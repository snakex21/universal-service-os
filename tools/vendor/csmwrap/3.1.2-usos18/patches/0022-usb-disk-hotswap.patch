+static void
+uds_media(int idx)
+{
+    struct uds_diag_media *m = &UdsDiag.media[idx];
+    u32 bs = UdsDiag.dev[idx].block_size;
+    u8 *b = usos_uds_pool();
+    u32 h = 0x811c9dc5, i;
+    m->fs = UDS_FS_UNREAD;
+    if (!b || bs < 512 || bs > 4096 || (bs & 511))
+        goto out;
+    m->fs = UDS_FS_READFAIL;
+    if (uds_read1(idx, 0, b, bs))
+        goto out;
+    for (i = 0; i < 512; i++)
+        h = (h ^ b[i]) * 0x01000193;
+    m->hash0 = h;
+    m->fs = UDS_FS_NOSIG;
+    if (b[510] != 0x55 || b[511] != 0xaa)
+        goto out;
+    m->flags |= UDS_MF_SIG;
+    u8 fs = uds_fs_of(b);
+    if (fs) {   // a volume without a partition table
+        m->flags |= UDS_MF_VBR;
+        m->fs = fs;
+        goto out;
+    }
+    u32 lba = 0;
+    for (i = 0; i < 4; i++) {
+        u8 *e = b + 446 + 16 * i;
+        m->types[i] = e[4];
+        if (e[4] && !lba)
+            lba = e[8] | (e[9] << 8) | (e[10] << 16) | ((u32)e[11] << 24);
+    }
+    m->fs = m->types[0] == 0xee ? UDS_FS_GPT : UDS_FS_OTHER;
+    if (!lba || m->fs == UDS_FS_GPT)
+        goto out;
+    m->part_lba = lba;
+    if (uds_read1(idx, lba, b, bs))
+        goto out;
+    m->flags |= UDS_MF_VBR;
+    fs = uds_fs_of(b);
+    if (fs)
+        m->fs = fs;
+out:
+    uds_event(idx, UDS_EV_MEDIA, m->fs);
+}
