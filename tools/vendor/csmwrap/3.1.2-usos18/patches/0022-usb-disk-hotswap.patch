+
+/****************************************************************
+ * USOS patch 0022: runtime bring-up of a USB stick on a root port and
+ * the port watch primitives for the USB disk service (usb-uds.c, helper
+ * core). Own code from xHCI 1.2 (4.3 device slot initialisation, 4.6.3-4.6.6
+ * commands, 4.19.1 root hub port state machines) and USB 2.0 chapter 9.
+ ****************************************************************/
+
+struct usb_xhci_s *UsosXhci[USOS_X_CTLS] VARFSEG;
+u8 UsosXhciCount VARFSEG;
+
+static void
+xhci_usos_register(struct usb_xhci_s *xhci)
+{
+    if (!usos_uds_pool() || UsosXhciCount >= USOS_X_CTLS)
+        return;
+    UsosXhci[UsosXhciCount++] = xhci;
+    xhci->usos_idx = UsosXhciCount;
+}
+
+// root ports with CCS once POST enumerated the controller (for the record)
+static void
+xhci_usos_post_ports(struct usb_xhci_s *xhci)
+{
+    if (!xhci->usos_idx)
+        return;
+    u32 ccs, chg;
+    xhci_usos_scan(xhci->usos_idx - 1, &ccs, &chg);
+    usos_uds_ctl_info(xhci->usos_idx - 1, xhci->ports, ccs);
+}
+
+// controller index of a pipe's controller, 0xff when it is not watched
+u8
+xhci_usos_ctl(struct usb_pipe *p)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    u8 i = xhci_usos_cntl(pipe)->usos_idx;
+    return i ? i - 1 : 0xff;
+}
+
+// Root ports 1-32 of watched controller c: CCS bitmap, and the ports whose
+// CSC was set (directly or latched by an event) since the last call; the
+// pending events are processed first, CSC is cleared. Returns the port
+// count (at most 32), 0 when c is not a watched controller.
+int
+xhci_usos_scan(int c, u32 *ccs, u32 *chg)
+{
+    *ccs = *chg = 0;
+    if (c < 0 || c >= UsosXhciCount)
+        return 0;
+    struct usb_xhci_s *xhci = UsosXhci[c];
+    xhci_process_events(xhci);
+    int n = xhci->ports < 32 ? xhci->ports : 32, i;
+    for (i = 0; i < n; i++) {
+        u32 portsc = readl(&xhci->pr[i].portsc);
+        if (portsc == 0xffffffff)
+            return 0;
+        if (portsc & XHCI_PORTSC_CCS)
+            *ccs |= 1 << i;
+        if (portsc & XHCI_PORTSC_CSC) {
+            *chg |= 1 << i;
+            writel(&xhci->pr[i].portsc, (portsc & XHCI_PORTSC_PP) | XHCI_PORTSC_CSC);
+        }
+    }
+    *chg |= xhci->usos_latch;
+    xhci->usos_latch = 0;
+    return n;
+}
+
+// Root ports (bit = port - 1) that have an enabled device slot: the
+// devices POST set up (keyboard, mouse, hub, stick, unsupported ones).
+u32
+xhci_usos_busy(int c)
+{
+    if (c < 0 || c >= UsosXhciCount)
+        return 0;
+    struct usb_xhci_s *xhci = UsosXhci[c];
+    u32 busy = 0, s;
+    for (s = 1; s <= xhci->slots; s++) {
+        struct xhci_slotctx *slot = (void*)xhci->devs[s].ptr_low;
+        u32 port = slot ? (slot->ctx[1] >> 16) & 0xff : 0;
+        if (port && port <= 32)
+            busy |= 1 << (port - 1);
+    }
+    return busy;
+}
+
+u32
+xhci_usos_portsc(int c, int port)
+{
+    return readl(&UsosXhci[c]->pr[port].portsc);
+}
+
+// Port reset of root port 'port' (0-based): USB2 ports always get PR, a
+// USB3 port gets PR only when its link did not reach the enabled state by
+// itself (link training). Returns the SeaBIOS speed or -1.
+static int
+xhci_usos_port_reset(struct usb_xhci_s *xhci, u32 port)
+{
+    u32 *reg = &xhci->pr[port].portsc;
+    int usb3 = port + 1 >= xhci->usb3.start
+        && port + 1 < xhci->usb3.start + xhci->usb3.count;
+    u32 end = timer_calc(300), portsc;
+    for (;;) {
+        portsc = readl(reg);
+        if (!(portsc & XHCI_PORTSC_CCS))
+            return -1;
+        if (!usb3 || (portsc & XHCI_PORTSC_PED) || timer_check(end))
+            break;
+        yield();
+    }
+    if (!usb3 || !(portsc & XHCI_PORTSC_PED)) {
+        writel(reg, (portsc & XHCI_PORTSC_PP) | XHCI_PORTSC_PR);
+        end = timer_calc(200);
+        for (;;) {
+            portsc = readl(reg);
+            if (!(portsc & XHCI_PORTSC_CCS) || timer_check(end))
+                return -1;
+            if ((portsc & XHCI_PORTSC_PED) && !(portsc & XHCI_PORTSC_PR))
+                break;
+            yield();
+        }
+    }
+    // clear the change bits of the reset (PRC, WRC, PEC, PLC); CSC stays
+    writel(reg, (portsc & XHCI_PORTSC_PP) | XHCI_PORTSC_PRC | XHCI_PORTSC_WRC
+           | XHCI_PORTSC_PEC | XHCI_PORTSC_PLC);
+    msleep(USB_TIME_RSTRCY);
+    return speed_from_xhci[xhci_get_field(portsc, XHCI_PORTSC_SPEED)];
+}
+
+static void
+xhci_usos_pipe(struct usb_xhci_s *xhci, struct xhci_pipe *pipe, u32 slotid
+               , u8 speed, u8 ep, u8 eptype, u16 maxpacket)
+{
+    memset(pipe, 0, sizeof(*pipe));
+    pipe->pipe.cntl = &xhci->usb;
+    pipe->pipe.type = USB_TYPE_XHCI;
+    pipe->pipe.ep = ep & USB_ENDPOINT_NUMBER_MASK;
+    pipe->pipe.devaddr = 1;   // not 0: the normal transfer time limit
+    pipe->pipe.speed = speed;
+    pipe->pipe.maxpacket = maxpacket;
+    pipe->pipe.eptype = eptype;
+    pipe->slotid = slotid;
+    pipe->epid = eptype == USB_ENDPOINT_XFER_CONTROL
+        ? 1 : (ep & USB_ENDPOINT_NUMBER_MASK) * 2 + ((ep & USB_DIR_IN) ? 1 : 0);
+    pipe->reqs.cs = 1;
+}
+
+// endpoint context of the input context 'in' for 'pipe'
+static void
+xhci_usos_epctx(struct usb_xhci_s *xhci, struct xhci_inctx *in
+                , struct xhci_pipe *pipe)
+{
+    struct xhci_epctx *ep = (void*)&in[(pipe->epid + 1) << xhci->context64];
+    u32 t = pipe->pipe.eptype == USB_ENDPOINT_XFER_CONTROL ? 4
+        : (pipe->epid & 1) ? 6 : 2;   // control, bulk in, bulk out
+    ep->ctx[1] = (t << 3) | (3 << 1) | ((u32)pipe->pipe.maxpacket << 16);
+    ep->deq_low = (u32)&pipe->reqs.ring[0] | 1;
+    ep->length = pipe->pipe.maxpacket;
+}
+
+static void
+xhci_usos_inctx(struct usb_xhci_s *xhci, struct xhci_inctx *in, u32 add
+                , u32 entries, u8 speed, u32 port)
+{
+    memset(in, 0, (sizeof(struct xhci_inctx) * 33) << xhci->context64);
+    in->add = add;
+    struct xhci_slotctx *slot = (void*)&in[1 << xhci->context64];
+    slot->ctx[0] = (entries << 27) | (speed_to_xhci[speed] << 20);
+    slot->ctx[1] = (port + 1) << 16;
+}
+
+// Disable Slot (aborts every queued TD, the controller forgets the
+// device), events processed, the slot's context pointer cleared.
+void
+xhci_usos_teardown(struct usb_pipe *p)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(pipe);
+    u32 slotid = pipe->slotid;
+    if (!slotid || slotid > xhci->slots)
+        return;
+    xhci_cmd_disable_slot(xhci, slotid);
+    xhci_process_events(xhci);
+    xhci->devs[slotid].ptr_low = 0;
+    pipe->slotid = 0;
+}
+
+// Bring up the device on root port 'port' (0-based) of watched controller
+// c to an addressed default control pipe: port reset, Enable Slot,
+// Address Device. m: the device's pool chunk (4 KiB, 4 KiB aligned:
+// output device context at +0, control pipe at +2048, bulk pipes at +2560
+// and +3072); in: the shared input context page. Returns the control
+// pipe, or NULL with *why set (USOS_A_*).
+struct usb_pipe *
+xhci_usos_attach(int c, int port, void *m, void *in, u8 *why)
+{
+    struct usb_xhci_s *xhci = UsosXhci[c];
+    struct xhci_pipe *ctl = m + 2048;
+    *why = USOS_A_RESET;
+    int speed = xhci_usos_port_reset(xhci, port);
+    if (speed < 0)
+        return NULL;
+    *why = USOS_A_SLOT;
+    int slotid = xhci_cmd_enable_slot(xhci);
+    if (slotid <= 0 || slotid > xhci->slots)
+        return NULL;
+    memset(m, 0, 4096);
+    xhci->devs[slotid].ptr_low = (u32)m;
+    xhci->devs[slotid].ptr_high = 0;
+    static const u16 ctlsize[] = { 8, 8, 64, 512 };
+    xhci_usos_pipe(xhci, ctl, slotid, speed, 0, USB_ENDPOINT_XFER_CONTROL
+                   , ctlsize[speed]);
+    xhci_usos_inctx(xhci, in, 0x03, 1, speed, port);
+    xhci_usos_epctx(xhci, in, ctl);
+    *why = USOS_A_ADDRESS;
+    if (xhci_cmd_address_device(xhci, slotid, in) != CC_SUCCESS) {
+        xhci_usos_teardown(&ctl->pipe);
+        return NULL;
+    }
+    return &ctl->pipe;
+}
+
+// A new EP0 packet size (from the device descriptor): Evaluate Context.
+int
+xhci_usos_ctl_mps(struct usb_pipe *p, void *in, u16 maxpacket)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(pipe);
+    if (pipe->pipe.maxpacket == maxpacket)
+        return 0;
+    pipe->pipe.maxpacket = maxpacket;
+    xhci_usos_inctx(xhci, in, 1 << 1, 1, pipe->pipe.speed, 0);
+    struct xhci_epctx *ep = (void*)&((struct xhci_inctx*)in)[2 << xhci->context64];
+    ep->ctx[1] = (u32)maxpacket << 16;
+    return xhci_cmd_evaluate_context(xhci, pipe->slotid, in) == CC_SUCCESS ? 0 : -1;
+}
+
+// The two bulk endpoints of a BOT interface in one Configure Endpoint.
+// Pipes at m + 2560 (in) and m + 3072 (out), see xhci_usos_attach.
+int
+xhci_usos_bulk_eps(struct usb_pipe *p, void *m, void *in
+                   , struct usb_endpoint_descriptor *epin
+                   , struct usb_endpoint_descriptor *epout
+                   , struct usb_pipe **pin, struct usb_pipe **pout)
+{
+    struct xhci_pipe *ctl = container_of(p, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(ctl);
+    struct xhci_pipe *bi = m + 2560, *bo = m + 3072;
+    xhci_usos_pipe(xhci, bi, ctl->slotid, ctl->pipe.speed, epin->bEndpointAddress
+                   , USB_ENDPOINT_XFER_BULK, epin->wMaxPacketSize);
+    xhci_usos_pipe(xhci, bo, ctl->slotid, ctl->pipe.speed, epout->bEndpointAddress
+                   , USB_ENDPOINT_XFER_BULK, epout->wMaxPacketSize);
+    struct xhci_slotctx *dslot = (void*)xhci->devs[ctl->slotid].ptr_low;
+    u32 port = ((dslot->ctx[1] >> 16) & 0xff) - 1;
+    u32 entries = bi->epid > bo->epid ? bi->epid : bo->epid;
+    xhci_usos_inctx(xhci, in, 1 | (1 << bi->epid) | (1 << bo->epid), entries
+                    , ctl->pipe.speed, port);
+    xhci_usos_epctx(xhci, in, bi);
+    xhci_usos_epctx(xhci, in, bo);
+    if (xhci_cmd_configure_endpoint(xhci, ctl->slotid, in) != CC_SUCCESS)
+        return -1;
+    *pin = &bi->pipe;
+    *pout = &bo->pipe;
+    return 0;
+}
