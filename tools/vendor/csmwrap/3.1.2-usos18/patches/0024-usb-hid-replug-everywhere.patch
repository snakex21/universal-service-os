+// USOS patch 0024: the controller of a root HID device is watched on every
+// boot (HID re-attach), not only with the USB disk service pool. Returns 1
+// when the pipe's controller is (now) a watched one.
+int
+xhci_usos_register_hid(struct usb_pipe *p)
+{
+    if (p->type != USB_TYPE_XHCI)
+        return 0;
+    struct usb_xhci_s *xhci = container_of(p->cntl, struct usb_xhci_s, usb);
+    if (!xhci->usos_idx && UsosXhciCount < USOS_X_CTLS) {
+        UsosXhci[UsosXhciCount++] = xhci;
+        xhci->usos_idx = UsosXhciCount;
+    }
+    return xhci->usos_idx != 0;
