+// USOS patch 0024: the HID part of the port watch, from the BIOS timer
+// interrupt (usb_check_event -> call32, so on the helper core, with the OS
+// waiting) while the helper-side watch is not armed: DOS, Windows 3.x,
+// Windows 9x before (or without) USOSUSB.MPD, boot loaders. Only after
+// POST (HaveRunPost 2: no enumeration thread left). Ports with a device
+// slot are BUSY, the rest FREE; a connect on a free port is debounced for
+// one period and then offered to usb_hid_root_attach only.
+void VISIBLE32FLAT
+usos_hid_tick(void)
+{
+    int c, p;
+    if (UdsArmed || HaveRunPost != 2 || !UsosXhciCount)
+        return;
+    if (!UdsWatch.hid_init) {
+        for (c = 0; c < UsosXhciCount && c < USOS_X_CTLS; c++) {
+            u32 ccs, chg;
+            int n = xhci_usos_scan(c, &ccs, &chg);
+            u32 busy = xhci_usos_busy(c);
+            for (p = 0; p < n; p++) {
+                UdsWatch.st[c][p] = (busy & (1 << p)) ? UDS_P_BUSY : UDS_P_FREE;
+                UdsWatch.tries[c][p] = 0;
+            }
+        }
+        UdsWatch.hid_init = 1;
+        UdsWatch.next = timer_calc(UDS_WATCH_MS);
+        return;
+    }
+    if (timer_check(UdsWatch.next)) {
+        uds_watch(0);
+        UdsWatch.next = timer_calc(UDS_WATCH_MS);
+    }
+}
