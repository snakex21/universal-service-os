+
+// Unlike the UDS location helper, do not identify a hub child as its
+// parent's root port. Root HID reconnection must never retire hub slots.
+u32
+xhci_usos_root_where(struct usb_pipe *p)
+{
+    if (p->type != USB_TYPE_XHCI)
+        return 0;
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(pipe);
+    if (!pipe->slotid || pipe->slotid > xhci->slots)
+        return 0;
+    struct xhci_slotctx *slot = (void*)xhci->devs[pipe->slotid].ptr_low;
+    if (!slot || (slot->ctx[0] & 0xfffff))
+        return 0;
+    return xhci_usos_where(p);
+}
+
+void
+xhci_usos_hid_forget(struct usb_pipe *p)
+{
+    struct xhci_pipe *pipe = container_of(p, struct xhci_pipe, pipe);
+    pipe->slotid = 0;
+    pipe->bufused = 0;
 }
 
