+
+// Reconnect only root devices which had working HID interfaces at POST.
+// Their F-segment list nodes, low-memory interrupt rings, report layouts
+// and DMA buffers remain in place. One 4-KiB control/context page per
+// physical device is reserved at POST, never allocated by the helper.
+#define ROOT_HIDS 4
+struct root_hid_if {
+    struct usb_pipe *pipe;
+    u8 iface, proto, report;
+};
+struct root_hid {
+    void *mem;
+    u32 config_hash;
+    u16 vid, pid, revision;
+    u8 ctl, port, n, online;
+    struct root_hid_if ifs[2];
+};
+struct root_hid RootHids[ROOT_HIDS] VARFSEG;
+u8 RootHidCount VARFSEG;
+
+static u32
+root_config_hash(void *buf, u16 len)
+{
+    u8 *p = buf;
+    u32 h = 2166136261U;
+    while (len--)
+        h = (h ^ *p++) * 16777619U;
+    return h;
+}
+
+static struct root_hid *
+root_find(int ctl, int port)
+{
+    int i;
+    for (i = 0; i < RootHidCount; i++)
+        if (RootHids[i].ctl == ctl && RootHids[i].port == port)
+            return &RootHids[i];
+    return NULL;
+}
+
+static int
+root_get_desc(struct usb_pipe *ctl, u16 value, u16 len, void *buf)
+{
+    struct usb_ctrlrequest req = {
+        .bRequestType = USB_DIR_IN, .bRequest = USB_REQ_GET_DESCRIPTOR,
+        .wValue = value, .wLength = len,
+    };
+    return usb_send_default_control(ctl, &req, buf);
+}
+
+static void
+usb_root_remember(struct usbdevice_s *dev, struct usb_pipe *pipe, u8 report)
+{
+    if (!usos_uds_pool() || dev->hub->usbdev)
+        return;
+    u32 where = xhci_usos_root_where(pipe);
+    u8 c = where ? xhci_usos_ctl(pipe) : 0xff;
+    u8 port = where & 0xff;
+    u16 total = dev->config->wTotalLength;
+    if (c == 0xff || !port || total > 512)
+        return;
+    struct root_hid *h = root_find(c, port);
+    if (!h) {
+        if (RootHidCount == ROOT_HIDS)
+            return;
+        struct usb_device_descriptor dd;
+        if (root_get_desc(dev->defpipe, USB_DT_DEVICE << 8, sizeof(dd), &dd)) {
+            xhci_usos_reset_ep(dev->defpipe);
+            return;
+        }
+        void *mem = memalign_high(4096, 4096);
+        if (!mem)
+            return;
+        h = &RootHids[RootHidCount++];
+        h->mem = mem;
+        h->ctl = c;
+        h->port = port;
+        h->vid = dd.idVendor;
+        h->pid = dd.idProduct;
+        h->revision = dd.bcdDevice;
+        h->config_hash = root_config_hash(dev->config, total);
+        h->online = 1;
+    }
+    if (h->n == ARRAY_SIZE(h->ifs))
+        return;
+    struct root_hid_if *f = &h->ifs[h->n++];
+    f->pipe = pipe;
+    f->iface = dev->iface->bInterfaceNumber;
+    f->proto = dev->iface->bInterfaceProtocol;
+    f->report = report;
+}
+
+int
+usb_hid_root_detach(int c, int port)
+{
+    struct root_hid *h = root_find(c, port);
+    if (!h)
+        return 0;
+    if (!h->online)
+        return 1;
+    // Disable once per physical device, not once per interface. This
+    // drains completion events before any ring or slot is reused.
+    xhci_usos_teardown(h->ifs[0].pipe);
+    int i;
+    for (i = 0; i < h->n; i++) {
+        xhci_usos_hid_forget(h->ifs[i].pipe);
+        if (h->ifs[i].proto == USB_INTERFACE_PROTOCOL_KEYBOARD)
+            RootKeyRelease = 1;
+        else if (h->ifs[i].proto == USB_INTERFACE_PROTOCOL_MOUSE)
+            RootMouseRelease = 1;
+    }
+    h->online = 0;
+    return 1;
+}
+
+int
+usb_hid_root_attach(int c, int port)
+{
+    struct root_hid *h = root_find(c, port);
+    if (!h || h->online)
+        return -1;
+    void *in = usos_uds_pool();
+    u8 why, *buf = h->mem + 3584;
+    struct usb_pipe *ctl = xhci_usos_attach(c, port - 1, h->mem, in, &why);
+    if (!ctl)
+        return -1;
+    struct usb_device_descriptor *dd = (void*)buf;
+    if (root_get_desc(ctl, USB_DT_DEVICE << 8, 8, buf))
+        goto fail;
+    u16 mps = dd->bcdUSB >= 0x0300 ? 1 << (dd->bMaxPacketSize0 & 15) : dd->bMaxPacketSize0;
+    if (mps < 8 || mps > 512 || xhci_usos_ctl_mps(ctl, in, mps)
+        || root_get_desc(ctl, USB_DT_DEVICE << 8, 18, buf))
+        goto fail;
+    if (dd->idVendor != h->vid || dd->idProduct != h->pid || dd->bcdDevice != h->revision)
+        goto fail;
+    struct usb_config_descriptor *cfg = (void*)buf;
+    if (root_get_desc(ctl, USB_DT_CONFIG << 8, 9, buf))
+        goto fail;
+    u16 total = cfg->wTotalLength;
+    if (cfg->bLength < 9 || total < cfg->bLength || total > 512
+        || root_get_desc(ctl, USB_DT_CONFIG << 8, total, buf)
+        || root_config_hash(buf, total) != h->config_hash)
+        goto fail;
+    struct usb_endpoint_descriptor eps[2];
+    memset(eps, 0, sizeof(eps));
+    u8 *p = buf + cfg->bLength, *end = buf + total;
+    int selected = -1, i;
+    for (; p + 2 <= end && p[0] >= 2 && p + p[0] <= end; p += p[0]) {
+        if (p[1] == USB_DT_INTERFACE && p[0] >= sizeof(struct usb_interface_descriptor)) {
+            struct usb_interface_descriptor *f = (void*)p;
+            selected = -1;
+            if (f->bInterfaceClass != USB_CLASS_HID
+                || f->bInterfaceSubClass != USB_INTERFACE_SUBCLASS_BOOT || f->bAlternateSetting)
+                continue;
+            for (i = 0; i < h->n; i++)
+                if (f->bInterfaceNumber == h->ifs[i].iface && f->bInterfaceProtocol == h->ifs[i].proto)
+                    selected = i;
+        } else if (selected >= 0 && p[1] == USB_DT_ENDPOINT && p[0] >= 7
+                   && (p[2] & USB_DIR_IN) && (p[3] & USB_ENDPOINT_XFERTYPE_MASK) == USB_ENDPOINT_XFER_INT
+                   && !eps[selected].bLength) {
+            memcpy(&eps[selected], p, sizeof(eps[selected]));
+        }
+    }
+    for (i = 0; i < h->n; i++)
+        if (!eps[i].bLength || !eps[i].bInterval || eps[i].wMaxPacketSize != h->ifs[i].pipe->maxpacket)
+            goto fail;
+    struct usb_ctrlrequest req = {
+        .bRequestType = USB_DIR_OUT | USB_TYPE_STANDARD | USB_RECIP_DEVICE,
+        .bRequest = USB_REQ_SET_CONFIGURATION, .wValue = cfg->bConfigurationValue,
+    };
+    if (usb_send_default_control(ctl, &req, NULL))
+        goto fail;
+    for (i = 0; i < h->n; i++) {
+        struct root_hid_if *f = &h->ifs[i];
+        if (set_protocol(ctl, f->report, f->iface))
+            goto fail;
+        if (f->proto == USB_INTERFACE_PROTOCOL_KEYBOARD) {
+            req.bRequestType = USB_DIR_OUT | USB_TYPE_CLASS | USB_RECIP_INTERFACE;
+            req.bRequest = HID_REQ_SET_IDLE;
+            req.wValue = (33 / 4) << 8;
+            req.wIndex = f->iface;
+            if (usb_send_default_control(ctl, &req, NULL))
+                xhci_usos_reset_ep(ctl);
+        }
+        if (xhci_usos_hid_ep(ctl, in, f->pipe, &eps[i]))
+            goto fail;
+    }
+    h->online = 1;
+    return 0;
+fail:
+    xhci_usos_teardown(ctl);
+    for (i = 0; i < h->n; i++)
+        xhci_usos_hid_forget(h->ifs[i].pipe);
+    return -1;
 }
 
