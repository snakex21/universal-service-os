+
+// Re-use a POST interrupt ring and buffer only after its original slot
+// has been disabled and drained. No allocation at runtime.
+int
+xhci_usos_hid_ep(struct usb_pipe *p, void *in, struct usb_pipe *ip,
+                  struct usb_endpoint_descriptor *ed)
+{
+    struct xhci_pipe *ctl = container_of(p, struct xhci_pipe, pipe);
+    struct xhci_pipe *pipe = container_of(ip, struct xhci_pipe, pipe);
+    struct usb_xhci_s *xhci = xhci_usos_cntl(ctl);
+    if (pipe->slotid || ip->maxpacket != ed->wMaxPacketSize)
+        return -1;
+    void *buf = pipe->buf;
+    xhci_usos_pipe(xhci, pipe, ctl->slotid, p->speed, ed->bEndpointAddress,
+                   USB_ENDPOINT_XFER_INT, ed->wMaxPacketSize);
+    pipe->buf = buf;
+    memset(buf, 0, ip->maxpacket);
+    struct xhci_slotctx *slot = (void*)xhci->devs[ctl->slotid].ptr_low;
+    u32 port = ((slot->ctx[1] >> 16) & 0xff) - 1;
+    u32 entries = slot->ctx[0] >> 27;
+    if (entries < pipe->epid)
+        entries = pipe->epid;
+    xhci_usos_inctx(xhci, in, 1 | (1 << pipe->epid), entries, p->speed, port);
+    xhci_usos_epctx(xhci, in, pipe);
+    struct xhci_epctx *ep = (void*)&((struct xhci_inctx*)in)[(pipe->epid + 1) << xhci->context64];
+    struct usbdevice_s dev = { .speed = p->speed };
+    ep->ctx[0] = (usb_get_period(&dev, ed) + 3) << 16;
+    ep->ctx[1] = (ep->ctx[1] & ~(7 << 3)) | (7 << 3); // interrupt IN
+    if (xhci_cmd_configure_endpoint(xhci, ctl->slotid, in) != CC_SUCCESS) {
+        xhci_usos_hid_forget(ip);
+        return -1;
+    }
+    return 0;
+}
