diff --git a/src/xhci_usos.c b/src/xhci_usos.c
index 390cbdf..86b13c5 100644
--- a/src/xhci_usos.c
+++ b/src/xhci_usos.c
@@ -168,6 +168,53 @@ ULONG XhciUsosPciPrepare(PXHCI_EXTENSION ext)
     return (ULONG)command;
 }
 
+/*
+ * usos2: every extended capability header, and for each Supported Protocol
+ * capability its DWORDs 0, 2 and 3 (revision, port range + PSI count, slot
+ * type), recorded before the parser can refuse the chain. Bounded like the
+ * parser: inside the mapping, all-ones ends the walk, at most 64 entries.
+ * IRQL: <= DISPATCH_LEVEL (BAR reads and log notes only).
+ */
+VOID XhciUsosLogCapChain(PXHCI_EXTENSION ext)
+{
+    ULONG offset;
+    ULONG header;
+    ULONG next;
+    ULONG seen;
+    ULONG protocols;
+
+    if (ext == NULL || ext->HcInfo.XecpDwords == 0) {
+        XhciLogNote(ext, "usos.xecp.none", 0);
+        return;
+    }
+    offset = ext->HcInfo.XecpDwords * 4UL;
+    protocols = 0;
+    for (seen = 0; seen < 64; seen++) {
+        if (offset > ext->IoSpaceLength || ext->IoSpaceLength - offset < 16) {
+            XhciLogNote(ext, "usos.xecp.outside", offset);
+            break;
+        }
+        header = XhciBarReader(ext, offset);
+        if (header == 0xFFFFFFFFUL) {
+            XhciLogNote(ext, "usos.xecp.allones", offset);
+            break;
+        }
+        XhciLogNote(ext, "usos.xecp.at", offset);
+        XhciLogNote(ext, "usos.xecp.dw0", header);
+        if ((header & 0xFFUL) == XHCI_XECP_ID_PROTOCOL) {
+            protocols++;
+            XhciLogNote(ext, "usos.proto.dw2", XhciBarReader(ext, offset + 8));
+            XhciLogNote(ext, "usos.proto.dw3", XhciBarReader(ext, offset + 12));
+        }
+        next = (header >> 8) & 0xFFUL;
+        if (next == 0) {
+            break;
+        }
+        offset += next * 4UL;
+    }
+    XhciLogNote(ext, "usos.xecp.protocols", protocols);
+}
+
