diff --git a/src/xhci_usos.c b/src/xhci_usos.c
new file mode 100644
index 0000000..390cbdf
--- /dev/null
+++ b/src/xhci_usos.c
@@ -0,0 +1,467 @@
+/*
+ * xhci_usos.c - USOS additions to xhci98 1.1.1.0 (1.1.1.0-usos1).
+ *
+ * MODIFIED FILE NOTICE (GPL-2.0 section 2a): this file is not part of the
+ * upstream xhci98 source (https://github.com/yeokm1/xhci98, tag v1.1.1.0,
+ * commit 7d0dd9d440e9716a87e0882f905bf8e99fa443ac). It was added by the
+ * Universal Service OS (USOS) project on 2026-09-29 and is distributed under
+ * the same licence as the rest of xhci98, GPL-2.0-only.
+ *
+ * Two things live here, and both exist for the NT 5.x targets USOS stages
+ * xhci98 on (Windows Server 2003 x86 and XP x64 / Server 2003 x64). Neither
+ * is meant for, or tested on, Windows 98/ME.
+ *
+ * 1. XhciUsosPciPrepare - bring a controller that the platform firmware shut
+ *    down at ExitBootServices back to a state the init sequence can use:
+ *    PCI power state D0 (restoring the BARs if the D3hot -> D0 transition
+ *    reset them), Memory Space Enable and Bus Master Enable. Upstream refuses
+ *    a controller whose BME it did not clear itself; an AMD CPU xHCI
+ *    (1022:149C) on an X470 board arrives at NT with no boot configuration at
+ *    all (decoding and mastering off), and NT 5.x PCI.SYS assigns the BAR and
+ *    enables decoding but does not set Bus Master Enable. Linux does the same
+ *    thing here through pci_enable_device() + pci_set_master().
+ *
+ * 2. A file sink for the log ring: every flush (start refusal, successful
+ *    start, stop) is appended to %SystemRoot%\xhci98.log by a system thread
+ *    that retries until the boot volume is reachable, so a start that fails
+ *    while xhci98 is a boot driver (before \SystemRoot resolves) still lands
+ *    in the file a few seconds later. The file is plain ASCII and can be read
+ *    from another machine with the disk attached.
+ *
+ * C89. IRQL requirements are stated per function.
+ */
+
+#include "xhci.h"
+#include "xhci_usbport.h"
+#include "xhci_hw.h"
+#include "xhci_dbg.h"
+#include "xhci_version.h"
+
+#ifndef XHCI_HOST_TEST
+
+/* ------------------------------------------------------------------ */
+/* PCI power state and command enables                                 */
+/* ------------------------------------------------------------------ */
+
+#define USOS_PCI_STATUS          0x06UL
+#define USOS_PCI_STATUS_CAPLIST  0x0010U
+#define USOS_PCI_CAP_PTR         0x34UL
+#define USOS_PCI_CAP_ID_PM       0x01
+#define USOS_PCI_BAR0            0x10UL
+#define USOS_PCI_BAR_COUNT       6UL
+#define USOS_PCI_COMMAND_MSE     0x0002U
+#define USOS_PMCSR_STATE_MASK    0x0003U
+#define USOS_PMCSR_PME_STATUS    0x8000U   /* RW1C - never written as 1 */
+
+static ULONG usosFindPmCap(PXHCI_EXTENSION ext)
+{
+    USHORT status;
+    UCHAR ptr;
+    UCHAR id;
+    ULONG guard;
+
+    status = 0;
+    if (XhciReadPciConfig(ext, USOS_PCI_STATUS, &status, sizeof(status)) !=
+            MP_STATUS_SUCCESS ||
+        status == 0xFFFFU || (status & USOS_PCI_STATUS_CAPLIST) == 0) {
+        return 0;
+    }
+    ptr = 0;
+    if (XhciReadPciConfig(ext, USOS_PCI_CAP_PTR, &ptr, sizeof(ptr)) !=
+        MP_STATUS_SUCCESS) {
+        return 0;
+    }
+    for (guard = 0; guard < 48 && ptr >= 0x40; guard++) {
+        ptr = (UCHAR)(ptr & 0xFC);
+        id = 0;
+        if (XhciReadPciConfig(ext, (ULONG)ptr, &id, sizeof(id)) !=
+            MP_STATUS_SUCCESS) {
+            return 0;
+        }
+        if (id == USOS_PCI_CAP_ID_PM) {
+            return (ULONG)ptr;
+        }
+        if (XhciReadPciConfig(ext, (ULONG)ptr + 1UL, &ptr, sizeof(ptr)) !=
+            MP_STATUS_SUCCESS) {
+            return 0;
+        }
+    }
+    return 0;
+}
+
+/*
+ * IRQL: PASSIVE_LEVEL (config-space service, UsbPortWait). Never fails the
+ * start by itself: everything it could not fix is left for the upstream gates
+ * that follow (bus-master gate, capability sanity) to refuse with their own
+ * step number. Returns the PCI command register as it is on exit.
+ */
+ULONG XhciUsosPciPrepare(PXHCI_EXTENSION ext)
+{
+    USHORT command;
+    USHORT wanted;
+    USHORT pmcsr;
+    ULONG pm;
+    ULONG bars[USOS_PCI_BAR_COUNT];
+    ULONG check;
+    ULONG i;
+
+    command = 0;
+    if (XhciReadPciConfig(ext, XHCI_PCI_COMMAND, &command, sizeof(command)) !=
+        MP_STATUS_SUCCESS) {
+        XhciLogNote(ext, "usos.pci.command.unreadable", 1);
+        return 0xFFFFFFFFUL;
+    }
+    XhciLogNote(ext, "usos.pci.command.before", command);
+    if (command == 0xFFFFU) {
+        return 0xFFFFUL;
+    }
+
+    /* Power state first: a function in D3hot answers config space but not
+     * its BAR, and writing D0 can reset the BARs (No_Soft_Reset = 0). */
+    pm = usosFindPmCap(ext);
+    XhciLogNote(ext, "usos.pci.pmcap", pm);
+    if (pm != 0) {
+        pmcsr = 0;
+        if (XhciReadPciConfig(ext, pm + 4UL, &pmcsr, sizeof(pmcsr)) ==
+            MP_STATUS_SUCCESS) {
+            XhciLogNote(ext, "usos.pci.pmcsr.before", pmcsr);
+            if ((pmcsr & USOS_PMCSR_STATE_MASK) != 0 && pmcsr != 0xFFFFU) {
+                for (i = 0; i < USOS_PCI_BAR_COUNT; i++) {
+                    bars[i] = 0;
+                    (VOID)XhciReadPciConfig(ext, USOS_PCI_BAR0 + i * 4UL,
+                                            &bars[i], sizeof(ULONG));
+                }
+                pmcsr = (USHORT)(pmcsr & ~(USOS_PMCSR_STATE_MASK |
+                                           USOS_PMCSR_PME_STATUS));
+                (VOID)XhciWritePciConfig(ext, pm + 4UL, &pmcsr, sizeof(pmcsr));
+                /* D3hot -> D0 recovery time, PCI PM 1.2 section 5.6.1. */
+                XhciDelayMs(ext, 20);
+                check = 0;
+                (VOID)XhciReadPciConfig(ext, USOS_PCI_BAR0, &check,
+                                        sizeof(ULONG));
+                if (check != bars[0]) {
+                    XhciLogNote(ext, "usos.pci.bars.restored", check);
+                    for (i = 0; i < USOS_PCI_BAR_COUNT; i++) {
+                        (VOID)XhciWritePciConfig(ext, USOS_PCI_BAR0 + i * 4UL,
+                                                 &bars[i], sizeof(ULONG));
+                    }
+                }
+                (VOID)XhciWritePciConfig(ext, XHCI_PCI_COMMAND, &command,
+                                         sizeof(command));
+                pmcsr = 0;
+                (VOID)XhciReadPciConfig(ext, pm + 4UL, &pmcsr, sizeof(pmcsr));
+                XhciLogNote(ext, "usos.pci.pmcsr.after", pmcsr);
+            }
+        }
+    }
+
+    wanted = (USHORT)(command | USOS_PCI_COMMAND_MSE | XHCI_PCI_COMMAND_BME);
+    if (wanted != command) {
+        (VOID)XhciWritePciConfig(ext, XHCI_PCI_COMMAND, &wanted,
+                                 sizeof(wanted));
+        command = 0;
+        (VOID)XhciReadPciConfig(ext, XHCI_PCI_COMMAND, &command,
+                                sizeof(command));
+        XhciLogNote(ext, "usos.pci.command.enabled", command);
+        XHCI_DBG_VALUE("usos: PCI command enables set, now", command);
+    }
+    return (ULONG)command;
+}
+
+/* ------------------------------------------------------------------ */
+/* The file sink                                                       */
+/* ------------------------------------------------------------------ */
+
+#define USOS_PEND_BYTES     65536UL
+#define USOS_WRITE_CHUNK    4096UL
+#define USOS_RETRY_MS       2000L
+#define USOS_RETRY_LIMIT    450UL      /* 15 minutes of 2 s retries */
+#define USOS_IDLE_MS        30000L
+
+static UCHAR usosPend[USOS_PEND_BYTES];
+static ULONG usosPendLen;
+static ULONG usosPendDropped;
+static UCHAR usosStage[USOS_WRITE_CHUNK];
+static KSPIN_LOCK usosLock;
+static KEVENT usosWake;
+static ULONG usosInited;
+static ULONG usosRunning;
+static volatile LONG usosStop;
+static PVOID usosThreadObject;
+static PDRIVER_UNLOAD usosChainedUnload;
+
+static NTSTATUS usosOpen(PHANDLE handle)
+{
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attributes;
+    IO_STATUS_BLOCK iosb;
+
+    RtlInitUnicodeString(&name, L"\\SystemRoot\\xhci98.log");
+    InitializeObjectAttributes(&attributes, &name,
+                               OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE,
+                               NULL, NULL);
+    return ZwCreateFile(handle, FILE_APPEND_DATA | SYNCHRONIZE, &attributes,
+                        &iosb, NULL, FILE_ATTRIBUTE_NORMAL, FILE_SHARE_READ,
+                        FILE_OPEN_IF,
+                        FILE_SYNCHRONOUS_IO_NONALERT | FILE_WRITE_THROUGH |
+                            FILE_NON_DIRECTORY_FILE,
+                        NULL, 0);
+}
+
+static VOID usosWait(LONG milliseconds)
+{
+    LARGE_INTEGER timeout;
+
+    timeout.QuadPart = (LONGLONG)milliseconds * (LONGLONG)(-10000);
+    (VOID)KeWaitForSingleObject(&usosWake, Executive, KernelMode, FALSE,
+                                &timeout);
+}
+
+static VOID NTAPI usosWriter(PVOID context)
+{
+    HANDLE file;
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status;
+    KIRQL irql;
+    ULONG n;
+    ULONG i;
+    ULONG failures;
+
+    UNREFERENCED_PARAMETER(context);
+    failures = 0;
+
+    for (;;) {
+        KeAcquireSpinLock(&usosLock, &irql);
+        n = usosPendLen;
+        if (n == 0 || usosStop || failures > USOS_RETRY_LIMIT) {
+            usosRunning = 0;
+            KeReleaseSpinLock(&usosLock, irql);
+            break;
+        }
+        KeReleaseSpinLock(&usosLock, irql);
+
+        status = usosOpen(&file);
+        if (!NT_SUCCESS(status)) {
+            /* \SystemRoot does not resolve yet (boot-driver start), or the
+             * volume is not writable yet. Try again shortly. */
+            failures++;
+            usosWait(USOS_RETRY_MS);
+            continue;
+        }
+        failures = 0;
+
+        for (;;) {
+            KeAcquireSpinLock(&usosLock, &irql);
+            n = usosPendLen;
+            if (n > USOS_WRITE_CHUNK) {
+                n = USOS_WRITE_CHUNK;
+            }
+            for (i = 0; i < n; i++) {
+                usosStage[i] = usosPend[i];
+            }
+            KeReleaseSpinLock(&usosLock, irql);
+            if (n == 0) {
+                break;
+            }
+            status = ZwWriteFile(file, NULL, NULL, NULL, &iosb, usosStage, n,
+                                 NULL, NULL);
+            if (!NT_SUCCESS(status)) {
+                failures++;
+                break;
+            }
+            KeAcquireSpinLock(&usosLock, &irql);
+            for (i = n; i < usosPendLen; i++) {
+                usosPend[i - n] = usosPend[i];
+            }
+            usosPendLen -= n;
+            KeReleaseSpinLock(&usosLock, irql);
+        }
+        ZwClose(file);
+        if (failures != 0) {
+            usosWait(USOS_RETRY_MS);
+            continue;
+        }
+        /* Linger a little so a burst of flushes (two controllers starting
+         * back to back) shares one thread. */
+        usosWait(USOS_IDLE_MS);
+    }
+    PsTerminateSystemThread(STATUS_SUCCESS);
+}
+
+/*
+ * The unload wrapper. usbport installs its own DriverUnload at registration
+ * (or none); if one exists, the writer thread must be gone before the image
+ * is. IRQL: PASSIVE_LEVEL.
+ */
+static VOID NTAPI usosUnload(PDRIVER_OBJECT driverObject)
+{
+    InterlockedExchange((PLONG)&usosStop, 1);
+    KeSetEvent(&usosWake, IO_NO_INCREMENT, FALSE);
+    if (usosThreadObject != NULL) {
+        (VOID)KeWaitForSingleObject(usosThreadObject, Executive, KernelMode,
+                                    FALSE, NULL);
+        ObDereferenceObject(usosThreadObject);
+        usosThreadObject = NULL;
+    }
+    if (usosChainedUnload != NULL) {
+        usosChainedUnload(driverObject);
+    }
+}
+
+/* DriverEntry, after registration. IRQL: PASSIVE_LEVEL. */
+VOID XhciUsosInit(PDRIVER_OBJECT driverObject)
+{
+    KeInitializeSpinLock(&usosLock);
+    KeInitializeEvent(&usosWake, SynchronizationEvent, FALSE);
+    usosPendLen = 0;
+    usosPendDropped = 0;
+    usosRunning = 0;
+    usosStop = 0;
+    usosThreadObject = NULL;
+    usosInited = 1;
+    if (driverObject != NULL && driverObject->DriverUnload != NULL) {
+        usosChainedUnload = driverObject->DriverUnload;
+        driverObject->DriverUnload = usosUnload;
+    }
+}
+
+/* Queue bytes for the file. IRQL: <= DISPATCH_LEVEL. */
+VOID XhciUsosFileAppend(const UCHAR *bytes, ULONG count)
+{
+    KIRQL irql;
+    ULONG i;
+
+    if (!usosInited || bytes == NULL) {
+        return;
+    }
+    KeAcquireSpinLock(&usosLock, &irql);
+    for (i = 0; i < count; i++) {
+        if (usosPendLen >= USOS_PEND_BYTES) {
+            usosPendDropped += count - i;
+            break;
+        }
+        usosPend[usosPendLen++] = bytes[i];
+    }
+    KeReleaseSpinLock(&usosLock, irql);
+}
+
+VOID XhciUsosFileAppendText(const char *text)
+{
+    ULONG n;
+
+    if (text == NULL) {
+        return;
+    }
+    for (n = 0; text[n] != '\0'; n++) {
+    }
+    XhciUsosFileAppend((const UCHAR *)text, n);
+}
+
+static char *usosHex(char *out, ULONG value)
+{
+    static const char digits[] = "0123456789ABCDEF";
+    int shift;
+
+    for (shift = 28; shift >= 0; shift -= 4) {
+        *out++ = digits[(value >> shift) & 0xF];
+    }
+    return out;
+}
+
+static char *usosCopy(char *out, const char *text)
+{
+    while (*text != '\0') {
+        *out++ = *text++;
+    }
+    return out;
+}
+
+/* One header line per flush. IRQL: <= DISPATCH_LEVEL. */
+VOID XhciUsosFileHeader(PXHCI_EXTENSION ext, ULONG reason)
+{
+    char line[160];
+    char *p;
+    LARGE_INTEGER ticks;
+
+    KeQueryTickCount(&ticks);
+    p = line;
+    p = usosCopy(p, "=== xhci98 " XHCI_VER_STR " flush reason=");
+    p = usosHex(p, reason);
+    p = usosCopy(p, " pci=");
+    p = usosHex(p, ext != NULL ? ext->PciVendorDevice : 0);
+    p = usosCopy(p, " step=");
+    p = usosHex(p, ext != NULL ? ext->InitStep : 0);
+    p = usosCopy(p, " status=");
+    p = usosHex(p, ext != NULL ? ext->InitStatus : 0);
+    p = usosCopy(p, " tick=");
+    p = usosHex(p, ticks.LowPart);
+    p = usosCopy(p, " dropped=");
+    p = usosHex(p, usosPendDropped);
+    p = usosCopy(p, " ===\r\n");
+    *p = '\0';
+    XhciUsosFileAppendText(line);
+}
+
+/*
+ * Make sure a writer is running. IRQL: PASSIVE_LEVEL (PsCreateSystemThread);
+ * a call above it only leaves the bytes queued for the next PASSIVE kick.
+ */
+VOID XhciUsosFileKick(VOID)
+{
+    KIRQL irql;
+    ULONG start;
+    HANDLE thread;
+    NTSTATUS status;
+    PVOID object;
+
+    if (!usosInited || KeGetCurrentIrql() != PASSIVE_LEVEL || usosStop) {
+        return;
+    }
+    KeAcquireSpinLock(&usosLock, &irql);
+    start = (usosRunning == 0) ? 1UL : 0UL;
+    if (start) {
+        usosRunning = 1;
+    }
+    KeReleaseSpinLock(&usosLock, irql);
+
+    if (!start) {
+        KeSetEvent(&usosWake, IO_NO_INCREMENT, FALSE);
+        return;
+    }
+
+    /* The previous writer has cleared usosRunning and is on its way out. */
+    if (usosThreadObject != NULL) {
+        (VOID)KeWaitForSingleObject(usosThreadObject, Executive, KernelMode,
+                                    FALSE, NULL);
+        ObDereferenceObject(usosThreadObject);
+        usosThreadObject = NULL;
+    }
+
+    status = PsCreateSystemThread(&thread, THREAD_ALL_ACCESS, NULL, NULL,
+                                  NULL, usosWriter, NULL);
+    if (!NT_SUCCESS(status)) {
+        KeAcquireSpinLock(&usosLock, &irql);
+        usosRunning = 0;
+        KeReleaseSpinLock(&usosLock, irql);
+        return;
+    }
+    object = NULL;
+    if (NT_SUCCESS(ObReferenceObjectByHandle(thread, THREAD_ALL_ACCESS, NULL,
+                                             KernelMode, &object, NULL))) {
+        usosThreadObject = object;
+    }
+    ZwClose(thread);
+}
+
+#else /* XHCI_HOST_TEST */
+
+/* The host suite has no PCI, no file system and no threads. */
+ULONG XhciUsosPciPrepare(PXHCI_EXTENSION ext) { (void)ext; return 0; }
+VOID XhciUsosFileAppend(const UCHAR *bytes, ULONG count)
+{ (void)bytes; (void)count; }
+VOID XhciUsosFileAppendText(const char *text) { (void)text; }
+VOID XhciUsosFileHeader(PXHCI_EXTENSION ext, ULONG reason)
+{ (void)ext; (void)reason; }
+VOID XhciUsosFileKick(VOID) { }
+
+#endif /* XHCI_HOST_TEST */
