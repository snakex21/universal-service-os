     ZwClose(thread);
 }
 
+/* ------------------------------------------------------------------ */
+/* The polling engine (usos3)                                          */
+/* ------------------------------------------------------------------ */
+
+#define USOS_POLL_PERIOD_MS     4L      /* rounded up to the clock tick */
+#define USOS_POLL_STALL_TICKS   3UL
+#define USOS_POLL_UNANSWERED    8UL
+
+ULONG XhciUsosPollMode;
+
+/* DriverEntry, before registration. IRQL: PASSIVE_LEVEL. */
+VOID XhciUsosReadPollMode(PUNICODE_STRING registryPath)
+{
+    WCHAR buffer[200];
+    UNICODE_STRING path;
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attributes;
+    HANDLE key;
+    UCHAR info[sizeof(KEY_VALUE_PARTIAL_INFORMATION) + sizeof(ULONG)];
+    PKEY_VALUE_PARTIAL_INFORMATION value;
+    ULONG length;
+
+    XhciUsosPollMode = 0;
+    if (registryPath == NULL || registryPath->Buffer == NULL) {
+        return;
+    }
+    path.Buffer = buffer;
+    path.Length = 0;
+    path.MaximumLength = sizeof(buffer);
+    if (!NT_SUCCESS(RtlAppendUnicodeStringToString(&path, registryPath)) ||
+        !NT_SUCCESS(RtlAppendUnicodeToString(&path, L"\\Parameters"))) {
+        return;
+    }
+    InitializeObjectAttributes(&attributes, &path,
+                               OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE,
+                               NULL, NULL);
+    if (!NT_SUCCESS(ZwOpenKey(&key, KEY_READ, &attributes))) {
+        return;
+    }
+    RtlInitUnicodeString(&name, L"PollMode");
+    value = (PKEY_VALUE_PARTIAL_INFORMATION)info;
+    if (NT_SUCCESS(ZwQueryValueKey(key, &name, KeyValuePartialInformation,
+                                   info, sizeof(info), &length)) &&
+        value->Type == REG_DWORD && value->DataLength == sizeof(ULONG) &&
+        *(PULONG)value->Data == 1) {
+        XhciUsosPollMode = 1;
+    }
+    ZwClose(key);
+}
+
+/* IRQL: DISPATCH_LEVEL (timer DPC). */
+static VOID NTAPI usosPollDpc(PKDPC dpc, PVOID context, PVOID arg1, PVOID arg2)
+{
+    PXHCI_EXTENSION ext;
+    ULONG fire;
+    ULONG claims;
+
+    UNREFERENCED_PARAMETER(dpc);
+    UNREFERENCED_PARAMETER(arg1);
+    UNREFERENCED_PARAMETER(arg2);
+
+    ext = (PXHCI_EXTENSION)context;
+    if (ext == NULL || ext->Signature != XHCI_EXTENSION_SIGNATURE) {
+        return;
+    }
+    InterlockedIncrement(&ext->UsosPollInDpc);
+    if (ext->UsosPollState != 1 || ext->ControllerFailed ||
+        (ext->Flags & XHCI_EXT_FLAG_STARTED) == 0 ||
+        (ext->Flags & XHCI_EXT_FLAG_INITIALIZED) == 0) {
+        InterlockedDecrement(&ext->UsosPollInDpc);
+        return;
+    }
+    ext->UsosPollTicks++;
+    fire = 0;
+    if (XhciUsosPollMode) {
+        fire = 1;
+    } else {
+        claims = ext->InterruptsClaimed;
+        if (XhciEventRingPending(&ext->EventRing) &&
+            claims == ext->UsosLastClaims) {
+            ext->UsosStallTicks++;
+            if (ext->UsosStallTicks >= USOS_POLL_STALL_TICKS) {
+                ext->UsosStallTicks = 0;
+                ext->UsosRescues++;
+                fire = 1;
+            }
+        } else {
+            ext->UsosStallTicks = 0;
+        }
+        ext->UsosLastClaims = claims;
+    }
+    if (fire) {
+        /* Was the previous soft interrupt answered with an InterruptDpc? */
+        if (ext->UsosSoftInts != 0 && ext->DpcCount == ext->UsosLastDpcCount) {
+            ext->UsosUnanswered++;
+        } else {
+            ext->UsosUnanswered = 0;
+        }
+        if (ext->UsosUnanswered >= USOS_POLL_UNANSWERED ||
+            XhciRegPacket.UsbPortInvalidateController == NULL) {
+            ext->UsosDirectDpcs++;
+            (VOID)XhciUsosRunInterruptDpc(ext);
+        } else {
+            ext->UsosSoftInts++;
+            (VOID)XhciRegPacket.UsbPortInvalidateController(
+                ext, USBPORT_INVALIDATE_CONTROLLER_SOFT_INTERRUPT);
+        }
+        ext->UsosLastDpcCount = ext->DpcCount;
+    }
+    InterlockedDecrement(&ext->UsosPollInDpc);
+}
+
+/* After a successful start. IRQL: PASSIVE_LEVEL. */
+VOID XhciUsosPollStart(PXHCI_EXTENSION ext)
+{
+    LARGE_INTEGER due;
+
+    if (ext == NULL) {
+        return;
+    }
+    XhciLogNote(ext, "usos.poll.mode", XhciUsosPollMode);
+    if (ext->UsosPollState == 1) {
+        return;
+    }
+    KeInitializeTimer(&ext->UsosPollTimer);
+    KeInitializeDpc(&ext->UsosPollDpc, usosPollDpc, ext);
+    ext->UsosPollInDpc = 0;
+    ext->UsosLastClaims = ext->InterruptsClaimed;
+    ext->UsosStallTicks = 0;
+    ext->UsosUnanswered = 0;
+    ext->UsosLastDpcCount = ext->DpcCount;
+    InterlockedExchange(&ext->UsosPollState, 1);
+    due.QuadPart = (LONGLONG)USOS_POLL_PERIOD_MS * (LONGLONG)(-10000);
+    (VOID)KeSetTimerEx(&ext->UsosPollTimer, due, USOS_POLL_PERIOD_MS,
+                       &ext->UsosPollDpc);
+}
+
+/* Before the controller is quiesced. IRQL: PASSIVE_LEVEL. */
+VOID XhciUsosPollStop(PXHCI_EXTENSION ext)
+{
+    LARGE_INTEGER wait;
+    ULONG guard;
+
+    if (ext == NULL || ext->UsosPollState != 1) {
+        return;
+    }
+    InterlockedExchange(&ext->UsosPollState, 2);
+    (VOID)KeCancelTimer(&ext->UsosPollTimer);
+    (VOID)KeRemoveQueueDpc(&ext->UsosPollDpc);
+    wait.QuadPart = -10000;     /* 1 ms */
+    for (guard = 0; guard < 1000 && ext->UsosPollInDpc != 0; guard++) {
+        if (KeGetCurrentIrql() == PASSIVE_LEVEL) {
+            (VOID)KeDelayExecutionThread(KernelMode, FALSE, &wait);
+        } else {
+            KeStallExecutionProcessor(1000);
+        }
+    }
+    XhciLogNote(ext, "usos.poll.ticks", ext->UsosPollTicks);
+    XhciLogNote(ext, "usos.poll.softints", ext->UsosSoftInts);
+    XhciLogNote(ext, "usos.poll.direct", ext->UsosDirectDpcs);
+    XhciLogNote(ext, "usos.poll.rescues", ext->UsosRescues);
+    XhciLogNote(ext, "usos.poll.dpcs", ext->DpcCount);
+    InterlockedExchange(&ext->UsosPollState, 0);
+}
+
 #else /* XHCI_HOST_TEST */
 
 /* The host suite has no PCI, no file system and no threads. */
@@ -511,5 +696,8 @@ VOID XhciUsosFileAppendText(const char *text) { (void)text; }
 VOID XhciUsosFileHeader(PXHCI_EXTENSION ext, ULONG reason)
 { (void)ext; (void)reason; }
 VOID XhciUsosFileKick(VOID) { }
+ULONG XhciUsosPollMode;
+VOID XhciUsosPollStart(PXHCI_EXTENSION ext) { (void)ext; }
+VOID XhciUsosPollStop(PXHCI_EXTENSION ext) { (void)ext; }
 
 #endif /* XHCI_HOST_TEST */
