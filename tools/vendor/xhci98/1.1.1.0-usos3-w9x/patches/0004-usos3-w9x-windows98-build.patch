diff --git a/src/sources b/src/sources
index d2284d4..c95f7d5 100644
--- a/src/sources
+++ b/src/sources
@@ -252,3 +252,16 @@ C_DEFINES=$(C_DEFINES) -DXHCI_FLAVOUR_RELEASE
 # Matches the shipping NUSB/SP4 miniports: no separate .rdata section.
 #
 LINKER_FLAGS=-merge:.rdata=.text
+
+#
+# MODIFIED (USOS 1.1.1.0-usos3-w9x): XHCI_USOS_W9X=1 in the environment builds
+# the Windows 98 SE binary: no file sink, no registry read, KeSetTimer instead
+# of KeSetTimerEx (src/xhci_usos.c), no /GS cookie (its init imports
+# KeTickCount and KeBugCheckEx) and PE subsystem version 5.00.
+#
+!IF "$(XHCI_USOS_W9X)" == "1"
+C_DEFINES=$(C_DEFINES) -DXHCI_USOS_W9X
+BUFFER_OVERFLOW_CHECKS=0
+# Subsystem version as the upstream Windows 2000 DDK build that loads on 98.
+SUBSYSTEM_VERSION=5.00
+!ENDIF
