--- 1.3.0.0-usos6/src/ahcimain.c
+++ new/ahcimain.c
@@ -610,6 +610,13 @@ DriverEntry(IN PVOID DriverObject, IN PVOID Argument2)
        headers add HwAdapterControl, so report the NT4 size explicitly.
        HwAdapterControl stays NULL. */
     initData.HwInitializationDataSize = FIELD_OFFSET(HW_INITIALIZATION_DATA, HwAdapterControl);
+#ifdef AHCI_NT31
+    /* MODIFIED (USOS 1.3.0.0-usos7, NT 3.1 build, 0010): NT 3.1 ScsiPort
+       takes exactly 0x40 bytes: the structure up to ReceiveEvent, padded
+       (no VendorId / DeviceId fields yet; the offset of VendorIdLength is
+       0x3E, which NT 3.1 rejects). */
+    initData.HwInitializationDataSize = 0x40;
+#endif
 #else
     initData.HwInitializationDataSize = sizeof(HW_INITIALIZATION_DATA);
 #endif
@@ -684,7 +691,13 @@ AhciFindAdapter(
     found = FALSE;
     ownSlot = FALSE;
     targetBus = ConfigInfo->SystemIoBusNumber;
+#ifdef AHCI_NT31
+    /* MODIFIED (usos7, 0010): the NT 3.1 PORT_CONFIGURATION_INFORMATION
+       ends after ReceiveEvent (no SlotNumber, no MaximumNumberOfTargets). */
+    targetSlot = 0;
+#else
     targetSlot = ConfigInfo->SlotNumber;
+#endif
 
     if (AhciReadPciHeader(hwInit, targetBus, targetSlot, &pciConfig, NULL) &&
         AhciPciConfigIsAhci(&pciConfig) &&
@@ -798,12 +811,20 @@ AhciFindAdapter(
             accessRanges[0].RangeStart.HighPart = 0;
             accessRanges[0].RangeLength = 0;
         }
+#ifdef AHCI_NT31
+        /* MODIFIED (usos7, 0010): NT 3.1 has no PCIBus interface type; an
+           EISA bus master with 32-bit addresses needs no map registers. */
+        ConfigInfo->AdapterInterfaceType = Eisa;
+#else
         ConfigInfo->AdapterInterfaceType = PCIBus;
+#endif
     }
     *Again = TRUE;
 #endif
     ConfigInfo->SystemIoBusNumber = targetBus;
+#ifndef AHCI_NT31
     ConfigInfo->SlotNumber = targetSlot;
+#endif
 
 #if defined(AHCI_NT4) && !defined(AHCI_W9X)
     /* MODIFIED (USOS 1.3.0.0-usos4, NT 4.0 build, 0006): no interrupt.
@@ -834,7 +855,9 @@ AhciFindAdapter(
     ConfigInfo->ScatterGather = TRUE;
     ConfigInfo->MaximumTransferLength = AHCI_MAX_TRANSFER;
     ConfigInfo->NumberOfPhysicalBreaks = AHCI_MAX_PHYS_BREAKS;
+#ifndef AHCI_NT31
     ConfigInfo->MaximumNumberOfTargets = MAX_SUPPORTED_PORTS;
+#endif
     ConfigInfo->NumberOfBuses = 1;
     /* ScsiPort skips the initiator ID when scanning: keep it past the last port */
     ConfigInfo->InitiatorBusId[0] = (UCHAR)MAX_SUPPORTED_PORTS;
--- 1.3.0.0-usos6/src/ahcisatl.c
+++ new/ahcisatl.c
@@ -827,6 +827,17 @@ __declspec(dllimport) extern ULONG KiBugCheckData[5];
 #endif
 /* MODIFIED (USOS 1.3.0.0-usos4, NT 3.51 build, 0007): NT 3.51 ntoskrnl
    does not export KiBugCheckData; that build keeps the STOP code at 0. */
+#ifdef AHCI_NT31
+/* MODIFIED (USOS 1.3.0.0-usos7, NT 3.1 build, 0010): the NT 3.1 kernel
+   exports no memset; the compiler's calls for structure zeroing land here. */
+#pragma function(memset)
+void * __cdecl memset(void *dst, int val, unsigned int count)
+{
+    unsigned char *p = (unsigned char *)dst;
+    while (count--) *p++ = (unsigned char)val;
+    return dst;
+}
+#endif
 
 static ULONG g_UsosInstances;
 static UCHAR g_UsosComponent[] = "AHCINT-USOS";
@@ -1220,10 +1231,14 @@ AhciUsosAttach(IN PHW_DEVICE_EXTENSION HwInit)
     vga.LowPart = 0xB8000;
     vga.HighPart = 0;
     if (HwInit->UsosVga == NULL) HwInit->UsosVga = (PUSHORT)MmMapIoSpace(vga, 80 * 50 * 2, 0 /* MmNonCached */);
+#ifndef AHCI_NT31
+    /* MODIFIED (usos7, 0010): NT 3.1 exports no KeRegisterBugCheckCallback;
+       that build has no STOP-time trace callback. */
     if (HwInit->UsosBugCheckRecord.CallbackRoutine == NULL) {
         KeRegisterBugCheckCallback(&HwInit->UsosBugCheckRecord, (PVOID)AhciUsosBugCheckCallback,
                                    HwInit, sizeof(HW_DEVICE_EXTENSION), g_UsosComponent);
     }
+#endif
     AhciUsosShow(HwInit);
 }
 
