+/* A stage seen for the first time: status line and trace. */
+VOID
+AhciUsosStage(IN PHW_DEVICE_EXTENSION HwInit, IN ULONG Stage, IN PCHAR Why)
+{
+    if (HwInit->UsosStage & Stage) return;
+    HwInit->UsosStage |= Stage;
