<?xml version="1.0" encoding="utf-8"?>
<!-- USOS POSReady 2009 answer template (docs/posready-2009-2026-10-10.md). The @...@ fields are filled by tools/posready_qemu_install.sh posready_answer_xml from the menu answer (POSR.SIF); never commit a key. Validated by POSReady Setup in QEMU 2026-10-10 up to the key check. -->
<Unattend>
<LoggingData>
<LogFile Path="%TARGETDRIVE%\Windows\Setup.log" />
<UnattendedFile Path="%TARGETDRIVE%\Windows\Unattended.xml" Copy="No" />
</LoggingData>
<UserData>
<ProductKey Value="@PRODUCT_KEY@" />
<FullName Value="@FULL_NAME@" />
<Organization Value="@ORGANIZATION@" />
<ComputerName Value="@COMPUTER_NAME@" />
<AdminPassword Value="@ADMIN_PASSWORD@" StrongPassword="No" EncryptedPassword="No" />
</UserData>
<DiskConfig>
<Disk ID="0" WipeDisk="No">
<ModifyPartition ID="2" Label="POSReady" Letter="C" FileSystem="NTFS" AllocationUnit="4096" QuickFormat="Yes" FileCompression="No" />
</Disk>
</DiskConfig>
<SystemData>
<OSConfiguration>
<PageFile Path="*" InitialSize="*" MaximumSize="*" />
</OSConfiguration>
<LanguageSettings>
<DefaultInputLanguage Value="1033" />
<NonUnicodeLanguage Value="1033" />
<UseComplexScriptLanguages Value="No" />
<UseEastAsianLanguages Value="No" />
</LanguageSettings>
<RegionalSettings>
<StandardsAndFormats Value="1033" />
<GeographicalLocation Value="244" />
<TimeZone Value="85" />
</RegionalSettings>
<Components>
<Component Name=".Net Framework 2.0" Install="Yes" />
<Component Name="Calculator" Install="Yes" />
<Component Name="Notepad" Install="Yes" />
<Component Name="Paint" Install="Yes" />
<Component Name="WordPad" Install="Yes" />
<Component Name="Command Line Utilities" Install="Yes" />
<Component Name="Disk Management" Install="Yes" />
</Components>
<Networking>
<IPAddress DynamicIPAddress="Yes" />
<DNSServer DNSAuto="Yes" />
<WINSServer WINSAuto="Yes" />
</Networking>
<Security>
<JoinWorkgroup Value="WORKGROUP" />
</Security>
</SystemData>
<!-- USOS: the first logon runs \USOS\POSR\FIRST.CMD from the FAT16 Setup partition (X470 drivers, then shutdown). -->
<RunOnce>
<RunOnceCommand FilePath="cmd.exe /c for %d in (C D E F G H I J K) do if exist %d:\USOS\POSR\FIRST.CMD call %d:\USOS\POSR\FIRST.CMD" Attributes="" Flags="0" ErrorControl="0" Reboot="False" Timeout="0">
<DisplayName Value="USOS X470 drivers" />
<Description Value="USOS: community ACPI, GenAHCI, USB3 for the X470" />
</RunOnceCommand>
</RunOnce>
<SetupData>
<Preinstall AcceptEula="Yes" />
</SetupData>
</Unattend>
