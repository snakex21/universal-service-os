TARGETTYPE=MINIPORT
C_DEFINES=$(C_DEFINES) -DNDIS_MINIPORT_DRIVER=1 -DNDIS50_MINIPORT=1 -DUSOSNET_NDIS4=1 -DUSOSNET_NATIVE4=1
TARGETLIBS=$(DDK_LIB_PATH)\ndis.lib $(DDK_LIB_PATH)\ntoskrnl.lib $(DDK_LIB_PATH)\hal.lib
MSC_WARNING_LEVEL=/W3
_NT_TARGET_VERSION=$(_NT_TARGET_VERSION_WINXP)
