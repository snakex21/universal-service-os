[Data]
msdosinitiated="1"
floppyless="1"
UseSignatures="yes"
InstallDir="\WINDOWS"
EulaComplete="1"
winntupgrade="no"
win9xupgrade="no"
OriSrc="C:\"
OriTyp="5"
[Unattended]
DriverSigningPolicy=Ignore
NonDriverSigningPolicy=Ignore
UnattendMode=FullUnattended
OemSkipEula=Yes
OemPreinstall=No
Repartition=No
FileSystem=LeaveAlone
TargetPath=\WINDOWS
WaitForReboot=No
UnattendSwitch=Yes
[GuiUnattended]
OEMSkipRegional=1
OemSkipWelcome=1
TimeZone=95
AdminPassword=*
EncryptedAdminPassword=No
[UserData]
FullName="Tester"
OrgName="USOS"
ComputerName=USOS-XP-TEST
ProductKey=AAAAA-BBBBB-CCCCC-DDDDD-EEEEE
[Identification]
JoinWorkgroup=WORKGROUP
[Networking]
InstallDefaultComponents=Yes
[SetupParams]
UserExecute="C:\USOS\XP\pae.exe"
[GuiRunOnce]
Command0="%SystemDrive%\USOS\XP\pae.exe /firstlogon"
