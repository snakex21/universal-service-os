# wlink directives for USOSPG.DRV (tools/build_win9x_support.py adds
# "file usospg.obj name USOSPG.DRV"). No OpenWatcom runtime: own entry
# point, only import records from windows.lib.
format windows dll initglobal
option modname=USOSPG
option description 'USOS Windows 98 Setup page helper (GPL-3.0-or-later)'
option start=__DLLstart_
option nodefaultlibs
option stack=0
option quiet
libpath '%WATCOM%/lib286/win'
library windows
segment type code fixed
segment type data fixed
