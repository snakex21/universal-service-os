# wlink directives for USOSDBG.EXE (tools/build_win9x_support.py adds
# "file usosdbg.obj name USOSDBG.EXE"). No OpenWatcom runtime: own entry
# point, only import records from windows.lib.
format windows
option modname=USOSDBG
option description 'USOS USB keyboard bridge diagnostics (GPL-3.0-or-later)'
option start=__usos_start
option nodefaultlibs
option stack=8192
option heapsize=1024
# KERNEL InitTask writes the stack bounds into the first 16 bytes of DGROUP:
# the reserved _NULL (class BEGDATA) area goes first.
order clname CODE clname BEGDATA clname DATA clname BSS
option quiet
libpath '%WATCOM%/lib286/win'
library windows
