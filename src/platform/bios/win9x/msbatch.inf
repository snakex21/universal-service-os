; MSBATCH.INF - USOS default answer for the Windows 95/98/Me DOS Setup.
; Copyright (C) 2026 Maksymilian and the USOS Authors. GPL-3.0-or-later.
; Used when no answer file was chosen (docs/win9x-modern-2026-09-30.md).
; No product key: Setup asks for it on its own page. Everything else is
; answered: typical install, no startup disk, no licence page, no network
; wizard, restarts without a prompt, no Welcome screen. DevicePath=1: Setup
; also reads the INFs next to it (the USOS VESA display driver).
[Version]
Signature="$CHICAGO$"

[Setup]
Express=1
InstallDir="C:\WINDOWS"
InstallType=1
EBD=0
ShowEula=0
ChangeDir=0
OptionalComponents=1
Network=1
System=0
CCP=0
CleanBoot=0
Display=0
DevicePath=1
NoDirWarn=1
NoPrompt2Boot=1
Uninstall=0
VRC=1

[NameAndOrg]
Name="USOS"
Org="USOS"
Display=0

[Network]
ComputerName="USOS-9X"
Workgroup="WORKGROUP"
Description="USOS"
Display=0
PrimaryLogon=Windows
Clients=VREDIR
Protocols=MSTCP
Services=

[VREDIR]
ValidatedLogon=0

[MSTCP]
DHCP=1
DNS=0

[OptionalComponents]
"Dial-Up Networking"=0
"Dial-Up Server"=0
"Direct Cable Connection"=0
;USOS-NETWORK=on
;USOS-IP=dhcp
;USOS-GATEWAY=
;USOS-DNS=
;USOS-HOME=about:blank
;USOS-DIALUP=off

[Install]
; USOS.CsmReg exists only under CSMWrap (98, 98 SE: INSTALL.BAT appends it);
; a missing AddReg section is skipped (machine.inf does the same).
AddReg=USOS.RunOnce,USOS.CsmReg,USOS.Lan
UpdateInis=USOS.Memory
UpdateIniFields=USOS.Csm

[USOS.Lan]
HKCU,"Software\Microsoft\Windows\CurrentVersion\Internet Settings",EnableAutodial,0x00010001,0
HKCU,"Software\Microsoft\Windows\CurrentVersion\Internet Settings",ProxyEnable,0x00010001,0
HKCU,"Software\Microsoft\Windows\CurrentVersion\Internet Settings",GlobalUserOffline,0x00010001,0
HKCU,"Software\Microsoft\Windows\CurrentVersion\Internet Settings",NoNetAutodial,0x00010001,1
HKLM,"Software\Microsoft\Windows\CurrentVersion\Internet Settings",EnableAutodial,0x00010001,0
HKCU,"Software\Microsoft\Internet Connection Wizard",Completed,1,01,00,00,00
HKCU,"Software\Microsoft\Internet Explorer\Main","Start Page",,"about:blank"
HKLM,"System\CurrentControlSet\Services\VxD\MSTCP",EnableDNS,,"1"
HKLM,"Software\Microsoft\Windows\CurrentVersion\Run",USOSLan,,"C:\USOS9X\USOSLAN.EXE"

; The memory limits at Setup time, for every 9x (Me ignores the AUTOEXEC.BAT
; that runs U9FIX on 95/98; U9FIX keeps them there after later changes).
[USOS.Memory]
system.ini,386Enh,,"MaxPhysPage=40000"
system.ini,vcache,,"MaxFileCache=262144"

[USOS.RunOnce]
HKLM,"Software\Microsoft\Windows\CurrentVersion\RunOnce",USOSWelcome,,"%25%\rundll.exe setupx.dll,InstallHinfSection USOS.NoWelcome 4 %10%\msbatch.inf"

[USOS.NoWelcome]
DelReg=USOS.Welcome.Del
AddReg=USOS.Regwiz

[USOS.Welcome.Del]
HKLM,"Software\Microsoft\Windows\CurrentVersion\Run",Welcome

[USOS.Regwiz]
HKLM,"Software\Microsoft\Windows\CurrentVersion\Welcome\Regwiz",,1,01,00,00,00
HKLM,"Software\Microsoft\Windows\CurrentVersion",RegDone,1,01,00,00,00

; Last section: under CSMWrap INSTALL.BAT appends the Windows Me USB keyboard
; driver lines here (95/98 get them from U9FIX /CSM at every start).
[USOS.Csm]
