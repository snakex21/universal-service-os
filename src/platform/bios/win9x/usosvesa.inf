; USOSVESA.INF - generic VESA BIOS (VBE 2.0/3.0) display driver for Windows 95/98/Me
; MODIFIED by the USOS Authors on 2026-09-30 from vmdisp9x.inf of vmdisp9x 1.2025.0.119
; (https://github.com/JHRobotics/vmdisp9x, MIT licence, VMDISP9X.TXT): only the VESA
; model is kept (any PCI display class device), the virtual-machine adapters,
; OpenGL and 3D entries are removed; NoMemTest="1" is added (2026-10-06, real
; hardware). Files are unmodified upstream binaries.
; Copyright 2012-2022, The OS/2 Museum; 2023-2025, Jaroslav Hensl.

[version]
DriverVer=08/03/2025,4.2025.0.119
Class=DISPLAY
signature="$CHICAGO$"
Provider=%Mfg%

[DestinationDirs]
DefaultDestDir=11
VESA.Copy=11

[SourceDisksNames]
1="USOS VESA driver",,0

[SourceDisksFiles]
vesamini.drv=1
vesamini.vxd=1
vmhal9x.dll=1
vmhal486.dll=1
vmdisp9x.dll=1

[Manufacturer]
%Mfg%=Mfg.VM

[Mfg.VM]
%VESAPCI.DeviceDesc%=VESA, PCI\CC_0300
%VESAISA.DeviceDesc%=VESA, *PNP0900

[VESA]
CopyFiles=VESA.Copy
DelReg=VM.DelReg
AddReg=VESA.AddReg,VM.AddReg

[VESA.Copy]
vesamini.drv,,,0x00000004
vesamini.vxd,,,0x00000004
vmhal9x.dll,,,0x00000004
vmdisp9x.dll,,,0x00000004
vmhal486.dll,,,0x00000004

[VESA.AddReg]
HKR,DEFAULT,drv,,vesamini.drv
HKR,DEFAULT,minivdd,,vesamini.vxd
HKR,DEFAULT,Mode,,"16,640,480"

[VM.DelReg]
HKR,,Ver
HKR,,DevLoader
HKR,DEFAULT
HKR,MODES
HKR,CURRENT
HKLM,Software\Microsoft\Windows\CurrentVersion\OpenGLdrivers,SOFTWARE
HKLM,Software\Microsoft\Windows\CurrentVersion\OpenGLdrivers,VMWSVGA
HKLM,Software\Microsoft\Windows\CurrentVersion\OpenGLdrivers,QEMUFX
HKLM,Software\Microsoft\Windows\CurrentVersion\Run,Tray3D
HKLM,Software\vmdisp9x\svga
HKLM,Software\vmdisp9x\vesa

[VM.AddReg]
HKR,,Ver,,4.0
HKR,,DevLoader,,*vdd
HKR,DEFAULT,vdd,,"*vdd"
HKR,DEFAULT,RefreshRate,,-1
HKR,DEFAULT,DDC,,1
HKR,"MODES\4\640,480",drv,,vga.drv
HKR,"MODES\4\640,480",vdd,,*vdd
HKR,"MODES\4\800,600",drv,,supervga.drv
HKR,"MODES\4\800,600",vdd,,*vdd
HKR,"MODES\8\640,480"
HKR,"MODES\8\800,600"
