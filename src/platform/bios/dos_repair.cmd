@ECHO OFF
PATH=A:\
CLS
ECHO USOS - naprawa RAM Windows 98 SE
IF NOT EXIST C:\WINDOWS\WIN.COM GOTO MISSING
IF NOT EXIST C:\WINDOWS\SYSTEM\KERNEL32.DLL GOTO MISSING
IF NOT EXIST C:\WINDOWS\SYSTEM\VMM32.VXD GOTO MISSING
IF NOT EXIST C:\USOS98\NUL MD C:\USOS98
SET USOSBAK=
FOR %%N IN (9 8 7 6 5 4 3 2 1 0) DO IF NOT EXIST C:\USOS98\RAMBK%%N\NUL SET USOSBAK=C:\USOS98\RAMBK%%N
IF "%USOSBAK%"=="" GOTO FAILED
MD %USOSBAK%
IF ERRORLEVEL 1 GOTO FAILED
COPY /B C:\WINDOWS\SYSTEM\VMM32.VXD %USOSBAK%\VMM32.VXD >NUL
IF ERRORLEVEL 1 GOTO FAILED
IF NOT EXIST C:\WINDOWS\SYSTEM\VMM32\VMM.VXD GOTO CACHE
COPY /B C:\WINDOWS\SYSTEM\VMM32\VMM.VXD %USOSBAK%\VMM.VXD >NUL
IF ERRORLEVEL 1 GOTO FAILED
:CACHE
IF NOT EXIST C:\WINDOWS\SYSTEM\VMM32\VCACHE.VXD GOTO PATCH
COPY /B C:\WINDOWS\SYSTEM\VMM32\VCACHE.VXD %USOSBAK%\VCACHE.VXD >NUL
IF ERRORLEVEL 1 GOTO FAILED
:PATCH
ECHO Kopia plikow: %USOSBAK%
ECHO Trwa modyfikacja i kompresja plikow systemu. To moze potrwac kilka minut.
ECHO Nie wylaczaj komputera. Po zakonczeniu pojawi sie wynik naprawy.
A:\CWSDPMI.EXE -s-
A:\PATCH9X.EXE -auto -select mem C:\WINDOWS\SYSTEM >%USOSBAK%\PATCH.LOG
IF ERRORLEVEL 1 GOTO FAILED
TYPE %USOSBAK%\PATCH.LOG
ECHO.
ECHO Poprawka RAM zastosowana. Wyjmij pendrive USOS.
ECHO Uruchom komputer z dysku z Windows 98, aby kontynuowac.
GOTO STOP
:MISSING
ECHO Brak rozpoznanej instalacji w C:\WINDOWS. Niczego nie zmieniono.
GOTO STOP
:FAILED
ECHO Naprawa nie zostala potwierdzona. Zachowaj kopie plikow i log.
IF EXIST %USOSBAK%\PATCH.LOG TYPE %USOSBAK%\PATCH.LOG
:STOP
PAUSE >NUL
GOTO STOP
