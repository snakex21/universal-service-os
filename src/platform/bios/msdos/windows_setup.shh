; USOS: Windows 3.1 / 3.11 batch Setup (SETUP /H:USOS.SHH), used when MS-DOS
; was prepared under CSMWrap (UEFI PC without CSM). There the keyboard is USB
; and Setup's own KEYBOARD.DRV cannot read it, so Setup must need no keys.
; Devices, language and keyboard layout: Setup's detection and the defaults
; of the SETUP.INF on the user's disk (so the Polish edition stays Polish).
; No tutorial, no printer, no application search. Format: SETUP.SHH of the
; Windows 3.1 disks. docs/design/bios-via-csmwrap.md section 8.5.

[sysinfo]
showsysinfo=no

[windir]
c:\windows

[userinfo]
"USOS"

[endinstall]
configfiles = modify
endopt      = exit
