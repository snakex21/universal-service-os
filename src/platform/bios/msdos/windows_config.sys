[menu]
menucolor=15,1
menuitem=WINSTD,Windows - standard mode (default)
menuitem=WIN386,Windows - 386 enhanced mode (alternative)
menuitem=DOSONLY,MS-DOS - command prompt
menuitem=WINSET,PS/2 mouse settings - Windows Setup
menudefault=WINSTD,8

[common]
DEVICE=C:\DOS\HIMEM.SYS /TESTMEM:OFF
DOS=HIGH
FILES=40
BUFFERS=20
LASTDRIVE=Z
SHELL=C:\COMMAND.COM C:\ /E:2048 /P
STACKS=9,256

[WINSTD]

[WIN386]
DEVICE=C:\WINDOWS\SMARTDRV.EXE /DOUBLE_BUFFER

[DOSONLY]

[WINSET]
