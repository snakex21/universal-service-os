[menu]
menucolor=15,1
menuitem=WINSTD,Windows (default)
menuitem=WINREAL,Windows 3.0 - standard mode (WIN /S, test)
menuitem=DOSONLY,MS-DOS - command prompt
submenu=DIAG,Diagnostics (D1-D6, for tests only)
menudefault=WINSTD,8

; Diagnostic start variants only (Windows 2.03 logo hang on the X470, fixed
; by USOSV10 in every default item; D6 PASS 2026-10-09):
; each isolates one suspect; W1AUTO.BAT logs to C:\USOS\DIAG\<variant>.TXT.
; D3 (EGA instead of VGA) needs a second Windows 2.x Setup: the display
; driver is bound into WIN200.BIN. Not offered.
[DIAG]
menuitem=D1WHERE,D1 - as default + USOSWHER (CS:IP in the corner)
menuitem=D2NOKBC,D2 - no USOSKBC (PS/2 keyboard only)
menuitem=D4CLEAN,D4 - no HIMEM and VBMOUSE (SETVER + USOSKBC only)
menuitem=D5MIN,D5 - minimum: SETVER + USOSWHER only (no USOSV10)
menuitem=D6V10,D6 - as D5 + USOSV10 (INT 10h on its own stack)
menuitem=DOSONLY,MS-DOS - command prompt

; HIMEM per item (D4/D5/D6 without it), before SETVER as before.
[WINSTD]
DEVICE=C:\DOS\HIMEM.SYS /TESTMEM:OFF

[WINREAL]
DEVICE=C:\DOS\HIMEM.SYS /TESTMEM:OFF

[DOSONLY]
DEVICE=C:\DOS\HIMEM.SYS /TESTMEM:OFF

[D1WHERE]
DEVICE=C:\DOS\HIMEM.SYS /TESTMEM:OFF

[D2NOKBC]
DEVICE=C:\DOS\HIMEM.SYS /TESTMEM:OFF

[D4CLEAN]

[D5MIN]

[D6V10]

; Windows 1.0x-3.0: no DOS=HIGH (Windows 2.x needs the HMA), SETVER
; (the 1.0x and 2.x kernels: "Incorrect DOS version" on MS-DOS 6.22; WIN200.BIN
; is in its table, INSTALL.BAT adds WIN100.BIN).
[common]
DEVICE=C:\DOS\SETVER.EXE
FILES=40
BUFFERS=20
LASTDRIVE=Z
SHELL=C:\COMMAND.COM C:\ /E:2048 /P
STACKS=9,256
