# Local caches and reference source trees
tools/cache/
tools/reference/

# Generated test artifacts
tools/tests/artifacts/

# Zig build output and cache
.zig-cache/
zig-out/
build/generated/

# Generated installer executable and local runtime logs
installer/USOS Installer.exe
installer/*.log
installer/*.pid

# Local SuperCLI attachment cache
.supercli/attachments/

# Local disk images / installation media
*.qcow2
*.raw
*.iso
*.ISO

# Tiny tracked media fixtures used only by automated tests
!tools/tests/fixtures/**/*.iso
!tools/tests/fixtures/**/*.ISO

# Local build scratch, disk/hive backups and physical-test snapshots
/build/
/artifacts/
/test-images/
# User driver/update drop folder and Microsoft update packages (blobs)
/driwer/
*.msu
# Partial downloads, stray objects and local OS media archives in the root
*.part
*.o
/*.zip
/%SystemDrive%/
# Root-level physical test logs
/*.log
# Generated helper executables next to the installer sources
installer/*.exe
# Python bytecode
__pycache__/
# Local SuperCLI state (attachments already ignored above)
.supercli/
# Third-party XP integrator tree (large archives, very long paths) and
# vendored source/asset archives; only small pinned inputs are tracked
tools/vendor/xp-modern/*/integrator/
tools/vendor/**/*.zip
tools/vendor/**/*.7z
# xhci98 source tarball (9 MB, pinned by commit and SHA-256 in SOURCES.txt)
tools/vendor/xhci98/*-src/*.tar.gz
# Zig compiler cache inside the bundled toolchain
tools/zig/data/
# Secure Boot signing keys never enter the repository (key custody:
# docs/secure-boot-usos.md). Only the public .cer is tracked.
*.key
*.pfx
*.p12
usos-secure-boot.key
/signing/
# Local Claude Code state (agent worktrees, settings)
.claude/
# Not in git since the public repository (2026-09-29): toolchains, installer
# outputs and the embedded payload (a build output of build.bat). See
# docs/BUILDING.md for where to get Zig 0.16.0 and QEMU 11.1.
tools/zig/
tools/qemu/
installer/build/
installer/internal/payload/assets/*.zip
/$tmp/

# Maintainer-only local notes (machine paths, sticks); never published
/docs/local/
# WDK 7.1 (7600.16385.1), unpacked from the user-downloaded GRMWDK_EN_7600_1.ISO
# with msiexec /a; see docs/BUILDING.md (never redistributed)
tools/WinDDK71/
